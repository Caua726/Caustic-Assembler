use "../../std/io.cst" as io;
use "../core/buf.cst" as buf;
use "elf.cst" as elf;
use "../parser/custom_sections.cst" as cs;
use "../../src/codegen/target.cst" as tgt;

// =======================================================
// caustic-assembler/coff.cst — PE/COFF object writer
//
// The .obj counterpart of write_elf, so `caustic-as file.s` on a Windows
// target produces something caustic-ld (and link.exe) can consume. The
// in-process compiler pipeline never reaches here — it hands codegen's
// assembly to assemble_buf and links straight from memory — so this serves
// the standalone assembler and interop with external toolchains.
//
// Layout:
//   File header   (20 bytes)
//   Section table (40 bytes per section)
//   Raw section data, each followed by that section's relocations (10 bytes)
//   Symbol table  (18 bytes per entry, no aux records)
//   String table  (4-byte size including itself, then NUL-terminated names)
//
// Mirrors caustic-linker/readers/coff_reader.cst, the reader for this shape.
// =======================================================

let is i32 as IMAGE_FILE_MACHINE_AMD64 with imut = 34404;   // 0x8664
let is i32 as IMAGE_FILE_MACHINE_ARM64 with imut = 43620;   // 0xAA64

// Section characteristics.
let is i64 as SCN_CNT_CODE       with imut = 32;            // 0x00000020
let is i64 as SCN_CNT_INITDATA   with imut = 64;            // 0x00000040
let is i64 as SCN_CNT_UNINITDATA with imut = 128;           // 0x00000080
let is i64 as SCN_ALIGN_16       with imut = 5242880;       // 0x00500000
let is i64 as SCN_MEM_EXECUTE    with imut = 536870912;     // 0x20000000
let is i64 as SCN_MEM_READ       with imut = 1073741824;    // 0x40000000
let is i64 as SCN_MEM_WRITE      with imut = 2147483648;    // 0x80000000

// COFF relocation codes.
let is i64 as REL_AMD64_ADDR64 with imut = 1;
let is i64 as REL_AMD64_ADDR32 with imut = 2;
let is i64 as REL_AMD64_REL32  with imut = 4;
let is i64 as REL_ARM64_BRANCH26     with imut = 3;
let is i64 as REL_ARM64_PAGEBASE_21  with imut = 4;
let is i64 as REL_ARM64_PAGEOFF_12A  with imut = 6;
let is i64 as REL_ARM64_ADDR64       with imut = 14;
let is i64 as REL_ARM64_BRANCH19     with imut = 15;

fn coff_machine() as i32 {
    if (tgt.target_get().arch == tgt.ARCH_AARCH64) { return IMAGE_FILE_MACHINE_ARM64; }
    return IMAGE_FILE_MACHINE_AMD64;
}

// Inverse of coff_reader.cst's coff_reloc_to_elf. PC-relative COFF
// relocations carry an implicit -4 addend, so an ELF addend of -4 maps to
// plain REL32 and -(4+N) to REL32_N (codes 5..9).
fn reloc_to_coff(rtype as i64, addend as i64) as i64 {
    if (tgt.target_get().arch == tgt.ARCH_AARCH64) {
        if (rtype == 282 || rtype == 283) { return REL_ARM64_BRANCH26; }   // JUMP26 / CALL26
        if (rtype == 275) { return REL_ARM64_PAGEBASE_21; }                // ADR_PREL_PG_HI21
        if (rtype == 277) { return REL_ARM64_PAGEOFF_12A; }                // ADD_ABS_LO12_NC
        if (rtype == 280) { return REL_ARM64_BRANCH19; }                   // CONDBR19
        return REL_ARM64_ADDR64;                                           // ABS64 (257) et al
    }
    if (rtype == elf.R_X86_64_64) { return REL_AMD64_ADDR64; }
    if (rtype == elf.R_X86_64_PC32 || rtype == elf.R_X86_64_PLT32) {
        let is i64 as n = (0 - addend) - 4;
        if (n >= 0 && n <= 5) { return REL_AMD64_REL32 + n; }
        return REL_AMD64_REL32;
    }
    return REL_AMD64_ADDR32;
}

// COFF section numbers are 1-based in declaration order; the assembler's ids
// are 0=text 1=data 2=rodata 3=bss, custom from 4. 0 means undefined.
fn coff_secnum(section as i32) as i32 {
    // SECTION_UNDEF is 99, which is >= SECTION_CUSTOM_BASE, so it has to be
    // tested first or an undefined symbol comes out claiming section 100.
    if (section == cs.SECTION_UNDEF) { return 0; }
    if (section == cs.SECTION_TEXT) { return 1; }
    if (section == cs.SECTION_DATA) { return 2; }
    if (section == cs.SECTION_RODATA) { return 3; }
    if (section == cs.SECTION_BSS) { return 4; }
    if (section >= cs.SECTION_CUSTOM_BASE) { return 5 + (section - cs.SECTION_CUSTOM_BASE); }
    return 0;
}

// 8-byte name field: inline when it fits, otherwise "/<decimal offset>" into
// the string table.
fn emit_name8(out as *buf.ByteBuffer, name as *u8, len as i32, strtab_off as i64) as void {
    if (len <= 8) {
        let is i32 as i with mut = 0;
        while (i < len) { buf.buf_emit8(out, cast(i64, name[i])); i = i + 1; }
        while (i < 8) { buf.buf_emit8(out, 0); i = i + 1; }
        return;
    }
    let is [8]u8 as tmp;
    let is i32 as n with mut = 0;
    let is i64 as v with mut = strtab_off;
    if (v == 0) { tmp[0] = cast(u8, 48); n = 1; }
    while (v > 0 && n < 7) { tmp[n] = cast(u8, 48 + cast(i32, v % 10)); v = v / 10; n = n + 1; }
    buf.buf_emit8(out, 47);   // '/'
    let is i32 as k with mut = n;
    while (k > 0) { k = k - 1; buf.buf_emit8(out, cast(i64, tmp[k])); }
    let is i32 as pad with mut = 7 - n;
    while (pad > 0) { buf.buf_emit8(out, 0); pad = pad - 1; }
}

fn write_coff(fd as i64, text_buf as *buf.ByteBuffer, data_buf as *buf.ByteBuffer,
              rodata_buf as *buf.ByteBuffer, bss_size as i64,
              symtab as *elf.SymbolTable, relocs as *elf.RelocList,
              data_relocs as *elf.RelocList,
              csec_buf_ptrs as *u8, csec_name_ptrs as *u8,
              csec_name_lens as *u8, csec_reloc_ptrs as *u8,
              csec_count as i32) as void {
    let is i32 as nsec = 4 + csec_count;
    let is *i64 as cbp = cast(*i64, csec_buf_ptrs);
    let is *i64 as cnp = cast(*i64, csec_name_ptrs);
    let is *i32 as cnl = cast(*i32, csec_name_lens);
    let is *i64 as crp = cast(*i64, csec_reloc_ptrs);

    // String table first — the section headers reference its offsets. Offsets
    // are relative to the table start and begin at 4, past its own size field.
    let is buf.ByteBuffer as strtab = buf.buf_init(1024);
    buf.buf_emit32_le(&strtab, 0);          // size, patched below
    let is [32]i64 as csec_name_offs;
    let is i32 as i with mut = 0;
    while (i < csec_count) {
        csec_name_offs[i] = 0;
        if (cnl[i] > 8) {
            csec_name_offs[i] = strtab.len;
            buf.buf_append(&strtab, cast(*u8, cnp[i]), cast(i64, cnl[i]));
            buf.buf_emit8(&strtab, 0);
        }
        i = i + 1;
    }

    let is [36]i64 as sec_size;
    let is [36]i64 as sec_data;     // byte pointer, 0 for bss
    let is [36]i64 as sec_relocs;   // *RelocList, 0 when none
    sec_size[0] = text_buf.len;   sec_data[0] = cast(i64, text_buf.data);   sec_relocs[0] = cast(i64, relocs);
    sec_size[1] = data_buf.len;   sec_data[1] = cast(i64, data_buf.data);   sec_relocs[1] = cast(i64, data_relocs);
    sec_size[2] = rodata_buf.len; sec_data[2] = cast(i64, rodata_buf.data); sec_relocs[2] = 0;
    sec_size[3] = bss_size;       sec_data[3] = 0;                          sec_relocs[3] = 0;
    i = 0;
    while (i < csec_count) {
        let is *buf.ByteBuffer as cb = cast(*buf.ByteBuffer, cbp[i]);
        sec_size[4 + i] = cb.len;
        sec_data[4 + i] = cast(i64, cb.data);
        sec_relocs[4 + i] = crp[i];
        i = i + 1;
    }

    let is [36]i64 as sec_raw_ptr;
    let is [36]i64 as sec_rel_ptr;
    let is [36]i64 as sec_rel_n;
    let is i64 as cursor with mut = 20 + cast(i64, nsec) * 40;
    i = 0;
    while (i < nsec) {
        sec_raw_ptr[i] = 0;
        sec_rel_ptr[i] = 0;
        sec_rel_n[i] = 0;
        // bss has no raw data; its PointerToRawData must stay 0.
        if (sec_data[i] != 0 && sec_size[i] > 0) {
            sec_raw_ptr[i] = cursor;
            cursor = cursor + sec_size[i];
        }
        if (sec_relocs[i] != 0) {
            let is *elf.RelocList as rl = cast(*elf.RelocList, sec_relocs[i]);
            if (rl.count > 0) {
                sec_rel_n[i] = cast(i64, rl.count);
                sec_rel_ptr[i] = cursor;
                cursor = cursor + cast(i64, rl.count) * 10;
            }
        }
        i = i + 1;
    }
    let is i64 as symtab_ptr = cursor;

    // Symbol names longer than 8 bytes also live in the string table.
    let is i32 as si with mut = 0;
    while (si < symtab.count) {
        let is *elf.Symbol as sy = elf.sym_get(symtab, si);
        if (sy.name_len > 8) {
            sy.strtab_off = cast(i32, strtab.len);
            buf.buf_append(&strtab, sy.name_ptr, cast(i64, sy.name_len));
            buf.buf_emit8(&strtab, 0);
        } else {
            sy.strtab_off = 0;
        }
        si = si + 1;
    }
    let is *u8 as sd = strtab.data;
    sd[0] = cast(u8, strtab.len & 255);
    sd[1] = cast(u8, (strtab.len >> 8) & 255);
    sd[2] = cast(u8, (strtab.len >> 16) & 255);
    sd[3] = cast(u8, (strtab.len >> 24) & 255);

    let is buf.ByteBuffer as out = buf.buf_init(65536);

    // File header (20 bytes).
    buf.buf_emit16_le(&out, cast(i64, coff_machine()));
    buf.buf_emit16_le(&out, cast(i64, nsec));
    buf.buf_emit32_le(&out, 0);                       // TimeDateStamp
    buf.buf_emit32_le(&out, symtab_ptr);
    buf.buf_emit32_le(&out, cast(i64, symtab.count));
    buf.buf_emit16_le(&out, 0);                       // SizeOfOptionalHeader
    buf.buf_emit16_le(&out, 0);                       // Characteristics

    // Section table.
    i = 0;
    while (i < nsec) {
        if (i == 0) { emit_name8(&out, ".text", 5, 0); }
        else if (i == 1) { emit_name8(&out, ".data", 5, 0); }
        else if (i == 2) { emit_name8(&out, ".rdata", 6, 0); }
        else if (i == 3) { emit_name8(&out, ".bss", 4, 0); }
        else {
            let is i32 as ci = i - 4;
            emit_name8(&out, cast(*u8, cnp[ci]), cnl[ci], csec_name_offs[ci]);
        }
        buf.buf_emit32_le(&out, 0);                   // VirtualSize (0 in an obj)
        buf.buf_emit32_le(&out, 0);                   // VirtualAddress
        buf.buf_emit32_le(&out, sec_size[i]);
        buf.buf_emit32_le(&out, sec_raw_ptr[i]);
        buf.buf_emit32_le(&out, sec_rel_ptr[i]);
        buf.buf_emit32_le(&out, 0);                   // PointerToLinenumbers
        buf.buf_emit16_le(&out, sec_rel_n[i]);
        buf.buf_emit16_le(&out, 0);                   // NumberOfLinenumbers
        let is i64 as chars with mut = 0;
        if (i == 0) { chars = SCN_CNT_CODE + SCN_MEM_EXECUTE + SCN_MEM_READ + SCN_ALIGN_16; }
        else if (i == 1) { chars = SCN_CNT_INITDATA + SCN_MEM_READ + SCN_MEM_WRITE + SCN_ALIGN_16; }
        else if (i == 2) { chars = SCN_CNT_INITDATA + SCN_MEM_READ + SCN_ALIGN_16; }
        else if (i == 3) { chars = SCN_CNT_UNINITDATA + SCN_MEM_READ + SCN_MEM_WRITE + SCN_ALIGN_16; }
        else {
            // A custom section holding code (a function carrying `with
            // section(...)`) is executable, mirroring the ELF path's
            // SHF_EXECINSTR.
            if (elf.csec_exec_flags(i - 4) == 1) {
                chars = SCN_CNT_CODE + SCN_MEM_EXECUTE + SCN_MEM_READ + SCN_ALIGN_16;
            } else {
                chars = SCN_CNT_INITDATA + SCN_MEM_READ + SCN_MEM_WRITE + SCN_ALIGN_16;
            }
        }
        buf.buf_emit32_le(&out, chars);
        i = i + 1;
    }

    // Raw data, each section followed by its relocations.
    i = 0;
    while (i < nsec) {
        if (sec_raw_ptr[i] != 0) {
            buf.buf_append(&out, cast(*u8, sec_data[i]), sec_size[i]);
        }
        if (sec_rel_ptr[i] != 0) {
            let is *elf.RelocList as rl = cast(*elf.RelocList, sec_relocs[i]);
            let is i32 as ri with mut = 0;
            while (ri < rl.count) {
                let is *elf.Reloc as r = elf.reloc_get(rl, ri);
                buf.buf_emit32_le(&out, r.offset);          // VirtualAddress
                buf.buf_emit32_le(&out, r.sym_idx);         // SymbolTableIndex
                buf.buf_emit16_le(&out, reloc_to_coff(r.rtype, r.addend));
                ri = ri + 1;
            }
        }
        i = i + 1;
    }

    // Symbol table (18 bytes each, no aux records).
    si = 0;
    while (si < symtab.count) {
        let is *elf.Symbol as sy = elf.sym_get(symtab, si);
        if (sy.name_len > 8) {
            buf.buf_emit32_le(&out, 0);                     // zeroes → long name
            buf.buf_emit32_le(&out, cast(i64, sy.strtab_off));
        } else {
            emit_name8(&out, sy.name_ptr, sy.name_len, 0);
        }
        buf.buf_emit32_le(&out, sy.offset);                 // Value
        buf.buf_emit16_le(&out, cast(i64, coff_secnum(sy.section)));
        // Type 0x20 marks a function, which link.exe expects on .text globals.
        if (sy.section == cs.SECTION_TEXT && sy.is_global == 1) { buf.buf_emit16_le(&out, 32); }
        else { buf.buf_emit16_le(&out, 0); }
        if (sy.is_global == 1) { buf.buf_emit8(&out, 2); }  // IMAGE_SYM_CLASS_EXTERNAL
        else { buf.buf_emit8(&out, 3); }                    // IMAGE_SYM_CLASS_STATIC
        buf.buf_emit8(&out, 0);                             // NumberOfAuxSymbols
        si = si + 1;
    }

    buf.buf_append(&out, strtab.data, strtab.len);
    io._write_fd(fd, out.data, out.len);
}
