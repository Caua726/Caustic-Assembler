use "../std/linux.cst" as linux;
use "../std/mem.cst" as mem;
use "../src/ir/opt_mem.cst" as om;
use "lexer.cst" as lex;
use "encoder_util.cst" as enc;
use "encoder_emit.cst" as ence;
use "encoder_size.cst" as encs;
use "asm_defs.cst" as def;
use "buf.cst" as buf;
use "elf.cst" as elf;
use "../src/codegen/target.cst" as tgt;

// Section IDs. Custom sections (declared via `.section <name>`) are numbered
// from 4 upward; csec_* globals below hold their names and byte buffers.
let is i32 as SECTION_TEXT        with imut = 0;
let is i32 as SECTION_DATA        with imut = 1;
let is i32 as SECTION_RODATA      with imut = 2;
let is i32 as SECTION_BSS         with imut = 3;
let is i32 as SECTION_CUSTOM_BASE with imut = 4;
let is i32 as SECTION_UNDEF       with imut = 99;
let is i32 as MAX_CUSTOM_SECTIONS with imut = 32;

// Custom sections — parallel arrays, allocated lazily in csec_init.
let is *u8 as csec_name_ptrs with mut;
let is *u8 as csec_name_lens with mut;
let is *u8 as csec_buf_ptrs  with mut;
let is *u8 as csec_reloc_ptrs with mut;  // 32 * 8 — array of *elf.RelocList
let is i32 as csec_count with mut = 0;

fn csec_init() as void {
    csec_name_ptrs  = om.opt_alloc(cast(i64, MAX_CUSTOM_SECTIONS) * 8);
    csec_name_lens  = om.opt_alloc(cast(i64, MAX_CUSTOM_SECTIONS) * 4);
    csec_buf_ptrs   = om.opt_alloc(cast(i64, MAX_CUSTOM_SECTIONS) * 8);
    csec_reloc_ptrs = om.opt_alloc(cast(i64, MAX_CUSTOM_SECTIONS) * 8);
    csec_count = 0;
}

fn csec_find_or_add(name as *u8, name_len as i32) as i32 {
    let is *i64 as np = cast(*i64, csec_name_ptrs);
    let is *i32 as nl = cast(*i32, csec_name_lens);
    let is i32 as i with mut = 0;
    while (i < csec_count) {
        if (nl[i] == name_len && enc.streq(cast(*u8, np[i]), nl[i], name, name_len) == 1) {
            return i;
        }
        i = i + 1;
    }
    if (csec_count >= MAX_CUSTOM_SECTIONS) { return SECTION_DATA; } // fallback
    let is i32 as idx = csec_count;
    np[idx] = cast(i64, name);
    nl[idx] = name_len;
    let is *u8 as bb_mem = om.opt_alloc(sizeof(buf.ByteBuffer));
    let is *buf.ByteBuffer as bbp = cast(*buf.ByteBuffer, bb_mem);
    let is buf.ByteBuffer as tmp = buf.buf_init(512);
    bbp.data = tmp.data;
    bbp.len  = tmp.len;
    bbp.cap  = tmp.cap;
    let is *i64 as bp = cast(*i64, csec_buf_ptrs);
    bp[idx] = cast(i64, bb_mem);
    // Allocate a RelocList for this section (empty by default).
    let is *u8 as rl_mem = om.opt_alloc(sizeof(elf.RelocList));
    let is *elf.RelocList as rlp = cast(*elf.RelocList, rl_mem);
    let is elf.RelocList as rtmp = elf.reloc_init();
    rlp.data  = rtmp.data;
    rlp.count = rtmp.count;
    rlp.cap   = rtmp.cap;
    let is *i64 as rp = cast(*i64, csec_reloc_ptrs);
    rp[idx] = cast(i64, rl_mem);
    csec_count = csec_count + 1;
    return idx;
}

// Line kinds
let is i32 as LINE_EMPTY     with imut = 0;
let is i32 as LINE_LABEL     with imut = 1;
let is i32 as LINE_INST      with imut = 2;
let is i32 as LINE_DIRECTIVE with imut = 3;

// Directive kinds
let is i32 as DIR_TEXT     with imut = 1;
let is i32 as DIR_DATA     with imut = 2;
let is i32 as DIR_RODATA   with imut = 3;
let is i32 as DIR_BSS      with imut = 4;
let is i32 as DIR_GLOBL    with imut = 5;
let is i32 as DIR_STRING   with imut = 6;
let is i32 as DIR_BYTE     with imut = 7;
let is i32 as DIR_WORD     with imut = 8;
let is i32 as DIR_LONG     with imut = 9;
let is i32 as DIR_QUAD     with imut = 10;
let is i32 as DIR_ZERO     with imut = 11;
let is i32 as DIR_SECTION  with imut = 12;
let is i32 as DIR_INTEL    with imut = 13;
let is i32 as DIR_OTHER    with imut = 14;
let is i32 as DIR_ASCII    with imut = 15;

// === I/O helpers ===

fn strlen(s as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

fn print_str(s as *u8) as void {
    linux.write(linux.STDOUT, s, strlen(s));
}

fn print_int(n as i64) as void {
    if (n == 0) { linux.write(linux.STDOUT, "0", 1); return; }
    let is [24]u8 as buf;
    let is i64 as val with mut = n;
    let is i64 as neg with mut = 0;
    if (val < 0) { neg = 1; val = 0 - val; }
    let is i32 as pos with mut = 23;
    while (val > 0) {
        buf[pos] = cast(u8, (val % 10) + 48);
        val = val / 10;
        pos = pos - 1;
    }
    if (neg == 1) { buf[pos] = 45; pos = pos - 1; }
    let is i64 as start = cast(i64, pos) + 1;
    linux.write(linux.STDOUT, cast(*u8, cast(i64, &buf) + start), 24 - start);
}

fn read_file(path as *u8) as *u8 {
    let is i64 as fd = linux.open(path, linux.O_RDONLY, 0);
    if (fd < 0) { return cast(*u8, 0); }
    let is i64 as size = linux.lseek(fd, 0, linux.SEEK_END);
    linux.lseek(fd, 0, linux.SEEK_SET);
    if (size <= 0) { linux.close(fd); return cast(*u8, 0); }
    let is *u8 as buf = om.opt_alloc(size + 1);
    linux.read(fd, buf, size);
    buf[size] = cast(u8, 0);
    linux.close(fd);
    return buf;
}

fn read_file_size(path as *u8) as i64 {
    let is i64 as fd = linux.open(path, linux.O_RDONLY, 0);
    if (fd < 0) { return 0; }
    let is i64 as size = linux.lseek(fd, 0, linux.SEEK_END);
    linux.close(fd);
    return size;
}

fn make_output_name(input as *u8) as *u8 {
    let is i64 as len = strlen(input);
    let is *u8 as out = om.opt_alloc(len + 3);
    mem.memcpy(out, input, len);
    out[len] = 46;     // '.'
    out[len + 1] = 111; // 'o'
    out[len + 2] = 0;
    return out;
}

// === ParsedLine structs ===

struct ParsedLine {
    kind as i32;
    section as i32;
    inst_id as i32;
    // op1 flattened
    op1_kind as i32;
    op1_reg_id as i32;
    op1_imm as i64;
    op1_mem_base as i32;
    op1_mem_disp as i64;
    op1_mem_size as i32;
    op1_mem_index as i32;
    op1_mem_scale as i32;
    op1_label_ptr as *u8;
    op1_label_len as i32;
    // op2 flattened
    op2_kind as i32;
    op2_reg_id as i32;
    op2_imm as i64;
    op2_mem_base as i32;
    op2_mem_disp as i64;
    op2_mem_size as i32;
    op2_mem_index as i32;
    op2_mem_scale as i32;
    op2_label_ptr as *u8;
    op2_label_len as i32;
    // other
    label_ptr as *u8;
    label_len as i32;
    dir_kind as i32;
    dir_arg_ptr as *u8;
    dir_arg_len as i32;
    dir_num as i64;
    decoded_ptr as *u8;
    decoded_len as i32;
    offset as i64;
    size as i32;
    line_no as i32;
}

struct ParsedLines {
    data as *u8;
    count as i32;
    cap as i32;
}

fn pl_init(hint as i32) as ParsedLines {
    let is i32 as cap with mut = hint;
    if (cap < 4096) { cap = 4096; }
    let is ParsedLines as pl;
    pl.data = om.opt_alloc(cast(i64, cap) * sizeof(ParsedLine));
    pl.count = 0;
    pl.cap = cap;
    return pl;
}

fn pl_get(pl as *ParsedLines, idx as i32) as *ParsedLine {
    return cast(*ParsedLine, cast(i64, pl.data) + cast(i64, idx) * sizeof(ParsedLine));
}

fn pl_add(pl as *ParsedLines) as *ParsedLine {
    if (pl.count >= pl.cap) {
        let is i32 as new_cap = pl.cap * 2;
        let is *u8 as new_data = om.opt_alloc(cast(i64, new_cap) * sizeof(ParsedLine));
        mem.memcpy(new_data, pl.data, cast(i64, pl.count) * sizeof(ParsedLine));
        om.opt_free(pl.data);
        pl.data = new_data;
        pl.cap = new_cap;
    }
    let is *ParsedLine as line = pl_get(pl, pl.count);
    // Fast word-at-a-time zero
    let is *u8 as lp = cast(*u8, line);
    let is i64 as sz = sizeof(ParsedLine);
    let is i64 as wi with mut = 0;
    let is i64 as wn = sz / 8;
    while (wi < wn) {
        let is *i64 as wp = cast(*i64, cast(i64, lp) + wi * 8);
        *wp = 0;
        wi = wi + 1;
    }
    line.op1_reg_id = def.REG_NONE;
    line.op1_mem_base = def.REG_NONE;
    line.op1_mem_index = def.REG_NONE;
    line.op2_reg_id = def.REG_NONE;
    line.op2_mem_base = def.REG_NONE;
    line.op2_mem_index = def.REG_NONE;
    pl.count = pl.count + 1;
    return line;
}

// === Operand helpers ===

fn make_op(line as *ParsedLine, which as i32) as def.Operand {
    let is def.Operand as op;
    if (which == 1) {
        op.kind = line.op1_kind;
        op.reg_id = line.op1_reg_id;
        op.imm = line.op1_imm;
        op.mem_base = line.op1_mem_base;
        op.mem_disp = line.op1_mem_disp;
        op.mem_size = line.op1_mem_size;
        op.mem_index = line.op1_mem_index;
        op.mem_scale = line.op1_mem_scale;
        op.label_ptr = line.op1_label_ptr;
        op.label_len = line.op1_label_len;
    } else {
        op.kind = line.op2_kind;
        op.reg_id = line.op2_reg_id;
        op.imm = line.op2_imm;
        op.mem_base = line.op2_mem_base;
        op.mem_disp = line.op2_mem_disp;
        op.mem_size = line.op2_mem_size;
        op.mem_index = line.op2_mem_index;
        op.mem_scale = line.op2_mem_scale;
        op.label_ptr = line.op2_label_ptr;
        op.label_len = line.op2_label_len;
    }
    return op;
}

fn set_op_reg(line as *ParsedLine, which as i32, reg_id as i32) as void {
    if (which == 1) { line.op1_kind = def.OP_REG; line.op1_reg_id = reg_id; }
    else { line.op2_kind = def.OP_REG; line.op2_reg_id = reg_id; }
}

fn set_op_imm(line as *ParsedLine, which as i32, val as i64) as void {
    if (which == 1) { line.op1_kind = def.OP_IMM; line.op1_imm = val; }
    else { line.op2_kind = def.OP_IMM; line.op2_imm = val; }
}

fn set_op_mem(line as *ParsedLine, which as i32, base as i32, disp as i64, sz as i32) as void {
    if (which == 1) { line.op1_kind = def.OP_MEM; line.op1_mem_base = base; line.op1_mem_disp = disp; line.op1_mem_size = sz; line.op1_mem_index = def.REG_NONE; line.op1_mem_scale = 0; }
    else { line.op2_kind = def.OP_MEM; line.op2_mem_base = base; line.op2_mem_disp = disp; line.op2_mem_size = sz; line.op2_mem_index = def.REG_NONE; line.op2_mem_scale = 0; }
}

fn set_op_mem_sib(line as *ParsedLine, which as i32, base as i32, index as i32, scale as i32, disp as i64, sz as i32) as void {
    if (which == 1) {
        line.op1_kind = def.OP_MEM;
        line.op1_mem_base = base;
        line.op1_mem_index = index;
        line.op1_mem_scale = scale;
        line.op1_mem_disp = disp;
        line.op1_mem_size = sz;
    } else {
        line.op2_kind = def.OP_MEM;
        line.op2_mem_base = base;
        line.op2_mem_index = index;
        line.op2_mem_scale = scale;
        line.op2_mem_disp = disp;
        line.op2_mem_size = sz;
    }
}

fn set_op_label(line as *ParsedLine, which as i32, ptr as *u8, len as i32) as void {
    if (which == 1) { line.op1_kind = def.OP_LABEL; line.op1_label_ptr = ptr; line.op1_label_len = len; }
    else { line.op2_kind = def.OP_LABEL; line.op2_label_ptr = ptr; line.op2_label_len = len; }
}

fn set_op_rip(line as *ParsedLine, which as i32, ptr as *u8, len as i32, sz as i32) as void {
    if (which == 1) { line.op1_kind = def.OP_RIP_LABEL; line.op1_label_ptr = ptr; line.op1_label_len = len; line.op1_mem_size = sz; }
    else { line.op2_kind = def.OP_RIP_LABEL; line.op2_label_ptr = ptr; line.op2_label_len = len; line.op2_mem_size = sz; }
}

// === Operand parsing ===

// Parse a memory operand: [base +/- disp] with optional size prefix
fn parse_mem_operand(tl as *lex.TokenList, pos as i32, out_pos as *i32, line as *ParsedLine, which as i32, mem_size as i32) as void {
    let is i32 as p with mut = pos + 1; // skip '['
    let is *lex.Token as base_tok = lex.tl_get(tl, p);
    let is i32 as base_reg = base_tok.id;
    p = p + 1;
    if (base_reg == 99) {
        let is *lex.Token as op_tok = lex.tl_get(tl, p);
        if (op_tok.kind == lex.TK_PLUS) {
            p = p + 1;
            let is *lex.Token as lab_tok = lex.tl_get(tl, p);
            p = p + 1;
            let is *lex.Token as rb = lex.tl_get(tl, p);
            if (rb.kind == lex.TK_RBRACKET) { p = p + 1; }
            *out_pos = p;
            set_op_rip(line, which, lab_tok.ptr, lab_tok.len, mem_size);
            return;
        }
    }
    let is i64 as disp with mut = 0;
    let is i32 as index_reg with mut = def.REG_NONE;
    let is i32 as scale with mut = 0;
    let is *lex.Token as next2 = lex.tl_get(tl, p);
    if (next2.kind == lex.TK_PLUS) {
        let is *lex.Token as peek = lex.tl_get(tl, p + 1);
        if (peek.kind == lex.TK_REGISTER) {
            p = p + 1;
            index_reg = peek.id;
            p = p + 1;
            let is *lex.Token as star = lex.tl_get(tl, p);
            if (star.kind == lex.TK_STAR) {
                p = p + 1;
                let is *lex.Token as sc = lex.tl_get(tl, p);
                scale = cast(i32, sc.num_val);
                p = p + 1;
            } else {
                scale = 1;
            }
            let is *lex.Token as after = lex.tl_get(tl, p);
            if (after.kind == lex.TK_PLUS) {
                p = p + 1;
                let is *lex.Token as d = lex.tl_get(tl, p);
                disp = d.num_val;
                p = p + 1;
            } else if (after.kind == lex.TK_MINUS) {
                p = p + 1;
                let is *lex.Token as d = lex.tl_get(tl, p);
                disp = 0 - d.num_val;
                p = p + 1;
            }
        } else {
            p = p + 1;
            let is *lex.Token as d = lex.tl_get(tl, p);
            disp = d.num_val;
            p = p + 1;
        }
    } else if (next2.kind == lex.TK_MINUS) {
        p = p + 1;
        let is *lex.Token as d = lex.tl_get(tl, p);
        disp = 0 - d.num_val;
        p = p + 1;
    }
    let is *lex.Token as rb2 = lex.tl_get(tl, p);
    if (rb2.kind == lex.TK_RBRACKET) { p = p + 1; }
    *out_pos = p;
    if (index_reg != def.REG_NONE) {
        set_op_mem_sib(line, which, base_reg, index_reg, scale, disp, mem_size);
    } else {
        set_op_mem(line, which, base_reg, disp, mem_size);
    }
}

// Parse an operand starting at token index pos, stores into line's op1 or op2
fn parse_operand(tl as *lex.TokenList, pos as i32, out_pos as *i32, line as *ParsedLine, which as i32) as void {
    let is *lex.Token as tok = lex.tl_get(tl, pos);

    if (tok.kind == lex.TK_REGISTER) {
        *out_pos = pos + 1;
        set_op_reg(line, which, tok.id);
        return;
    }
    if (tok.kind == lex.TK_NUMBER) {
        *out_pos = pos + 1;
        set_op_imm(line, which, tok.num_val);
        return;
    }
    if (tok.kind == lex.TK_MINUS) {
        let is *lex.Token as next = lex.tl_get(tl, pos + 1);
        if (next.kind == lex.TK_NUMBER) {
            *out_pos = pos + 2;
            set_op_imm(line, which, 0 - next.num_val);
            return;
        }
    }
    if (tok.kind == lex.TK_SIZE_PREFIX) {
        let is *lex.Token as lb = lex.tl_get(tl, pos + 1);
        if (lb.kind == lex.TK_LBRACKET) {
            parse_mem_operand(tl, pos + 1, out_pos, line, which, tok.id);
            return;
        }
    }
    if (tok.kind == lex.TK_LBRACKET) {
        parse_mem_operand(tl, pos, out_pos, line, which, 0);
        return;
    }
    if (tok.kind == lex.TK_IDENT || tok.kind == lex.TK_INSTRUCTION) {
        *out_pos = pos + 1;
        set_op_label(line, which, tok.ptr, tok.len);
        return;
    }
    *out_pos = pos;
}

// === String decoding ===

fn decode_string(ptr as *u8, len as i32, out_len as *i32) as *u8 {
    let is *u8 as buf = om.opt_alloc(cast(i64, len));
    let is i32 as out with mut = 0;
    let is i32 as i with mut = 1; // skip opening quote
    let is i32 as end = len - 1; // skip closing quote

    while (i < end) {
        if (ptr[i] == 92) { // backslash
            i = i + 1;
            if (i >= end) { break; }
            if (ptr[i] == 110) { buf[out] = 10; } // \n
            else if (ptr[i] == 116) { buf[out] = 9; } // \t
            else if (ptr[i] == 114) { buf[out] = 13; } // \r
            else if (ptr[i] == 92) { buf[out] = 92; } // \\
            else if (ptr[i] == 34) { buf[out] = 34; } // \"
            else if (ptr[i] >= 48 && ptr[i] <= 55) { // \NNN octal
                let is i32 as oval with mut = cast(i32, ptr[i]) - 48;
                if (i + 1 < end && ptr[i + 1] >= 48 && ptr[i + 1] <= 55) {
                    i = i + 1; oval = oval * 8 + (cast(i32, ptr[i]) - 48);
                }
                if (i + 1 < end && ptr[i + 1] >= 48 && ptr[i + 1] <= 55) {
                    i = i + 1; oval = oval * 8 + (cast(i32, ptr[i]) - 48);
                }
                buf[out] = cast(u8, oval);
            }
            else { buf[out] = ptr[i]; }
        } else {
            buf[out] = ptr[i];
        }
        out = out + 1;
        i = i + 1;
    }
    *out_len = out;
    return buf;
}

// === Parsing: skip to end of line ===

fn skip_to_eol(tl as *lex.TokenList, pos as i32) as i32 {
    let is i32 as p with mut = pos;
    while (p < tl.count) {
        let is *lex.Token as t = lex.tl_get(tl, p);
        if (t.kind == lex.TK_NEWLINE || t.kind == lex.TK_EOF) { break; }
        p = p + 1;
    }
    return p;
}

// === Parsing: parse a numeric value (possibly negative) ===

fn parse_dir_num(tl as *lex.TokenList, pos as i32, out_pos as *i32) as i64 {
    let is *lex.Token as val_tok = lex.tl_get(tl, pos);
    if (val_tok.kind == lex.TK_NUMBER) {
        *out_pos = pos + 1;
        return val_tok.num_val;
    } else if (val_tok.kind == lex.TK_MINUS) {
        let is *lex.Token as n = lex.tl_get(tl, pos + 1);
        *out_pos = pos + 2;
        return 0 - n.num_val;
    }
    *out_pos = pos;
    return 0;
}

// === Parsing: directive handler ===

fn parse_directive(tl as *lex.TokenList, pos as i32, line as *ParsedLine, current_section as *i32) as i32 {
    let is *lex.Token as tok = lex.tl_get(tl, pos);
    let is i32 as p with mut = pos;

    if (enc.streq_lit(tok.ptr, tok.len, ".intel_syntax") == 1) {
        line.dir_kind = DIR_INTEL;
        p = skip_to_eol(tl, p + 1);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".text") == 1) {
        line.dir_kind = DIR_TEXT;
        *current_section = SECTION_TEXT;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".data") == 1) {
        line.dir_kind = DIR_DATA;
        *current_section = SECTION_DATA;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".bss") == 1) {
        line.dir_kind = DIR_BSS;
        *current_section = SECTION_BSS;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".rodata") == 1) {
        line.dir_kind = DIR_RODATA;
        *current_section = SECTION_RODATA;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".section") == 1) {
        line.dir_kind = DIR_SECTION;
        p = p + 1;
        let is *lex.Token as sec_tok = lex.tl_get(tl, p);
        if (sec_tok.kind != lex.TK_NEWLINE && sec_tok.kind != lex.TK_EOF) {
            if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".rodata") == 1) { *current_section = SECTION_RODATA; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".data") == 1) { *current_section = SECTION_DATA; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".bss") == 1) { *current_section = SECTION_BSS; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".text") == 1) { *current_section = SECTION_TEXT; }
            else {
                // Custom section. Strip surrounding quotes if present.
                let is *u8 as sname with mut = sec_tok.ptr;
                let is i32 as sname_len with mut = sec_tok.len;
                if (sname_len > 2 && sname[0] == 34 && sname[sname_len - 1] == 34) {
                    sname = cast(*u8, cast(i64, sname) + 1);
                    sname_len = sname_len - 2;
                }
                let is i32 as cidx = csec_find_or_add(sname, sname_len);
                *current_section = SECTION_CUSTOM_BASE + cidx;
            }
            p = p + 1;
        }
        line.section = *current_section;
        p = skip_to_eol(tl, p);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".globl") == 1 || enc.streq_lit(tok.ptr, tok.len, ".global") == 1) {
        line.dir_kind = DIR_GLOBL;
        p = p + 1;
        let is *lex.Token as name_tok = lex.tl_get(tl, p);
        if (name_tok.kind != lex.TK_NEWLINE && name_tok.kind != lex.TK_EOF) {
            line.dir_arg_ptr = name_tok.ptr;
            line.dir_arg_len = name_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".ascii") == 1) {
        line.dir_kind = DIR_ASCII;
        line.section = *current_section;
        p = p + 1;
        let is *lex.Token as asc_tok = lex.tl_get(tl, p);
        if (asc_tok.kind == lex.TK_STRING) {
            line.dir_arg_ptr = asc_tok.ptr;
            line.dir_arg_len = asc_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".string") == 1 || enc.streq_lit(tok.ptr, tok.len, ".asciz") == 1) {
        line.dir_kind = DIR_STRING;
        line.section = *current_section;
        p = p + 1;
        let is *lex.Token as str_tok = lex.tl_get(tl, p);
        if (str_tok.kind == lex.TK_STRING) {
            line.dir_arg_ptr = str_tok.ptr;
            line.dir_arg_len = str_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".byte") == 1) {
        line.dir_kind = DIR_BYTE;
        line.section = *current_section;
        p = p + 1;
        let is i32 as np with mut = p;
        line.dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".word") == 1 || enc.streq_lit(tok.ptr, tok.len, ".value") == 1) {
        line.dir_kind = DIR_WORD;
        line.section = *current_section;
        p = p + 1;
        let is i32 as np with mut = p;
        line.dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".long") == 1) {
        line.dir_kind = DIR_LONG;
        line.section = *current_section;
        p = p + 1;
        let is i32 as np with mut = p;
        line.dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".quad") == 1) {
        line.dir_kind = DIR_QUAD;
        line.section = *current_section;
        p = p + 1;
        let is *lex.Token as qt = lex.tl_get(tl, p);
        if (qt.kind == lex.TK_IDENT) {
            // `.quad <symbol>` — emits an R_X86_64_64 relocation at codegen.
            line.dir_arg_ptr = qt.ptr;
            line.dir_arg_len = qt.len;
            line.dir_num = 0;
            return p + 1;
        }
        let is i32 as np with mut = p;
        line.dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".zero") == 1) {
        line.dir_kind = DIR_ZERO;
        line.section = *current_section;
        p = p + 1;
        let is *lex.Token as val_tok = lex.tl_get(tl, p);
        if (val_tok.kind == lex.TK_NUMBER) {
            line.dir_num = val_tok.num_val;
            p = p + 1;
        }
        return p;
    }
    line.dir_kind = DIR_OTHER;
    return p + 1;
}

// === Parsing: instruction handler ===

fn parse_instruction(tl as *lex.TokenList, pos as i32, line as *ParsedLine) as i32 {
    let is i32 as p with mut = pos;

    // Handle "rep movsb" — don't parse operands for REP
    if (line.inst_id == def.INST_REP) {
        return p;
    }

    // Parse operand 1
    let is *lex.Token as next = lex.tl_get(tl, p);
    if (next.kind != lex.TK_NEWLINE && next.kind != lex.TK_EOF) {
        let is i32 as new_pos with mut = p;
        parse_operand(tl, p, &new_pos, line, 1);
        p = new_pos;

        // Check for comma -> operand 2
        let is *lex.Token as comma = lex.tl_get(tl, p);
        if (comma.kind == lex.TK_COMMA) {
            p = p + 1;
            parse_operand(tl, p, &new_pos, line, 2);
            p = new_pos;
        }
    }
    // Skip to end of line
    p = skip_to_eol(tl, p);
    return p;
}

// === Parsing: main loop ===

fn parse_all(tl as *lex.TokenList, line_hint as i32) as ParsedLines {
    let is ParsedLines as lines = pl_init(line_hint);
    let is i32 as pos with mut = 0;
    let is i32 as current_section with mut = SECTION_TEXT;

    while (pos < tl.count) {
        let is *lex.Token as tok = lex.tl_get(tl, pos);

        // Skip newlines
        if (tok.kind == lex.TK_NEWLINE || tok.kind == lex.TK_EOF) {
            if (tok.kind == lex.TK_EOF) { break; }
            pos = pos + 1;
        }
        // Directive
        else if (tok.kind == lex.TK_DIRECTIVE) {
            let is *ParsedLine as line = pl_add(&lines);
            line.kind = LINE_DIRECTIVE;
            line.section = current_section;
            line.line_no = 0;
            pos = parse_directive(tl, pos, line, &current_section);
            // Update section from directive (may have changed)
            line.section = current_section;
            pos = skip_to_eol(tl, pos);
        }
        // Instruction (but check for label first: "add:" etc.)
        else if (tok.kind == lex.TK_INSTRUCTION) {
            let is *lex.Token as peek = lex.tl_get(tl, pos + 1);
            if (peek.kind == lex.TK_COLON) {
                let is *ParsedLine as lbl = pl_add(&lines);
                lbl.kind = LINE_LABEL;
                lbl.section = current_section;
                lbl.label_ptr = tok.ptr;
                lbl.label_len = tok.len;
                lbl.line_no = 0;
                pos = pos + 2;
            } else {
                let is *ParsedLine as line = pl_add(&lines);
                line.kind = LINE_INST;
                line.section = current_section;
                line.inst_id = tok.id;
                line.line_no = 0;
                pos = parse_instruction(tl, pos + 1, line);
            }
        }
        // Label (IDENT followed by COLON)
        else if (tok.kind == lex.TK_IDENT) {
            let is *lex.Token as next = lex.tl_get(tl, pos + 1);
            if (next.kind == lex.TK_COLON) {
                let is *ParsedLine as line = pl_add(&lines);
                line.kind = LINE_LABEL;
                line.section = current_section;
                line.label_ptr = tok.ptr;
                line.label_len = tok.len;
                line.line_no = 0;
                pos = pos + 2;
            } else {
                pos = skip_to_eol(tl, pos + 1);
            }
        }
        else {
            pos = pos + 1;
        }
    }

    return lines;
}

// === Pass 1: collect symbols, calculate sizes ===

fn calc_inst_size(line as *ParsedLine) as i32 {
    let is def.Operand as o1 = make_op(line, 1);
    let is def.Operand as o2 = make_op(line, 2);
    return encs.fast_inst_size(line.inst_id, &o1, &o2);
}

fn calc_dir_size(line as *ParsedLine) as i32 {
    if (line.dir_kind == DIR_STRING || line.dir_kind == DIR_ASCII) {
        let is i32 as decoded_len with mut = 0;
        let is *u8 as decoded = decode_string(line.dir_arg_ptr, line.dir_arg_len, &decoded_len);
        line.decoded_ptr = decoded;
        line.decoded_len = decoded_len;
        if (line.dir_kind == DIR_STRING) { return decoded_len + 1; }
        return decoded_len; // .ascii: no null terminator
    }
    if (line.dir_kind == DIR_BYTE) { return 1; }
    if (line.dir_kind == DIR_WORD) { return 2; }
    if (line.dir_kind == DIR_LONG) { return 4; }
    if (line.dir_kind == DIR_QUAD) { return 8; }
    if (line.dir_kind == DIR_ZERO) { return cast(i32, line.dir_num); }
    return 0;
}

fn pass1(lines as *ParsedLines, symtab as *elf.SymbolTable) as void {
    let is i64 as text_off with mut = 0;
    let is i64 as data_off with mut = 0;
    let is i64 as rodata_off with mut = 0;
    let is i64 as bss_off with mut = 0;
    let is i32 as i with mut = 0;

    while (i < lines.count) {
        let is *ParsedLine as line = pl_get(lines, i);

        if (line.kind == LINE_LABEL) {
            let is i64 as off with mut = 0;
            if (line.section == SECTION_TEXT) { off = text_off; }
            else if (line.section == SECTION_DATA) { off = data_off; }
            else if (line.section == SECTION_RODATA) { off = rodata_off; }
            else if (line.section == SECTION_BSS) { off = bss_off; }
            elf.sym_find_or_add(symtab, line.label_ptr, line.label_len, line.section, off, 0);
        }
        else if (line.kind == LINE_DIRECTIVE) {
            if (line.dir_kind == DIR_GLOBL) {
                elf.sym_find_or_add(symtab, line.dir_arg_ptr, line.dir_arg_len, SECTION_UNDEF, 0, 1);
            }
            else if (line.dir_kind == DIR_STRING || line.dir_kind == DIR_ASCII || line.dir_kind == DIR_BYTE || line.dir_kind == DIR_WORD ||
                     line.dir_kind == DIR_LONG || line.dir_kind == DIR_QUAD || line.dir_kind == DIR_ZERO) {
                let is i32 as sz = calc_dir_size(line);
                line.size = sz;
                if (line.section == SECTION_TEXT)   { line.offset = text_off; text_off = text_off + cast(i64, sz); }
                if (line.section == SECTION_DATA)   { line.offset = data_off; data_off = data_off + cast(i64, sz); }
                if (line.section == SECTION_RODATA) { line.offset = rodata_off; rodata_off = rodata_off + cast(i64, sz); }
                if (line.section == SECTION_BSS)    { line.offset = bss_off; bss_off = bss_off + cast(i64, sz); }
            }
        }
        else if (line.kind == LINE_INST) {
            let is i32 as sz = calc_inst_size(line);
            line.size = sz;
            line.offset = text_off;
            text_off = text_off + cast(i64, sz);
        }
        i = i + 1;
    }
}

// === Pass 2: encode instructions and emit data ===

fn pass2_resolve_label(line as *ParsedLine, symtab as *elf.SymbolTable, out_undef as *i32, out_sym_idx as *i32) as i64 {
    let is i32 as idx = elf.sym_find(symtab, line.op1_label_ptr, line.op1_label_len);
    if (idx != 99999) {
        let is *elf.Symbol as sym = elf.sym_get(symtab, idx);
        if (sym.section == SECTION_TEXT) {
            *out_undef = 0;
            return sym.offset;
        }
        *out_undef = 1;
        *out_sym_idx = idx;
        return 0;
    }
    let is i32 as new_idx = elf.sym_find_or_add(symtab, line.op1_label_ptr, line.op1_label_len, SECTION_UNDEF, 0, 0);
    *out_undef = 1;
    *out_sym_idx = new_idx;
    return 0;
}

fn pass2_encode_rip(line as *ParsedLine, symtab as *elf.SymbolTable, text_buf as *buf.ByteBuffer,
                    relocs as *elf.RelocList, o1 as *def.Operand, o2 as *def.Operand) as void {
    let is *u8 as lab_ptr with mut = cast(*u8, 0);
    let is i32 as lab_len with mut = 0;
    if (line.op1_kind == def.OP_RIP_LABEL) {
        lab_ptr = line.op1_label_ptr;
        lab_len = line.op1_label_len;
    } else {
        lab_ptr = line.op2_label_ptr;
        lab_len = line.op2_label_len;
    }
    let is i32 as sym_idx = elf.sym_find_or_add(symtab, lab_ptr, lab_len, SECTION_UNDEF, 0, 0);
    let is i32 as sz = encs.fast_inst_size(line.inst_id, o1, o2);
    let is i64 as reloc_off = line.offset + cast(i64, sz) - 4;

    let is *elf.Symbol as rip_sym = elf.sym_get(symtab, sym_idx);
    if (line.inst_id == def.INST_MOV && rip_sym.section == SECTION_UNDEF) {
        rip_sym.is_global = 1;
        elf.reloc_add(relocs, reloc_off, cast(i64, sym_idx), elf.R_X86_64_GOTPCREL, 0 - 4);
    } else {
        elf.reloc_add(relocs, reloc_off, cast(i64, sym_idx), elf.R_X86_64_PC32, 0 - 4);
    }
    ence.encode(text_buf, line.inst_id, o1, o2, 0, line.offset);
}

fn pass2_encode_inst(line as *ParsedLine, symtab as *elf.SymbolTable, text_buf as *buf.ByteBuffer,
                     relocs as *elf.RelocList) as void {
    let is def.Operand as o1 = make_op(line, 1);
    let is def.Operand as o2 = make_op(line, 2);

    // Resolve label targets
    let is i32 as label_is_undef with mut = 0;
    let is i32 as label_sym_idx with mut = 0;
    let is i64 as resolve1 with mut = 0;
    if (line.op1_kind == def.OP_LABEL) {
        resolve1 = pass2_resolve_label(line, symtab, &label_is_undef, &label_sym_idx);
    }

    if (line.op1_kind == def.OP_RIP_LABEL || line.op2_kind == def.OP_RIP_LABEL) {
        pass2_encode_rip(line, symtab, text_buf, relocs, &o1, &o2);
    } else if (label_is_undef == 1 && (line.inst_id == def.INST_CALL || line.inst_id == def.INST_JMP)) {
        let is *elf.Symbol as ext_sym = elf.sym_get(symtab, label_sym_idx);
        ext_sym.is_global = 1;
        let is i64 as reloc_off = line.offset + 1;
        elf.reloc_add(relocs, reloc_off, cast(i64, label_sym_idx), elf.R_X86_64_PLT32, 0 - 4);
        ence.encode(text_buf, line.inst_id, &o1, &o2, 0, line.offset);
    } else if (label_is_undef == 1 && line.inst_id >= def.INST_JZ && line.inst_id <= def.INST_JBE) {
        let is *elf.Symbol as ext_sym = elf.sym_get(symtab, label_sym_idx);
        ext_sym.is_global = 1;
        let is i64 as reloc_off = line.offset + 2;
        elf.reloc_add(relocs, reloc_off, cast(i64, label_sym_idx), elf.R_X86_64_PC32, 0 - 4);
        ence.encode(text_buf, line.inst_id, &o1, &o2, 0, line.offset);
    } else {
        ence.encode(text_buf, line.inst_id, &o1, &o2, resolve1, line.offset);
    }
}

fn pass2_emit_directive(line as *ParsedLine, target as *buf.ByteBuffer, bss_size as *i64) as void {
    if (line.dir_kind == DIR_STRING) {
        buf.buf_append(target, line.decoded_ptr, cast(i64, line.decoded_len));
        buf.buf_emit8(target, 0);
    }
    else if (line.dir_kind == DIR_ASCII) {
        buf.buf_append(target, line.decoded_ptr, cast(i64, line.decoded_len));
    }
    else if (line.dir_kind == DIR_BYTE) {
        buf.buf_emit8(target, cast(i32, line.dir_num));
    }
    else if (line.dir_kind == DIR_WORD) {
        buf.buf_emit16_le(target, cast(i32, line.dir_num));
    }
    else if (line.dir_kind == DIR_LONG) {
        buf.buf_emit32_le(target, line.dir_num);
    }
    else if (line.dir_kind == DIR_QUAD) {
        buf.buf_emit64_le(target, line.dir_num);
    }
    else if (line.dir_kind == DIR_ZERO) {
        if (line.section == SECTION_BSS) {
            *bss_size = *bss_size + line.dir_num;
        } else {
            let is i64 as zi with mut = 0;
            while (zi < line.dir_num) {
                buf.buf_emit8(target, 0);
                zi = zi + 1;
            }
        }
    }
}

fn pass2(lines as *ParsedLines, symtab as *elf.SymbolTable, text_buf as *buf.ByteBuffer,
         data_buf as *buf.ByteBuffer, rodata_buf as *buf.ByteBuffer, bss_size as *i64,
         relocs as *elf.RelocList, data_relocs as *elf.RelocList) as void {
    let is i32 as i with mut = 0;

    while (i < lines.count) {
        let is *ParsedLine as line = pl_get(lines, i);

        if (line.kind == LINE_INST) {
            pass2_encode_inst(line, symtab, text_buf, relocs);
        }
        else if (line.kind == LINE_DIRECTIVE) {
            let is *buf.ByteBuffer as target with mut = text_buf;
            if (line.section == SECTION_DATA)   { target = data_buf; }
            if (line.section == SECTION_RODATA) { target = rodata_buf; }
            if (line.section >= SECTION_CUSTOM_BASE) {
                let is *i64 as bp = cast(*i64, csec_buf_ptrs);
                target = cast(*buf.ByteBuffer, bp[line.section - SECTION_CUSTOM_BASE]);
            }
            if (line.dir_kind == DIR_QUAD && line.dir_arg_len > 0) {
                // `.quad <symbol>` emits an R_X86_64_64 relocation at the
                // current section's offset. Each section has its own reloc
                // list so the ELF writer can emit one .rela.<name> each.
                let is i32 as sym_idx = elf.sym_find_or_add(symtab, line.dir_arg_ptr, line.dir_arg_len, 99, 0, 1);
                let is *elf.Symbol as ext_sym = elf.sym_get(symtab, sym_idx);
                ext_sym.is_global = 1;
                let is i64 as off = cast(i64, target.len);
                let is *elf.RelocList as dest_relocs with mut = relocs;
                if (line.section == SECTION_DATA) { dest_relocs = data_relocs; }
                if (line.section >= SECTION_CUSTOM_BASE) {
                    let is *i64 as rp = cast(*i64, csec_reloc_ptrs);
                    dest_relocs = cast(*elf.RelocList, rp[line.section - SECTION_CUSTOM_BASE]);
                }
                elf.reloc_add(dest_relocs, off, cast(i64, sym_idx), elf.R_X86_64_64, 0);
                buf.buf_emit64_le(target, 0);
            } else {
                pass2_emit_directive(line, target, bss_size);
            }
        }
        i = i + 1;
    }
}

// === Assembler profiling ===

let is [5]i64 as asm_prof_times with mut;
let is i32 as asm_prof_enabled with mut = 0;

fn asm_prof_time() as i64 {
    let is [2]i64 as ts;
    syscall(228, 1, &ts);
    return ts[0] * 1000000 + ts[1] / 1000;
}

fn print_profile() as void {
    let is i64 as total = asm_prof_times[0] + asm_prof_times[1] + asm_prof_times[2] + asm_prof_times[3] + asm_prof_times[4];
    print_str("=== profile ===\n");
    print_str("  tokenize:  "); print_int(asm_prof_times[0] / 1000); print_str("ms\n");
    print_str("  parse:     "); print_int(asm_prof_times[1] / 1000); print_str("ms\n");
    print_str("  pass1:     "); print_int(asm_prof_times[2] / 1000); print_str("ms\n");
    print_str("  pass2:     "); print_int(asm_prof_times[3] / 1000); print_str("ms\n");
    print_str("  write_elf: "); print_int(asm_prof_times[4] / 1000); print_str("ms\n");
    print_str("  total:     "); print_int(total / 1000); print_str("ms\n");
}

// === Public API for library use ===

fn assemble_file(asm_path as *u8, obj_path as *u8) as i32 {
    csec_init();
    let is i64 as file_size = read_file_size(asm_path);
    let is *u8 as src = read_file(asm_path);
    if (cast(i64, src) == 0) {
        print_str("caustic-as: error: cannot read ");
        print_str(asm_path);
        print_str("\n");
        return 1;
    }

    let is i64 as t0 = asm_prof_time();
    let is lex.TokenList as tokens = lex.tokenize(src, file_size);
    if (asm_prof_enabled == 1) { asm_prof_times[0] = asm_prof_time() - t0; }

    let is i64 as t1 = asm_prof_time();
    let is i32 as line_hint = cast(i32, file_size / 24) + 1024;
    let is ParsedLines as lines = parse_all(&tokens, line_hint);
    if (asm_prof_enabled == 1) { asm_prof_times[1] = asm_prof_time() - t1; }

    let is i64 as t2 = asm_prof_time();
    let is elf.SymbolTable as symtab = elf.sym_init();
    pass1(&lines, &symtab);
    if (asm_prof_enabled == 1) { asm_prof_times[2] = asm_prof_time() - t2; }

    let is i64 as t3 = asm_prof_time();
    let is buf.ByteBuffer as text_buf = buf.buf_init(65536);
    let is buf.ByteBuffer as data_buf = buf.buf_init(4096);
    let is buf.ByteBuffer as rodata_buf = buf.buf_init(4096);
    let is i64 as bss_size with mut = 0;
    let is elf.RelocList as relocs = elf.reloc_init();
    let is elf.RelocList as data_relocs = elf.reloc_init();
    pass2(&lines, &symtab, &text_buf, &data_buf, &rodata_buf, &bss_size, &relocs, &data_relocs);
    if (asm_prof_enabled == 1) { asm_prof_times[3] = asm_prof_time() - t3; }

    let is i64 as t4 = asm_prof_time();
    let is i64 as fd = linux.open(obj_path, 577, 420);
    if (fd < 0) {
        print_str("caustic-as: error: cannot create ");
        print_str(obj_path);
        print_str("\n");
        return 1;
    }
    elf.write_elf(fd, &text_buf, &data_buf, &rodata_buf, bss_size, &symtab, &relocs, &data_relocs,
                  csec_buf_ptrs, csec_name_ptrs, csec_name_lens, csec_reloc_ptrs, csec_count);
    linux.close(fd);
    if (asm_prof_enabled == 1) { asm_prof_times[4] = asm_prof_time() - t4; }
    return 0;
}

// === Main ===

fn print_token_profile() as void {
    print_str("  tok: spaces="); print_int(lex.tok_prof_counts[0]);
    print_str(" nl="); print_int(lex.tok_prof_counts[1]);
    print_str(" comment="); print_int(lex.tok_prof_counts[2]);
    print_str(" punct="); print_int(lex.tok_prof_counts[3]);
    print_str(" num="); print_int(lex.tok_prof_counts[4]);
    print_str(" dot="); print_int(lex.tok_prof_counts[5]);
    print_str(" id_short="); print_int(lex.tok_prof_counts[6]);
    print_str(" id_long="); print_int(lex.tok_prof_counts[7]);
    print_str("\n");
}

fn print_section_sizes(text_buf as *buf.ByteBuffer, data_buf as *buf.ByteBuffer,
                       rodata_buf as *buf.ByteBuffer, bss_size as i64, relocs as *elf.RelocList) as void {
    print_str("  .text: "); print_int(text_buf.len); print_str(" bytes\n");
    print_str("  .data: "); print_int(data_buf.len); print_str(" bytes\n");
    print_str("  .rodata: "); print_int(rodata_buf.len); print_str(" bytes\n");
    print_str("  .bss: "); print_int(bss_size); print_str(" bytes\n");
    print_str("  relocations: "); print_int(cast(i64, relocs.count)); print_str("\n");
}

fn main(argc as i64, argv as i64) as i32 {
    csec_init();
    if (argc < 2) {
        linux.write(linux.STDERR, "Usage: caustic-as <input.s>\n", 28);
        return 1;
    }

    let is *i64 as argv_arr = cast(*i64, argv);
    let is *u8 as filename with mut = cast(*u8, argv_arr[1]);

    tgt.target_init();

    // Check for --profile, --target= flags
    let is i32 as ai with mut = 1;
    while (ai < argc) {
        let is *u8 as arg = cast(*u8, argv_arr[ai]);
        let is i32 as alen with mut = 0;
        while (arg[alen] != cast(u8, 0)) { alen = alen + 1; }
        if (enc.streq(arg, 9, "--profile", 9) == 1) {
            asm_prof_enabled = 1;
        } else if (alen > 9 && arg[0] == 45 && arg[1] == 45 && arg[2] == 116 && arg[3] == 97 && arg[4] == 114 && arg[5] == 103 && arg[6] == 101 && arg[7] == 116 && arg[8] == 61) {
            // --target=<triple>
            let is *u8 as triple = cast(*u8, cast(i64, arg) + 9);
            let is i32 as tlen = alen - 9;
            let is i32 as ok = tgt.load_target(triple, tlen);
            if (ok == 0) {
                linux.write(linux.STDERR, "caustic-as: unknown --target\n", 29);
                return 1;
            }
            if (tgt.str_eq_local(triple, tlen, "windows-x86_64", 14) == 1) {
                linux.write(linux.STDERR, "caustic-as: windows-x86_64 not yet implemented\n", 47);
                return 1;
            }
        } else {
            filename = arg;
        }
        ai = ai + 1;
    }

    let is i64 as file_size = read_file_size(filename);
    let is *u8 as src = read_file(filename);
    if (cast(i64, src) == 0) {
        linux.write(linux.STDERR, "Error: cannot read file\n", 24);
        return 1;
    }

    print_str("caustic-as: assembling ");
    print_str(filename);
    print_str(" ("); print_int(file_size); print_str(" bytes)\n");

    // Tokenize
    let is i64 as t0 = asm_prof_time();
    let is lex.TokenList as tokens = lex.tokenize(src, file_size);
    if (asm_prof_enabled == 1) { asm_prof_times[0] = asm_prof_time() - t0; }
    print_str("  tokens: "); print_int(cast(i64, tokens.count)); print_str("\n");
    if (asm_prof_enabled == 1) { print_token_profile(); }

    // Parse
    let is i64 as t1 = asm_prof_time();
    let is i32 as line_hint = cast(i32, file_size / 24) + 1024;
    let is ParsedLines as lines = parse_all(&tokens, line_hint);
    if (asm_prof_enabled == 1) { asm_prof_times[1] = asm_prof_time() - t1; }
    print_str("  lines: "); print_int(cast(i64, lines.count)); print_str("\n");

    // Pass 1
    let is i64 as t2 = asm_prof_time();
    let is elf.SymbolTable as symtab = elf.sym_init();
    pass1(&lines, &symtab);
    if (asm_prof_enabled == 1) { asm_prof_times[2] = asm_prof_time() - t2; }
    print_str("  symbols: "); print_int(cast(i64, symtab.count)); print_str("\n");

    // Pass 2
    let is i64 as t3 = asm_prof_time();
    let is buf.ByteBuffer as text_buf = buf.buf_init(65536);
    let is buf.ByteBuffer as data_buf = buf.buf_init(4096);
    let is buf.ByteBuffer as rodata_buf = buf.buf_init(4096);
    let is i64 as bss_size with mut = 0;
    let is elf.RelocList as relocs = elf.reloc_init();
    let is elf.RelocList as data_relocs = elf.reloc_init();
    pass2(&lines, &symtab, &text_buf, &data_buf, &rodata_buf, &bss_size, &relocs, &data_relocs);
    if (asm_prof_enabled == 1) { asm_prof_times[3] = asm_prof_time() - t3; }
    print_section_sizes(&text_buf, &data_buf, &rodata_buf, bss_size, &relocs);

    // Write ELF
    let is *u8 as out_name = make_output_name(filename);
    let is i64 as fd = linux.open(out_name, 577, 420);
    if (fd < 0) {
        linux.write(linux.STDERR, "Error: cannot create output\n", 28);
        return 1;
    }
    let is i64 as t4 = asm_prof_time();
    elf.write_elf(fd, &text_buf, &data_buf, &rodata_buf, bss_size, &symtab, &relocs, &data_relocs,
                  csec_buf_ptrs, csec_name_ptrs, csec_name_lens, csec_reloc_ptrs, csec_count);
    linux.close(fd);
    if (asm_prof_enabled == 1) { asm_prof_times[4] = asm_prof_time() - t4; }

    print_str("  output: "); print_str(out_name); print_str("\n");
    if (asm_prof_enabled == 1) { print_profile(); }
    return 0;
}
