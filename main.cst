use "../std/os.cst" as os;
use "../std/io.cst" as io;
use "core/util.cst" as util;
use "lexer/lexer.cst" as lex;
use "encoder/encoder_util.cst" as enc;
use "parser/parsed_line.cst" as pl;
use "parser/parser.cst" as parser;
use "output/passes.cst" as passes;
use "parser/custom_sections.cst" as cs;
use "parser/cstimport.cst" as ci;
use "output/elf.cst" as elf;
use "core/buf.cst" as buf;
use "../src/codegen/target.cst" as tgt;

// === Assembler profiling ===

let is [5]i64 as asm_prof_times with mut;
let is i32 as asm_prof_enabled with mut = 0;

fn asm_prof_time() as i64 {
    // clock_gettime(CLOCK_MONOTONIC) — Linux-only profiling timer. Gated on the
    // target so the raw syscall is dead-stripped on Windows/CausticOS builds
    // (os.current() folds to a literal; the wrong-target branch never reaches
    // codegen). Profiling simply returns 0 off-Linux.
    if (os.current() == os.OS_LINUX) {
        let is [2]i64 as ts;
        syscall(228, 1, &ts);
        return ts[0] * 1000000 + ts[1] / 1000;
    }
    return 0;
}

fn print_profile() as void {
    let is i64 as total = asm_prof_times[0] + asm_prof_times[1] + asm_prof_times[2] + asm_prof_times[3] + asm_prof_times[4];
    util.print_str("=== profile ===\n");
    util.print_str("  tokenize:  "); util.print_int(asm_prof_times[0] / 1000); util.print_str("ms\n");
    util.print_str("  parse:     "); util.print_int(asm_prof_times[1] / 1000); util.print_str("ms\n");
    util.print_str("  pass1:     "); util.print_int(asm_prof_times[2] / 1000); util.print_str("ms\n");
    util.print_str("  pass2:     "); util.print_int(asm_prof_times[3] / 1000); util.print_str("ms\n");
    util.print_str("  write_elf: "); util.print_int(asm_prof_times[4] / 1000); util.print_str("ms\n");
    util.print_str("  total:     "); util.print_int(total / 1000); util.print_str("ms\n");
}

// === Public API for library use ===

fn assemble_file(asm_path as *u8, obj_path as *u8) as i32 {
    let is i64 as file_size = util.read_file_size(asm_path);
    let is *u8 as src = util.read_file(asm_path);
    if (cast(i64, src) == 0) {
        util.print_str("caustic-as: error: cannot read ");
        util.print_str(asm_path);
        util.print_str("\n");
        return 1;
    }
    return assemble_buf(src, file_size, obj_path);
}

// Assemble from an in-memory .s buffer. The in-process compiler pipeline passes
// codegen's assembly output straight here, skipping the round-trip of writing
// the .s and reading it back from disk (the file is still written, as a cache).
fn assemble_buf(src as *u8, file_size as i64, obj_path as *u8) as i32 {
    cs.csec_init();
    ci.cstimport_init();

    let is i64 as t1 = asm_prof_time();
    let is i32 as line_hint = cast(i32, file_size / 24) + 1024;
    // Streaming parse: tokenize chunk-by-chunk (bounded token memory) instead of
    // building the whole file's token array up front.
    let is pl.ParsedLines as lines = parser.parse_streaming(src, file_size, line_hint);
    if (asm_prof_enabled == 1) { asm_prof_times[1] = asm_prof_time() - t1; }

    let is i64 as t2 = asm_prof_time();
    let is elf.SymbolTable as symtab = elf.sym_init();
    passes.pass1(&lines, &symtab);
    if (asm_prof_enabled == 1) { asm_prof_times[2] = asm_prof_time() - t2; }

    let is i64 as t3 = asm_prof_time();
    let is buf.ByteBuffer as text_buf = buf.buf_init(65536);
    let is buf.ByteBuffer as data_buf = buf.buf_init(4096);
    let is buf.ByteBuffer as rodata_buf = buf.buf_init(4096);
    let is i64 as bss_size with mut = 0;
    let is elf.RelocList as relocs = elf.reloc_init();
    let is elf.RelocList as data_relocs = elf.reloc_init();
    passes.pass2(&lines, &symtab, &text_buf, &data_buf, &rodata_buf, &bss_size, &relocs, &data_relocs);
    if (asm_prof_enabled == 1) { asm_prof_times[3] = asm_prof_time() - t3; }
    pl.pl_free(&lines);   // lines consumed by pass1/pass2; output is in the buffers now

    // If any .cstimport directives were encountered, serialize them into a
    // custom ELF section ".cstimport" so the linker can read them when
    // building the PE import table.
    ci.cstimport_emit_section();

    let is i64 as t4 = asm_prof_time();
    let is i64 as fd = io._open_write(obj_path);
    if (fd < 0) {
        util.print_str("caustic-as: error: cannot create ");
        util.print_str(obj_path);
        util.print_str("\n");
        return 1;
    }
    elf.write_elf(fd, &text_buf, &data_buf, &rodata_buf, bss_size, &symtab, &relocs, &data_relocs,
                  cs.csec_buf_ptrs, cs.csec_name_ptrs, cs.csec_name_lens, cs.csec_reloc_ptrs, cs.csec_count);
    io._close_fd(fd);
    if (asm_prof_enabled == 1) { asm_prof_times[4] = asm_prof_time() - t4; }
    return 0;
}

// === Main ===

fn print_token_profile() as void {
    util.print_str("  tok: spaces="); util.print_int(lex.tok_prof_counts[0]);
    util.print_str(" nl="); util.print_int(lex.tok_prof_counts[1]);
    util.print_str(" comment="); util.print_int(lex.tok_prof_counts[2]);
    util.print_str(" punct="); util.print_int(lex.tok_prof_counts[3]);
    util.print_str(" num="); util.print_int(lex.tok_prof_counts[4]);
    util.print_str(" dot="); util.print_int(lex.tok_prof_counts[5]);
    util.print_str(" id_short="); util.print_int(lex.tok_prof_counts[6]);
    util.print_str(" id_long="); util.print_int(lex.tok_prof_counts[7]);
    util.print_str("\n");
}

fn print_section_sizes(text_buf as *buf.ByteBuffer, data_buf as *buf.ByteBuffer,
                       rodata_buf as *buf.ByteBuffer, bss_size as i64, relocs as *elf.RelocList) as void {
    util.print_str("  .text: "); util.print_int(text_buf.len); util.print_str(" bytes\n");
    util.print_str("  .data: "); util.print_int(data_buf.len); util.print_str(" bytes\n");
    util.print_str("  .rodata: "); util.print_int(rodata_buf.len); util.print_str(" bytes\n");
    util.print_str("  .bss: "); util.print_int(bss_size); util.print_str(" bytes\n");
    util.print_str("  relocations: "); util.print_int(cast(i64, relocs.count)); util.print_str("\n");
}

fn main(argc as i64, argv as i64) as i32 {
    cs.csec_init();
    ci.cstimport_init();
    if (argc < 2) {
        io._write_fd(io.STDERR, "Usage: caustic-as <input.s>\n", 28);
        return 1;
    }

    let is *i64 as argv_arr = cast(*i64, argv);
    let is *u8 as filename with mut = cast(*u8, argv_arr[1]);

    tgt.target_init();

    // Check for --profile, --target= flags
    let is i32 as ai with mut = 1;
    while (ai < argc) {
        let is *u8 as arg = cast(*u8, argv_arr[ai]);
        let is i32 as alen with mut = 0;
        while (arg[alen] != cast(u8, 0)) { alen = alen + 1; }
        if (enc.streq(arg, 9, "--profile", 9) == 1) {
            asm_prof_enabled = 1;
        } else if (alen > 9 && arg[0] == 45 && arg[1] == 45 && arg[2] == 116 && arg[3] == 97 && arg[4] == 114 && arg[5] == 103 && arg[6] == 101 && arg[7] == 116 && arg[8] == 61) {
            // --target=<triple>
            let is *u8 as triple = cast(*u8, cast(i64, arg) + 9);
            let is i32 as tlen = alen - 9;
            let is i32 as ok = tgt.load_target(triple, tlen);
            if (ok == 0) {
                io._write_fd(io.STDERR, "caustic-as: unknown --target\n", 29);
                return 1;
            }
            if (tgt.str_eq_local(triple, tlen, "windows-x86_64", 14) == 1) {
                io._write_fd(io.STDERR, "caustic-as: windows-x86_64 not yet implemented\n", 47);
                return 1;
            }
        } else {
            filename = arg;
        }
        ai = ai + 1;
    }

    let is i64 as file_size = util.read_file_size(filename);
    let is *u8 as src = util.read_file(filename);
    if (cast(i64, src) == 0) {
        io._write_fd(io.STDERR, "Error: cannot read file\n", 24);
        return 1;
    }

    util.print_str("caustic-as: assembling ");
    util.print_str(filename);
    util.print_str(" ("); util.print_int(file_size); util.print_str(" bytes)\n");

    // Parse (streaming: tokenize chunk-by-chunk, bounded token memory)
    let is i64 as t1 = asm_prof_time();
    let is i32 as line_hint = cast(i32, file_size / 24) + 1024;
    let is pl.ParsedLines as lines = parser.parse_streaming(src, file_size, line_hint);
    if (asm_prof_enabled == 1) { asm_prof_times[1] = asm_prof_time() - t1; }
    util.print_str("  lines: "); util.print_int(cast(i64, lines.count)); util.print_str("\n");

    // Pass 1
    let is i64 as t2 = asm_prof_time();
    let is elf.SymbolTable as symtab = elf.sym_init();
    passes.pass1(&lines, &symtab);
    if (asm_prof_enabled == 1) { asm_prof_times[2] = asm_prof_time() - t2; }
    util.print_str("  symbols: "); util.print_int(cast(i64, symtab.count)); util.print_str("\n");

    // Pass 2
    let is i64 as t3 = asm_prof_time();
    let is buf.ByteBuffer as text_buf = buf.buf_init(65536);
    let is buf.ByteBuffer as data_buf = buf.buf_init(4096);
    let is buf.ByteBuffer as rodata_buf = buf.buf_init(4096);
    let is i64 as bss_size with mut = 0;
    let is elf.RelocList as relocs = elf.reloc_init();
    let is elf.RelocList as data_relocs = elf.reloc_init();
    passes.pass2(&lines, &symtab, &text_buf, &data_buf, &rodata_buf, &bss_size, &relocs, &data_relocs);
    if (asm_prof_enabled == 1) { asm_prof_times[3] = asm_prof_time() - t3; }
    pl.pl_free(&lines);   // lines consumed by pass1/pass2; output is in the buffers now
    print_section_sizes(&text_buf, &data_buf, &rodata_buf, bss_size, &relocs);

    // Serialize .cstimport entries (if any) before writing ELF.
    ci.cstimport_emit_section();

    // Write ELF
    let is *u8 as out_name = util.make_output_name(filename);
    let is i64 as fd = io._open_write(out_name);
    if (fd < 0) {
        io._write_fd(io.STDERR, "Error: cannot create output\n", 28);
        return 1;
    }
    let is i64 as t4 = asm_prof_time();
    elf.write_elf(fd, &text_buf, &data_buf, &rodata_buf, bss_size, &symtab, &relocs, &data_relocs,
                  cs.csec_buf_ptrs, cs.csec_name_ptrs, cs.csec_name_lens, cs.csec_reloc_ptrs, cs.csec_count);
    io._close_fd(fd);
    if (asm_prof_enabled == 1) { asm_prof_times[4] = asm_prof_time() - t4; }

    util.print_str("  output: "); util.print_str(out_name); util.print_str("\n");
    if (asm_prof_enabled == 1) { print_profile(); }
    return 0;
}
