use "../std/mem.cst" as mem;
use "../std/linux.cst" as linux;
use "asm_defs.cst" as def;
use "buf.cst" as buf;

// === Register helpers ===
use "encoder_util.cst" as eu;

fn encode(b as *buf.ByteBuffer, inst as i32, op1 as *def.Operand, op2 as *def.Operand, resolve_label as i64, cur_off as i64) as i32 {
    let is i64 as start = b.len;

    // --- No-operand instructions ---
    if (inst == def.INST_RET)     { buf.buf_emit8(b, 195); return 1; }
    if (inst == def.INST_SYSCALL) { buf.buf_emit8(b, 15); buf.buf_emit8(b, 5); return 2; }
    if (inst == def.INST_CLD)     { buf.buf_emit8(b, 252); return 1; }
    if (inst == def.INST_NOP)     { buf.buf_emit8(b, 144); return 1; }
    if (inst == def.INST_CQO)     { buf.buf_emit8(b, eu.make_rex(1,0,0,0)); buf.buf_emit8(b, 153); return 2; }
    if (inst == def.INST_CDQ)     { buf.buf_emit8(b, 153); return 1; }
    if (inst == def.INST_MOVSB)   { buf.buf_emit8(b, 164); return 1; }
    if (inst == def.INST_REP)     { buf.buf_emit8(b, 243); return 1; }

    // INT imm8: CD ib
    if (inst == def.INST_INT && op1.kind == def.OP_IMM) {
        buf.buf_emit8(b, 205);                                  // 0xCD
        buf.buf_emit8(b, cast(i32, op1.imm & 0xFF));
        return 2;
    }

    // --- PUSH/POP reg ---
    if (inst == def.INST_PUSH && op1.kind == def.OP_REG) {
        let is i32 as code = eu.reg_code(op1.reg_id);
        if (eu.reg_ext(op1.reg_id) == 1) {
            buf.buf_emit8(b, eu.make_rex(0,0,0,1));
        }
        buf.buf_emit8(b, 80 + code);
        return cast(i32, b.len - start);
    }
    if (inst == def.INST_POP && op1.kind == def.OP_REG) {
        let is i32 as code = eu.reg_code(op1.reg_id);
        if (eu.reg_ext(op1.reg_id) == 1) {
            buf.buf_emit8(b, eu.make_rex(0,0,0,1));
        }
        buf.buf_emit8(b, 88 + code);
        return cast(i32, b.len - start);
    }

    // --- CALL reg (FF /2) ---
    if (inst == def.INST_CALL && op1.kind == def.OP_REG) {
        let is i32 as r = op1.reg_id % 16;
        if (r >= 8) { buf.buf_emit8(b, 65); }
        buf.buf_emit8(b, 255);
        buf.buf_emit8(b, 208 + (r & 7));
        return 2 + eu.reg_ext(op1.reg_id);
    }

    // --- CALL/JMP/Jcc label ---
    if (inst == def.INST_CALL && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 232);
        let is i64 as rel = resolve_label - (cur_off + 5);
        buf.buf_emit32_le(b, rel);
        return 5;
    }
    // --- JMP reg (FF /4) ---
    if (inst == def.INST_JMP && op1.kind == def.OP_REG) {
        let is i32 as r = op1.reg_id % 16;
        if (r >= 8) { buf.buf_emit8(b, 65); }
        buf.buf_emit8(b, 255);
        buf.buf_emit8(b, 224 + (r & 7));
        return 2 + eu.reg_ext(op1.reg_id);
    }

    if (inst == def.INST_JMP && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 233);
        let is i64 as rel = resolve_label - (cur_off + 5);
        buf.buf_emit32_le(b, rel);
        return 5;
    }
    // Jcc: 0F 8x + rel32
    if (inst >= def.INST_JZ && inst <= def.INST_JBE && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 15);
        let is i32 as cc with mut = 0;
        if (inst == def.INST_JZ || inst == def.INST_JE) { cc = 132; }
        if (inst == def.INST_JNZ || inst == def.INST_JNE) { cc = 133; }
        if (inst == def.INST_JL) { cc = 140; }
        if (inst == def.INST_JLE) { cc = 142; }
        if (inst == def.INST_JG) { cc = 143; }
        if (inst == def.INST_JGE) { cc = 141; }
        if (inst == def.INST_JA) { cc = 135; }
        if (inst == def.INST_JAE) { cc = 131; }
        if (inst == def.INST_JB) { cc = 130; }
        if (inst == def.INST_JBE) { cc = 134; }
        buf.buf_emit8(b, cc);
        let is i64 as rel = resolve_label - (cur_off + 6);
        buf.buf_emit32_le(b, rel);
        return 6;
    }

    // --- SETcc reg8 ---
    if (inst >= def.INST_SETE && inst <= def.INST_SETAE && op1.kind == def.OP_REG) {
        let is i32 as cc with mut = 0;
        if (inst == def.INST_SETE) { cc = 148; }
        if (inst == def.INST_SETNE) { cc = 149; }
        if (inst == def.INST_SETL) { cc = 156; }
        if (inst == def.INST_SETLE) { cc = 158; }
        if (inst == def.INST_SETG) { cc = 159; }
        if (inst == def.INST_SETGE) { cc = 157; }
        if (inst == def.INST_SETB) { cc = 146; }
        if (inst == def.INST_SETBE) { cc = 150; }
        if (inst == def.INST_SETA) { cc = 151; }
        if (inst == def.INST_SETAE) { cc = 147; }
        let is i32 as code = eu.reg_code(op1.reg_id);
        if (eu.reg_ext(op1.reg_id) == 1 || eu.needs_rex_for_8bit(op1.reg_id) == 1) {
            buf.buf_emit8(b, eu.make_rex(0, 0, 0, eu.reg_ext(op1.reg_id)));
        }
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, cc);
        buf.buf_emit8(b, eu.make_modrm(3, 0, code));
        return cast(i32, b.len - start);
    }

    // --- IDIV/DIV/NEG/NOT reg ---
    if ((inst == def.INST_IDIV || inst == def.INST_DIV || inst == def.INST_NEG || inst == def.INST_NOT) && op1.kind == def.OP_REG) {
        let is i32 as sz = eu.reg_size(op1.reg_id);
        let is i32 as code = eu.reg_code(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        buf.buf_emit8(b, eu.make_rex(w, 0, 0, eu.reg_ext(op1.reg_id)));
        buf.buf_emit8(b, 247);
        let is i32 as ext with mut = 7;
        if (inst == def.INST_DIV) { ext = 6; }
        if (inst == def.INST_NEG) { ext = 3; }
        if (inst == def.INST_NOT) { ext = 2; }
        buf.buf_emit8(b, eu.make_modrm(3, ext, code));
        return cast(i32, b.len - start);
    }

    // --- MOV ---
    if (inst == def.INST_MOV) {
        // MOV reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            let is i32 as src_code = eu.reg_code(op2.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (eu.reg_ext(op2.reg_id) == 1 || eu.reg_ext(op1.reg_id) == 1) { need_rex = 1; }
            if (sz == 8 && (eu.needs_rex_for_8bit(op1.reg_id) == 1 || eu.needs_rex_for_8bit(op2.reg_id) == 1)) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op2.reg_id), 0, eu.reg_ext(op1.reg_id)));
            }
            if (sz == 8) { buf.buf_emit8(b, 136); }
            else { buf.buf_emit8(b, 137); }
            buf.buf_emit8(b, eu.make_modrm(3, src_code, dst_code));
            return cast(i32, b.len - start);
        }

        // MOV reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as code = eu.reg_code(op1.reg_id);
            if (sz == 64) {
                if (eu.imm_is32(op2.imm) == 1) {
                    buf.buf_emit8(b, eu.make_rex(1, 0, 0, eu.reg_ext(op1.reg_id)));
                    buf.buf_emit8(b, 199);
                    buf.buf_emit8(b, eu.make_modrm(3, 0, code));
                    buf.buf_emit32_le(b, op2.imm);
                } else {
                    buf.buf_emit8(b, eu.make_rex(1, 0, 0, eu.reg_ext(op1.reg_id)));
                    buf.buf_emit8(b, 184 + code);
                    buf.buf_emit64_le(b, op2.imm);
                }
            } else if (sz == 32) {
                if (eu.reg_ext(op1.reg_id) == 1) {
                    buf.buf_emit8(b, eu.make_rex(0, 0, 0, 1));
                }
                buf.buf_emit8(b, 184 + code);
                buf.buf_emit32_le(b, op2.imm);
            } else if (sz == 16) {
                buf.buf_emit8(b, 102);
                if (eu.reg_ext(op1.reg_id) == 1) {
                    buf.buf_emit8(b, eu.make_rex(0, 0, 0, 1));
                }
                buf.buf_emit8(b, 184 + code);
                buf.buf_emit16_le(b, cast(i32, op2.imm));
            } else {
                if (eu.reg_ext(op1.reg_id) == 1 || eu.needs_rex_for_8bit(op1.reg_id) == 1) {
                    buf.buf_emit8(b, eu.make_rex(0, 0, 0, eu.reg_ext(op1.reg_id)));
                }
                buf.buf_emit8(b, 176 + code);
                buf.buf_emit8(b, cast(i32, op2.imm));
            }
            return cast(i32, b.len - start);
        }

        // MOV [mem], reg  (store)
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_REG) {
            let is i32 as sz with mut = eu.reg_size(op2.reg_id);
            let is i32 as src_code = eu.reg_code(op2.reg_id);
            if (op1.mem_size > 0 && op1.mem_size < sz) {
                sz = op1.mem_size;
            }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (eu.reg_ext(op2.reg_id) == 1 || eu.reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (eu.has_sib(op1) == 1 && eu.reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && eu.needs_rex_for_8bit(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (eu.has_sib(op1) == 1) { rex_x = eu.reg_ext(op1.mem_index); }
                buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op2.reg_id), rex_x, eu.reg_ext(op1.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 136); }
            else { buf.buf_emit8(b, 137); }
            if (eu.has_sib(op1) == 1) {
                eu.emit_mem_modrm_sib(b, src_code, op1.mem_base, op1.mem_index, op1.mem_scale, op1.mem_disp);
            } else {
                eu.emit_mem_modrm(b, src_code, op1.mem_base, op1.mem_disp);
            }
            return cast(i32, b.len - start);
        }

        // MOV reg, [mem]  (load)
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.mem_base) == 1) { need_rex = 1; }
            if (eu.has_sib(op2) == 1 && eu.reg_ext(op2.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && eu.needs_rex_for_8bit(op1.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
                buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 138); }
            else { buf.buf_emit8(b, 139); }
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }

        // MOV reg, [rip+label] — RIP-relative load (for GOTPCREL)
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) {
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, 0));
            buf.buf_emit8(b, 139); // 0x8B = MOV r64, r/m64
            // ModR/M: mod=00, reg=dst, r/m=5 (RIP-relative)
            buf.buf_emit8(b, eu.make_modrm(0, dst_code, 5));
            // rel32 placeholder — will be a relocation
            let is i64 as rel = resolve_label - (cur_off + cast(i64, b.len - start) + 4);
            buf.buf_emit32_le(b, rel);
            return cast(i32, b.len - start);
        }

        // MOV [mem], imm
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_IMM) {
            let is i32 as sz with mut = op1.mem_size;
            if (sz == 0) { sz = 64; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (eu.reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (eu.has_sib(op1) == 1 && eu.reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (eu.has_sib(op1) == 1) { rex_x = eu.reg_ext(op1.mem_index); }
                buf.buf_emit8(b, eu.make_rex(w, 0, rex_x, eu.reg_ext(op1.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 198); }
            else { buf.buf_emit8(b, 199); }
            if (eu.has_sib(op1) == 1) {
                eu.emit_mem_modrm_sib(b, 0, op1.mem_base, op1.mem_index, op1.mem_scale, op1.mem_disp);
            } else {
                eu.emit_mem_modrm(b, 0, op1.mem_base, op1.mem_disp);
            }
            if (sz == 8) { buf.buf_emit8(b, cast(i32, op2.imm)); }
            else if (sz == 16) { buf.buf_emit16_le(b, cast(i32, op2.imm)); }
            else { buf.buf_emit32_le(b, op2.imm); }
            return cast(i32, b.len - start);
        }
    }

    // --- LEA reg, [mem] ---
    if (inst == def.INST_LEA) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            let is i32 as rex_x with mut = 0;
            if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 141);
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }
        // LEA reg, [rip+label] — RIP-relative
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) {
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, 0));
            buf.buf_emit8(b, 141);
            // ModR/M: mod=00, reg=dst, r/m=5 (RIP-relative)
            buf.buf_emit8(b, eu.make_modrm(0, dst_code, 5));
            // rel32 placeholder — will be a relocation
            let is i64 as rel = resolve_label - (cur_off + cast(i64, b.len - start) + 4);
            buf.buf_emit32_le(b, rel);
            return cast(i32, b.len - start);
        }
    }

    // --- ADD/SUB/AND/OR/XOR/CMP reg, reg ---
    if (inst == def.INST_ADD || inst == def.INST_SUB || inst == def.INST_AND || inst == def.INST_OR || inst == def.INST_XOR || inst == def.INST_CMP) {
        let is i32 as opcode with mut = 0;
        let is i32 as imm_ext with mut = 0;
        if (inst == def.INST_ADD) { opcode = 1; imm_ext = 0; }
        if (inst == def.INST_SUB) { opcode = 41; imm_ext = 5; }
        if (inst == def.INST_AND) { opcode = 33; imm_ext = 4; }
        if (inst == def.INST_OR)  { opcode = 9; imm_ext = 1; }
        if (inst == def.INST_XOR) { opcode = 49; imm_ext = 6; }
        if (inst == def.INST_CMP) { opcode = 57; imm_ext = 7; }

        // reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            let is i32 as src_code = eu.reg_code(op2.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op2.reg_id), 0, eu.reg_ext(op1.reg_id)));
            }
            if (sz == 8) { buf.buf_emit8(b, opcode - 1); }
            else { buf.buf_emit8(b, opcode); }
            buf.buf_emit8(b, eu.make_modrm(3, src_code, dst_code));
            return cast(i32, b.len - start);
        }

        // reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as code = eu.reg_code(op1.reg_id);
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            if (w == 1 || eu.reg_ext(op1.reg_id) == 1) {
                buf.buf_emit8(b, eu.make_rex(w, 0, 0, eu.reg_ext(op1.reg_id)));
            }
            if (eu.imm_is8(op2.imm) == 1 && sz != 8) {
                buf.buf_emit8(b, 131);
                buf.buf_emit8(b, eu.make_modrm(3, imm_ext, code));
                buf.buf_emit8(b, cast(i32, op2.imm));
            } else {
                if (sz == 8) {
                    buf.buf_emit8(b, 128);
                    buf.buf_emit8(b, eu.make_modrm(3, imm_ext, code));
                    buf.buf_emit8(b, cast(i32, op2.imm));
                } else {
                    buf.buf_emit8(b, 129);
                    buf.buf_emit8(b, eu.make_modrm(3, imm_ext, code));
                    if (sz == 16) { buf.buf_emit16_le(b, cast(i32, op2.imm)); }
                    else { buf.buf_emit32_le(b, op2.imm); }
                }
            }
            return cast(i32, b.len - start);
        }

        // reg, [mem]
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = eu.reg_size(op1.reg_id);
            let is i32 as dst_code = eu.reg_code(op1.reg_id);
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as rex_x with mut = 0;
            if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
            buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            buf.buf_emit8(b, opcode + 2);
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }
    }

    // --- TEST reg, reg ---
    if (inst == def.INST_TEST && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as sz = eu.reg_size(op1.reg_id);
        let is i32 as dst_code = eu.reg_code(op1.reg_id);
        let is i32 as src_code = eu.reg_code(op2.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        if (sz == 16) { buf.buf_emit8(b, 102); }
        let is i32 as need_rex with mut = 0;
        if (w == 1) { need_rex = 1; }
        if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op2.reg_id), 0, eu.reg_ext(op1.reg_id)));
        }
        if (sz == 8) { buf.buf_emit8(b, 132); }
        else { buf.buf_emit8(b, 133); }
        buf.buf_emit8(b, eu.make_modrm(3, src_code, dst_code));
        return cast(i32, b.len - start);
    }

    // --- IMUL reg, reg ---
    if (inst == def.INST_IMUL && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as sz = eu.reg_size(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, 175);
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- SHL/SHR/SAR reg, cl ---
    if ((inst == def.INST_SHL || inst == def.INST_SHR || inst == def.INST_SAR) && op1.kind == def.OP_REG) {
        let is i32 as sz = eu.reg_size(op1.reg_id);
        let is i32 as code = eu.reg_code(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        let is i32 as ext with mut = 4;
        if (inst == def.INST_SHR) { ext = 5; }
        if (inst == def.INST_SAR) { ext = 7; }

        buf.buf_emit8(b, eu.make_rex(w, 0, 0, eu.reg_ext(op1.reg_id)));
        if (op2.kind == def.OP_REG) {
            // shift by CL
            buf.buf_emit8(b, 211);
            buf.buf_emit8(b, eu.make_modrm(3, ext, code));
        } else if (op2.kind == def.OP_IMM) {
            if (op2.imm == 1) {
                buf.buf_emit8(b, 209);
                buf.buf_emit8(b, eu.make_modrm(3, ext, code));
            } else {
                buf.buf_emit8(b, 193);
                buf.buf_emit8(b, eu.make_modrm(3, ext, code));
                buf.buf_emit8(b, cast(i32, op2.imm));
            }
        }
        return cast(i32, b.len - start);
    }

    // --- MOVSXD reg, [mem] or reg ---
    if (inst == def.INST_MOVSXD) {
        let is i32 as dst_code = eu.reg_code(op1.reg_id);
        buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, 0));
        if (op2.kind == def.OP_MEM) {
            let is i64 as rex_pos = b.len - 1;
            let is i32 as rex_x with mut = 0;
            if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
            b.data[rex_pos] = cast(u8, eu.make_rex(1, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 99);
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        } else if (op2.kind == def.OP_REG) {
            b.data[b.len - 1] = cast(u8, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 99);
            buf.buf_emit8(b, eu.make_modrm(3, dst_code, eu.reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVSX reg, [mem] or reg (byte/word) ---
    if (inst == def.INST_MOVSX) {
        let is i32 as dst_code = eu.reg_code(op1.reg_id);
        if (op2.kind == def.OP_MEM) {
            let is i32 as w = 1;
            let is i32 as rex_x with mut = 0;
            if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
            buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 15);
            if (op2.mem_size == 8) { buf.buf_emit8(b, 190); }
            else { buf.buf_emit8(b, 191); }
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        }
        else if (op2.kind == def.OP_REG) {
            let is i32 as src_sz = eu.reg_size(op2.reg_id);
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            if (src_sz == 8) { buf.buf_emit8(b, 190); }
            else { buf.buf_emit8(b, 191); }
            buf.buf_emit8(b, eu.make_modrm(3, dst_code, eu.reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVZX reg, [mem] or reg (byte/word) ---
    if (inst == def.INST_MOVZX) {
        let is i32 as dst_code = eu.reg_code(op1.reg_id);
        if (op2.kind == def.OP_MEM) {
            let is i32 as w with mut = 0;
            if (eu.reg_size(op1.reg_id) == 64) { w = 1; }
            let is i32 as rex_x with mut = 0;
            if (eu.has_sib(op2) == 1) { rex_x = eu.reg_ext(op2.mem_index); }
            buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), rex_x, eu.reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 15);
            if (op2.mem_size == 8) { buf.buf_emit8(b, 182); }
            else { buf.buf_emit8(b, 183); }
            if (eu.has_sib(op2) == 1) {
                eu.emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                eu.emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        }
        else if (op2.kind == def.OP_REG) {
            let is i32 as src_sz = eu.reg_size(op2.reg_id);
            let is i32 as w with mut = 0;
            if (eu.reg_size(op1.reg_id) == 64) { w = 1; }
            buf.buf_emit8(b, eu.make_rex(w, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            if (src_sz == 8) { buf.buf_emit8(b, 182); }
            else { buf.buf_emit8(b, 183); }
            buf.buf_emit8(b, eu.make_modrm(3, dst_code, eu.reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVQ (SSE) ---
    if (inst == def.INST_MOVQ) {
        if (op1.kind == def.OP_REG && eu.reg_size(op1.reg_id) == 128 && op2.kind == def.OP_REG) {
            // movq xmm, r64: 66 REX.W 0F 6E
            buf.buf_emit8(b, 102);
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            buf.buf_emit8(b, 110);
            buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG && eu.reg_size(op2.reg_id) == 128) {
            // movq r64, xmm: 66 REX.W 0F 7E
            buf.buf_emit8(b, 102);
            buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op2.reg_id), 0, eu.reg_ext(op1.reg_id)));
            buf.buf_emit8(b, 15);
            buf.buf_emit8(b, 126);
            buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op2.reg_id), eu.reg_code(op1.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // --- SSE arithmetic: addsd/subsd/mulsd/divsd ---
    if (inst == def.INST_ADDSD || inst == def.INST_SUBSD || inst == def.INST_MULSD || inst == def.INST_DIVSD) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            buf.buf_emit8(b, 242); // F2 prefix
            let is i32 as need_rex with mut = 0;
            if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            }
            buf.buf_emit8(b, 15);
            if (inst == def.INST_ADDSD) { buf.buf_emit8(b, 88); }
            if (inst == def.INST_SUBSD) { buf.buf_emit8(b, 92); }
            if (inst == def.INST_MULSD) { buf.buf_emit8(b, 89); }
            if (inst == def.INST_DIVSD) { buf.buf_emit8(b, 94); }
            buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // --- XORPD xmm, xmm ---
    if (inst == def.INST_XORPD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        buf.buf_emit8(b, 102); // 66 prefix
        let is i32 as need_rex with mut = 0;
        if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, 87);
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTTSD2SI r64, xmm ---
    if (inst == def.INST_CVTTSD2SI && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 REX.W 0F 2C /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 44);  // 2C
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSI2SD xmm, r64 ---
    if (inst == def.INST_CVTSI2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 REX.W 0F 2A /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        buf.buf_emit8(b, eu.make_rex(1, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 42);  // 2A
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSD2SS xmm, xmm ---
    if (inst == def.INST_CVTSD2SS && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 0F 5A /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        let is i32 as need_rex with mut = 0;
        if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 90);  // 5A
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSS2SD xmm, xmm ---
    if (inst == def.INST_CVTSS2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F3 0F 5A /r (mod=11)
        buf.buf_emit8(b, 243); // F3
        let is i32 as need_rex with mut = 0;
        if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 90);  // 5A
        buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- MOVD xmm, r32 / MOVD r32, xmm ---
    if (inst == def.INST_MOVD) {
        if (op1.kind == def.OP_REG && eu.reg_size(op1.reg_id) == 128 && op2.kind == def.OP_REG) {
            // movd xmm, r32: 66 [REX] 0F 6E /r
            buf.buf_emit8(b, 102); // 66
            let is i32 as need_rex with mut = 0;
            if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op1.reg_id), 0, eu.reg_ext(op2.reg_id)));
            }
            buf.buf_emit8(b, 15);  // 0F
            buf.buf_emit8(b, 110); // 6E
            buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op1.reg_id), eu.reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG && eu.reg_size(op2.reg_id) == 128) {
            // movd r32, xmm: 66 [REX] 0F 7E /r
            buf.buf_emit8(b, 102); // 66
            let is i32 as need_rex with mut = 0;
            if (eu.reg_ext(op1.reg_id) == 1 || eu.reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, eu.make_rex(0, eu.reg_ext(op2.reg_id), 0, eu.reg_ext(op1.reg_id)));
            }
            buf.buf_emit8(b, 15);  // 0F
            buf.buf_emit8(b, 126); // 7E
            buf.buf_emit8(b, eu.make_modrm(3, eu.reg_code(op2.reg_id), eu.reg_code(op1.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // Unknown instruction
    linux.write(linux.STDERR, "ERR: unknown encoding\n", 22);
    return 0;
}

// Fast instruction size calculation — no byte emission, just arithmetic.
