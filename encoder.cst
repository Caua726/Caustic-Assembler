use "../std/mem.cst" as mem;
use "../std/io.cst" as io;
use "../std/os.cst" as os;
use "asm_defs.cst" as def;
use "buf.cst" as buf;

// === Register helpers ===

fn reg_code(id as i32) as i32 {
    if (id >= 64) { return (id - 64) % 8; }
    return id % 8;
}

fn reg_ext(id as i32) as i32 {
    if (id < 0 || id >= 128) { return 0; }
    if (id >= 64) {
        if ((id - 64) >= 8) { return 1; }
        return 0;
    }
    if ((id % 16) >= 8) { return 1; }
    return 0;
}

fn reg_size(id as i32) as i32 {
    if (id < 0) { return 0; }
    if (id < 16) { return 64; }
    if (id < 32) { return 32; }
    if (id < 48) { return 16; }
    if (id < 64) { return 8; }
    return 128;
}

fn reg_base(id as i32) as i32 {
    if (id < 0) { return id; }
    if (id >= 64) { return id; }
    return id % 16;
}

fn needs_rex_for_8bit(id as i32) as i32 {
    if (id >= 52 && id <= 55) { return 1; }
    return 0;
}

// === String helpers ===
fn streq(a as *u8, alen as i32, b as *u8, blen as i32) as i32 {
    if (alen != blen) { return 0; }
    let is i32 as i with mut = 0;
    while (i < alen) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn streq_lit(a as *u8, alen as i32, lit as *u8) as i32 {
    let is i32 as i with mut = 0;
    while (lit[i] != 0) {
        if (i >= alen) { return 0; }
        if (a[i] != lit[i]) { return 0; }
        i = i + 1;
    }
    return cast(i32, i == alen);
}

// === Register lookup ===
fn lookup_register(ptr as *u8, len as i32) as i32 {
    let is u8 as c0 = ptr[0];
    let is u8 as c1 = ptr[1];
    if (len == 2) {
        if (c0 == 97) { // a
            if (c1 == 108) { return def.REG_AL; } // al
            if (c1 == 120) { return def.REG_AX; } // ax
        }
        else if (c0 == 99) { if (c1 == 108) { return def.REG_CL; } if (c1 == 120) { return def.REG_CX; } } // cl cx
        else if (c0 == 100) { if (c1 == 108) { return def.REG_DL; } if (c1 == 120) { return def.REG_DX; } if (c1 == 105) { return def.REG_DI; } } // dl dx di
        else if (c0 == 98) { if (c1 == 108) { return def.REG_BL; } if (c1 == 120) { return def.REG_BX; } if (c1 == 112) { return def.REG_BP; } } // bl bx bp
        else if (c0 == 115) { if (c1 == 112) { return def.REG_SP; } if (c1 == 105) { return def.REG_SI; } } // sp si
        else if (c0 == 114) { if (c1 == 56) { return def.REG_R8; } if (c1 == 57) { return def.REG_R9; } } // r8 r9
    }
    else if (len == 3) {
        let is u8 as c2 = ptr[2];
        if (c0 == 114) { // r
            if (c1 == 97 && c2 == 120) { return def.REG_RAX; } // rax
            if (c1 == 99 && c2 == 120) { return def.REG_RCX; } // rcx
            if (c1 == 100 && c2 == 120) { return def.REG_RDX; } // rdx
            if (c1 == 98 && c2 == 120) { return def.REG_RBX; } // rbx
            if (c1 == 115 && c2 == 112) { return def.REG_RSP; } // rsp
            if (c1 == 98 && c2 == 112) { return def.REG_RBP; } // rbp
            if (c1 == 115 && c2 == 105) { return def.REG_RSI; } // rsi
            if (c1 == 100 && c2 == 105) { return def.REG_RDI; } // rdi
            if (c1 == 105 && c2 == 112) { return 99; } // rip
            if (c1 == 49) { // r1x
                if (c2 == 48) { return def.REG_R10; } if (c2 == 49) { return def.REG_R11; }
                if (c2 == 50) { return def.REG_R12; } if (c2 == 51) { return def.REG_R13; }
                if (c2 == 52) { return def.REG_R14; } if (c2 == 53) { return def.REG_R15; }
            }
            if (c1 == 56) { // r8x
                if (c2 == 100) { return def.REG_R8D; } if (c2 == 119) { return def.REG_R8W; } if (c2 == 98) { return def.REG_R8B; }
            }
            if (c1 == 57) { // r9x
                if (c2 == 100) { return def.REG_R9D; } if (c2 == 119) { return def.REG_R9W; } if (c2 == 98) { return def.REG_R9B; }
            }
        }
        else if (c0 == 101) { // e
            if (c1 == 97 && c2 == 120) { return def.REG_EAX; } // eax
            if (c1 == 99 && c2 == 120) { return def.REG_ECX; } // ecx
            if (c1 == 100 && c2 == 120) { return def.REG_EDX; } // edx
            if (c1 == 98 && c2 == 120) { return def.REG_EBX; } // ebx
            if (c1 == 115 && c2 == 112) { return def.REG_ESP; } // esp
            if (c1 == 98 && c2 == 112) { return def.REG_EBP; } // ebp
            if (c1 == 115 && c2 == 105) { return def.REG_ESI; } // esi
            if (c1 == 100 && c2 == 105) { return def.REG_EDI; } // edi
        }
        else if (c0 == 115 && c1 == 112 && c2 == 108) { return def.REG_SPL; } // spl
        else if (c0 == 98 && c1 == 112 && c2 == 108) { return def.REG_BPL; } // bpl
        else if (c0 == 115 && c1 == 105 && c2 == 108) { return def.REG_SIL; } // sil
        else if (c0 == 100 && c1 == 105 && c2 == 108) { return def.REG_DIL; } // dil
    }
    else if (len == 4) {
        if (c0 == 114 && c1 == 49) { // r1Xx — r10d..r15b
            let is u8 as c2 = ptr[2];
            let is u8 as c3 = ptr[3];
            if (c3 == 100) { // d
                if (c2 == 48) { return def.REG_R10D; } if (c2 == 49) { return def.REG_R11D; }
                if (c2 == 50) { return def.REG_R12D; } if (c2 == 51) { return def.REG_R13D; }
                if (c2 == 52) { return def.REG_R14D; } if (c2 == 53) { return def.REG_R15D; }
            }
            else if (c3 == 119) { // w
                if (c2 == 48) { return def.REG_R10W; } if (c2 == 49) { return def.REG_R11W; }
                if (c2 == 50) { return def.REG_R12W; } if (c2 == 51) { return def.REG_R13W; }
                if (c2 == 52) { return def.REG_R14W; } if (c2 == 53) { return def.REG_R15W; }
            }
            else if (c3 == 98) { // b
                if (c2 == 48) { return def.REG_R10B; } if (c2 == 49) { return def.REG_R11B; }
                if (c2 == 50) { return def.REG_R12B; } if (c2 == 51) { return def.REG_R13B; }
                if (c2 == 52) { return def.REG_R14B; } if (c2 == 53) { return def.REG_R15B; }
            }
        }
        else if (c0 == 120 && c1 == 109) { // xmm0..xmm9
            if (ptr[2] == 109) {
                let is u8 as d = ptr[3];
                if (d >= 48 && d <= 57) { return def.REG_XMM0 + cast(i32, d) - 48; }
            }
        }
    }
    else if (len == 5) {
        if (c0 == 120 && c1 == 109 && ptr[2] == 109 && ptr[3] == 49) { // xmm1x
            let is u8 as d = ptr[4];
            if (d >= 48 && d <= 53) { return def.REG_XMM10 + cast(i32, d) - 48; }
        }
    }
    return def.REG_NONE;
}

// === Instruction lookup (byte dispatch, no streq_lit) ===
fn lookup_instruction(ptr as *u8, len as i32) as i32 {
    let is u8 as c0 = ptr[0];
    if (len == 2) {
        if (c0 == 111 && ptr[1] == 114) { return def.INST_OR; } // or
        if (c0 == 106) { // jx
            let is u8 as c1 = ptr[1];
            if (c1 == 122) { return def.INST_JZ; } if (c1 == 101) { return def.INST_JE; }
            if (c1 == 108) { return def.INST_JL; } if (c1 == 103) { return def.INST_JG; }
            if (c1 == 97) { return def.INST_JA; } if (c1 == 98) { return def.INST_JB; }
        }
    }
    else if (len == 3) {
        let is u8 as c1 = ptr[1];
        let is u8 as c2 = ptr[2];
        if (c0 == 109) { // mov
            if (c1 == 111 && c2 == 118) { return def.INST_MOV; }
        }
        else if (c0 == 108 && c1 == 101 && c2 == 97) { return def.INST_LEA; } // lea
        else if (c0 == 97 && c1 == 100 && c2 == 100) { return def.INST_ADD; } // add
        else if (c0 == 115) { // s
            if (c1 == 117 && c2 == 98) { return def.INST_SUB; } // sub
            if (c1 == 104) { if (c2 == 108) { return def.INST_SHL; } if (c2 == 114) { return def.INST_SHR; } } // shl shr
            if (c1 == 97 && c2 == 114) { return def.INST_SAR; } // sar
        }
        else if (c0 == 100 && c1 == 105 && c2 == 118) { return def.INST_DIV; } // div
        else if (c0 == 99) { // c
            if (c1 == 113 && c2 == 111) { return def.INST_CQO; } // cqo
            if (c1 == 100 && c2 == 113) { return def.INST_CDQ; } // cdq
            if (c1 == 109 && c2 == 112) { return def.INST_CMP; } // cmp
            if (c1 == 108 && c2 == 100) { return def.INST_CLD; } // cld
        }
        else if (c0 == 110) { // n
            if (c1 == 101 && c2 == 103) { return def.INST_NEG; } // neg
            if (c1 == 111 && c2 == 116) { return def.INST_NOT; } // not
            if (c1 == 111 && c2 == 112) { return def.INST_NOP; } // nop
        }
        else if (c0 == 97 && c1 == 110 && c2 == 100) { return def.INST_AND; } // and
        else if (c0 == 120 && c1 == 111 && c2 == 114) { return def.INST_XOR; } // xor
        else if (c0 == 114 && c1 == 101) { // re
            if (c2 == 116) { return def.INST_RET; } // ret
            if (c2 == 112) { return def.INST_REP; } // rep
        }
        else if (c0 == 106) { // j
            if (c1 == 109 && c2 == 112) { return def.INST_JMP; } // jmp
            if (c1 == 110) { if (c2 == 122) { return def.INST_JNZ; } if (c2 == 101) { return def.INST_JNE; } } // jnz jne
            if (c1 == 108 && c2 == 101) { return def.INST_JLE; } // jle
            if (c1 == 103 && c2 == 101) { return def.INST_JGE; } // jge
            if (c1 == 97 && c2 == 101) { return def.INST_JAE; } // jae
            if (c1 == 98 && c2 == 101) { return def.INST_JBE; } // jbe
        }
        else if (c0 == 112 && c1 == 111 && c2 == 112) { return def.INST_POP; } // pop
    }
    else if (len == 4) {
        let is u8 as c1 = ptr[1];
        if (c0 == 112 && c1 == 117 && ptr[2] == 115 && ptr[3] == 104) { return def.INST_PUSH; } // push
        if (c0 == 105) { // imul idiv
            if (c1 == 109 && ptr[2] == 117 && ptr[3] == 108) { return def.INST_IMUL; }
            if (c1 == 100 && ptr[2] == 105 && ptr[3] == 118) { return def.INST_IDIV; }
        }
        if (c0 == 116 && c1 == 101 && ptr[2] == 115 && ptr[3] == 116) { return def.INST_TEST; } // test
        if (c0 == 115 && c1 == 101 && ptr[2] == 116) { // setX
            let is u8 as c3 = ptr[3];
            if (c3 == 101) { return def.INST_SETE; } if (c3 == 108) { return def.INST_SETL; }
            if (c3 == 103) { return def.INST_SETG; } if (c3 == 98) { return def.INST_SETB; }
            if (c3 == 97) { return def.INST_SETA; }
        }
        if (c0 == 99 && c1 == 97 && ptr[2] == 108 && ptr[3] == 108) { return def.INST_CALL; } // call
        if (c0 == 109 && c1 == 111 && ptr[2] == 118) { // movq
            if (ptr[3] == 113) { return def.INST_MOVQ; }
        }
    }
    else if (len == 5) {
        let is u8 as c1 = ptr[1];
        if (c0 == 109 && c1 == 111 && ptr[2] == 118) { // movsb movsx movzx
            if (ptr[3] == 115) { if (ptr[4] == 98) { return def.INST_MOVSB; } if (ptr[4] == 120) { return def.INST_MOVSX; } }
            if (ptr[3] == 122 && ptr[4] == 120) { return def.INST_MOVZX; }
        }
        if (c0 == 115 && c1 == 101 && ptr[2] == 116) { // setXX
            let is u8 as c3 = ptr[3]; let is u8 as c4 = ptr[4];
            if (c3 == 110 && c4 == 101) { return def.INST_SETNE; }
            if (c3 == 108 && c4 == 101) { return def.INST_SETLE; }
            if (c3 == 103 && c4 == 101) { return def.INST_SETGE; }
            if (c3 == 98 && c4 == 101) { return def.INST_SETBE; }
            if (c3 == 97 && c4 == 101) { return def.INST_SETAE; }
        }
        if (c0 == 97 && c1 == 100 && ptr[2] == 100 && ptr[3] == 115 && ptr[4] == 100) { return def.INST_ADDSD; } // addsd
        if (c0 == 115 && c1 == 117 && ptr[2] == 98 && ptr[3] == 115 && ptr[4] == 100) { return def.INST_SUBSD; } // subsd
        if (c0 == 109 && c1 == 117 && ptr[2] == 108 && ptr[3] == 115 && ptr[4] == 100) { return def.INST_MULSD; } // mulsd
        if (c0 == 100 && c1 == 105 && ptr[2] == 118 && ptr[3] == 115 && ptr[4] == 100) { return def.INST_DIVSD; } // divsd
        if (c0 == 120 && c1 == 111 && ptr[2] == 114 && ptr[3] == 112 && ptr[4] == 100) { return def.INST_XORPD; } // xorpd
    }
    else if (len == 6 && c0 == 109) { // movsxd
        if (ptr[1] == 111 && ptr[2] == 118 && ptr[3] == 115 && ptr[4] == 120 && ptr[5] == 100) { return def.INST_MOVSXD; }
    }
    else if (len == 7 && c0 == 115) { // syscall
        if (ptr[1] == 121 && ptr[2] == 115 && ptr[3] == 99 && ptr[4] == 97 && ptr[5] == 108 && ptr[6] == 108) { return def.INST_SYSCALL; }
    }
    else if (len == 8 && c0 == 99) { // cvtsi2sd, cvtsd2ss, cvtss2sd
        if (ptr[1] == 118 && ptr[2] == 116 && ptr[3] == 115 && ptr[4] == 105 && ptr[5] == 50 && ptr[6] == 115 && ptr[7] == 100) { return def.INST_CVTSI2SD; }
        if (ptr[1] == 118 && ptr[2] == 116 && ptr[3] == 115 && ptr[4] == 100 && ptr[5] == 50 && ptr[6] == 115 && ptr[7] == 115) { return def.INST_CVTSD2SS; }
        if (ptr[1] == 118 && ptr[2] == 116 && ptr[3] == 115 && ptr[4] == 115 && ptr[5] == 50 && ptr[6] == 115 && ptr[7] == 100) { return def.INST_CVTSS2SD; }
    }
    else if (len == 9 && c0 == 99) { // cvttsd2si
        if (ptr[1] == 118 && ptr[2] == 116 && ptr[3] == 116 && ptr[4] == 115 && ptr[5] == 100 && ptr[6] == 50 && ptr[7] == 115 && ptr[8] == 105) { return def.INST_CVTTSD2SI; }
    }
    return def.INST_NONE;
}

// === Encoding helpers ===
fn make_modrm(m as i32, reg as i32, rm as i32) as i32 {
    return ((m % 4) * 64) + ((reg % 8) * 8) + (rm % 8);
}

fn make_sib(scale as i32, idx as i32, base as i32) as i32 {
    return ((scale % 4) * 64) + ((idx % 8) * 8) + (base % 8);
}

fn make_rex(w as i32, r as i32, x as i32, b as i32) as i32 {
    return 64 + w * 8 + r * 4 + x * 2 + b;
}

fn disp_is8(disp as i64) as i32 {
    if (disp >= (0 - 128) && disp <= 127) { return 1; }
    return 0;
}

fn imm_is8(v as i64) as i32 {
    if (v >= (0 - 128) && v <= 127) { return 1; }
    return 0;
}

fn imm_is32(v as i64) as i32 {
    if (v >= (0 - 2147483648) && v <= 2147483647) { return 1; }
    return 0;
}

// Emit memory operand ModR/M (+ optional SIB + displacement)
fn emit_mem_modrm(b as *buf.ByteBuffer, reg_field as i32, base_id as i32, disp as i64) as void {
    let is i32 as base_code = reg_code(base_id);
    let is i32 as need_sib with mut = 0;
    if (base_code == 4) { need_sib = 1; }

    if (disp == 0 && base_code != 5) {
        // mod=00 [base]
        buf.buf_emit8(b, make_modrm(0, reg_field, base_code));
        if (need_sib == 1) {
            buf.buf_emit8(b, make_sib(0, 4, base_code));
        }
    } else if (disp_is8(disp) == 1) {
        // mod=01 [base+disp8]
        buf.buf_emit8(b, make_modrm(1, reg_field, base_code));
        if (need_sib == 1) {
            buf.buf_emit8(b, make_sib(0, 4, base_code));
        }
        buf.buf_emit8(b, cast(i32, disp));
    } else {
        // mod=10 [base+disp32]
        buf.buf_emit8(b, make_modrm(2, reg_field, base_code));
        if (need_sib == 1) {
            buf.buf_emit8(b, make_sib(0, 4, base_code));
        }
        buf.buf_emit32_le(b, disp);
    }
}

// Calculate memory operand size (ModR/M + SIB + disp)
fn mem_modrm_size(base_id as i32, disp as i64) as i32 {
    let is i32 as base_code = reg_code(base_id);
    let is i32 as sib with mut = 0;
    if (base_code == 4) { sib = 1; }

    if (disp == 0 && base_code != 5) {
        return 1 + sib;
    } else if (disp_is8(disp) == 1) {
        return 2 + sib;
    } else {
        return 5 + sib;
    }
}

// Emit SIB memory operand: [base + index * scale + disp]
fn emit_mem_modrm_sib(b as *buf.ByteBuffer, reg_field as i32, base_id as i32, index_id as i32, scale as i32, disp as i64) as void {
    let is i32 as base_code = reg_code(base_id);
    let is i32 as index_code = reg_code(index_id);
    let is i32 as ss with mut = 0;
    if (scale == 2) { ss = 1; }
    else if (scale == 4) { ss = 2; }
    else if (scale == 8) { ss = 3; }

    if (disp == 0 && base_code != 5) {
        buf.buf_emit8(b, make_modrm(0, reg_field, 4));
        buf.buf_emit8(b, make_sib(ss, index_code, base_code));
    } else if (disp_is8(disp) == 1) {
        buf.buf_emit8(b, make_modrm(1, reg_field, 4));
        buf.buf_emit8(b, make_sib(ss, index_code, base_code));
        buf.buf_emit8(b, cast(i32, disp));
    } else {
        buf.buf_emit8(b, make_modrm(2, reg_field, 4));
        buf.buf_emit8(b, make_sib(ss, index_code, base_code));
        buf.buf_emit32_le(b, disp);
    }
}

fn mem_modrm_sib_size(base_id as i32, disp as i64) as i32 {
    let is i32 as base_code = reg_code(base_id);
    if (disp == 0 && base_code != 5) {
        return 2;
    } else if (disp_is8(disp) == 1) {
        return 3;
    } else {
        return 6;
    }
}

fn has_sib(op as *def.Operand) as i32 {
    if (op.kind == def.OP_MEM && op.mem_index != def.REG_NONE) { return 1; }
    return 0;
}

// === Main encoding function ===
// Returns number of bytes emitted. If buf is null-ptr (pass1), still returns size.
fn encode(b as *buf.ByteBuffer, inst as i32, op1 as *def.Operand, op2 as *def.Operand, resolve_label as i64, cur_off as i64) as i32 {
    let is i64 as start = b.len;

    // --- No-operand instructions ---
    if (inst == def.INST_RET)     { buf.buf_emit8(b, 195); return 1; }
    if (inst == def.INST_SYSCALL) { buf.buf_emit8(b, 15); buf.buf_emit8(b, 5); return 2; }
    if (inst == def.INST_CLD)     { buf.buf_emit8(b, 252); return 1; }
    if (inst == def.INST_NOP)     { buf.buf_emit8(b, 144); return 1; }
    if (inst == def.INST_CQO)     { buf.buf_emit8(b, make_rex(1,0,0,0)); buf.buf_emit8(b, 153); return 2; }
    if (inst == def.INST_CDQ)     { buf.buf_emit8(b, 153); return 1; }
    if (inst == def.INST_MOVSB)   { buf.buf_emit8(b, 164); return 1; }
    if (inst == def.INST_REP)     { buf.buf_emit8(b, 243); return 1; }

    // --- PUSH/POP reg ---
    if (inst == def.INST_PUSH && op1.kind == def.OP_REG) {
        let is i32 as code = reg_code(op1.reg_id);
        if (reg_ext(op1.reg_id) == 1) {
            buf.buf_emit8(b, make_rex(0,0,0,1));
        }
        buf.buf_emit8(b, 80 + code);
        return cast(i32, b.len - start);
    }
    if (inst == def.INST_POP && op1.kind == def.OP_REG) {
        let is i32 as code = reg_code(op1.reg_id);
        if (reg_ext(op1.reg_id) == 1) {
            buf.buf_emit8(b, make_rex(0,0,0,1));
        }
        buf.buf_emit8(b, 88 + code);
        return cast(i32, b.len - start);
    }

    // --- CALL reg (FF /2) ---
    if (inst == def.INST_CALL && op1.kind == def.OP_REG) {
        let is i32 as r = op1.reg_id % 16;
        if (r >= 8) { buf.buf_emit8(b, 65); }
        buf.buf_emit8(b, 255);
        buf.buf_emit8(b, 208 + (r & 7));
        return 2 + reg_ext(op1.reg_id);
    }

    // --- CALL/JMP/Jcc label ---
    if (inst == def.INST_CALL && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 232);
        let is i64 as rel = resolve_label - (cur_off + 5);
        buf.buf_emit32_le(b, rel);
        return 5;
    }
    // --- CALL [rip+label] (FF /5 indirect via RIP-relative memory) ---
    // Used for Windows IAT calls: `call QWORD PTR [rip+__imp_X]`.
    // 6 bytes: FF 15 disp32. Caller emits a REL32 relocation against the
    // label at offset (cur_off + 2) so the loader / linker can patch disp32.
    if (inst == def.INST_CALL && op1.kind == def.OP_RIP_LABEL) {
        buf.buf_emit8(b, 255);   // FF
        buf.buf_emit8(b, 21);    // ModRM 00 010 101 (call indirect via RIP-rel)
        buf.buf_emit32_le(b, 0); // disp32 placeholder — pass2 emits the reloc
        return 6;
    }
    // --- JMP reg (FF /4) ---
    if (inst == def.INST_JMP && op1.kind == def.OP_REG) {
        let is i32 as r = op1.reg_id % 16;
        if (r >= 8) { buf.buf_emit8(b, 65); }
        buf.buf_emit8(b, 255);
        buf.buf_emit8(b, 224 + (r & 7));
        return 2 + reg_ext(op1.reg_id);
    }

    if (inst == def.INST_JMP && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 233);
        let is i64 as rel = resolve_label - (cur_off + 5);
        buf.buf_emit32_le(b, rel);
        return 5;
    }
    // Jcc: 0F 8x + rel32
    if (inst >= def.INST_JZ && inst <= def.INST_JBE && op1.kind == def.OP_LABEL) {
        buf.buf_emit8(b, 15);
        let is i32 as cc with mut = 0;
        if (inst == def.INST_JZ || inst == def.INST_JE) { cc = 132; }
        if (inst == def.INST_JNZ || inst == def.INST_JNE) { cc = 133; }
        if (inst == def.INST_JL) { cc = 140; }
        if (inst == def.INST_JLE) { cc = 142; }
        if (inst == def.INST_JG) { cc = 143; }
        if (inst == def.INST_JGE) { cc = 141; }
        if (inst == def.INST_JA) { cc = 135; }
        if (inst == def.INST_JAE) { cc = 131; }
        if (inst == def.INST_JB) { cc = 130; }
        if (inst == def.INST_JBE) { cc = 134; }
        buf.buf_emit8(b, cc);
        let is i64 as rel = resolve_label - (cur_off + 6);
        buf.buf_emit32_le(b, rel);
        return 6;
    }

    // --- SETcc reg8 ---
    if (inst >= def.INST_SETE && inst <= def.INST_SETAE && op1.kind == def.OP_REG) {
        let is i32 as cc with mut = 0;
        if (inst == def.INST_SETE) { cc = 148; }
        if (inst == def.INST_SETNE) { cc = 149; }
        if (inst == def.INST_SETL) { cc = 156; }
        if (inst == def.INST_SETLE) { cc = 158; }
        if (inst == def.INST_SETG) { cc = 159; }
        if (inst == def.INST_SETGE) { cc = 157; }
        if (inst == def.INST_SETB) { cc = 146; }
        if (inst == def.INST_SETBE) { cc = 150; }
        if (inst == def.INST_SETA) { cc = 151; }
        if (inst == def.INST_SETAE) { cc = 147; }
        let is i32 as code = reg_code(op1.reg_id);
        if (reg_ext(op1.reg_id) == 1 || needs_rex_for_8bit(op1.reg_id) == 1) {
            buf.buf_emit8(b, make_rex(0, 0, 0, reg_ext(op1.reg_id)));
        }
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, cc);
        buf.buf_emit8(b, make_modrm(3, 0, code));
        return cast(i32, b.len - start);
    }

    // --- IDIV/DIV/NEG/NOT reg ---
    if ((inst == def.INST_IDIV || inst == def.INST_DIV || inst == def.INST_NEG || inst == def.INST_NOT) && op1.kind == def.OP_REG) {
        let is i32 as sz = reg_size(op1.reg_id);
        let is i32 as code = reg_code(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        buf.buf_emit8(b, make_rex(w, 0, 0, reg_ext(op1.reg_id)));
        buf.buf_emit8(b, 247);
        let is i32 as ext with mut = 7;
        if (inst == def.INST_DIV) { ext = 6; }
        if (inst == def.INST_NEG) { ext = 3; }
        if (inst == def.INST_NOT) { ext = 2; }
        buf.buf_emit8(b, make_modrm(3, ext, code));
        return cast(i32, b.len - start);
    }

    // --- MOV ---
    if (inst == def.INST_MOV) {
        // MOV reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as dst_code = reg_code(op1.reg_id);
            let is i32 as src_code = reg_code(op2.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (reg_ext(op2.reg_id) == 1 || reg_ext(op1.reg_id) == 1) { need_rex = 1; }
            if (sz == 8 && (needs_rex_for_8bit(op1.reg_id) == 1 || needs_rex_for_8bit(op2.reg_id) == 1)) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, make_rex(w, reg_ext(op2.reg_id), 0, reg_ext(op1.reg_id)));
            }
            if (sz == 8) { buf.buf_emit8(b, 136); }
            else { buf.buf_emit8(b, 137); }
            buf.buf_emit8(b, make_modrm(3, src_code, dst_code));
            return cast(i32, b.len - start);
        }

        // MOV reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as code = reg_code(op1.reg_id);
            if (sz == 64) {
                if (imm_is32(op2.imm) == 1) {
                    buf.buf_emit8(b, make_rex(1, 0, 0, reg_ext(op1.reg_id)));
                    buf.buf_emit8(b, 199);
                    buf.buf_emit8(b, make_modrm(3, 0, code));
                    buf.buf_emit32_le(b, op2.imm);
                } else {
                    buf.buf_emit8(b, make_rex(1, 0, 0, reg_ext(op1.reg_id)));
                    buf.buf_emit8(b, 184 + code);
                    buf.buf_emit64_le(b, op2.imm);
                }
            } else if (sz == 32) {
                if (reg_ext(op1.reg_id) == 1) {
                    buf.buf_emit8(b, make_rex(0, 0, 0, 1));
                }
                buf.buf_emit8(b, 184 + code);
                buf.buf_emit32_le(b, op2.imm);
            } else if (sz == 16) {
                buf.buf_emit8(b, 102);
                if (reg_ext(op1.reg_id) == 1) {
                    buf.buf_emit8(b, make_rex(0, 0, 0, 1));
                }
                buf.buf_emit8(b, 184 + code);
                buf.buf_emit16_le(b, cast(i32, op2.imm));
            } else {
                if (reg_ext(op1.reg_id) == 1 || needs_rex_for_8bit(op1.reg_id) == 1) {
                    buf.buf_emit8(b, make_rex(0, 0, 0, reg_ext(op1.reg_id)));
                }
                buf.buf_emit8(b, 176 + code);
                buf.buf_emit8(b, cast(i32, op2.imm));
            }
            return cast(i32, b.len - start);
        }

        // MOV [mem], reg  (store)
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_REG) {
            let is i32 as sz with mut = reg_size(op2.reg_id);
            let is i32 as src_code = reg_code(op2.reg_id);
            if (op1.mem_size > 0 && op1.mem_size < sz) {
                sz = op1.mem_size;
            }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (reg_ext(op2.reg_id) == 1 || reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op1) == 1 && reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && needs_rex_for_8bit(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (has_sib(op1) == 1) { rex_x = reg_ext(op1.mem_index); }
                buf.buf_emit8(b, make_rex(w, reg_ext(op2.reg_id), rex_x, reg_ext(op1.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 136); }
            else { buf.buf_emit8(b, 137); }
            if (has_sib(op1) == 1) {
                emit_mem_modrm_sib(b, src_code, op1.mem_base, op1.mem_index, op1.mem_scale, op1.mem_disp);
            } else {
                emit_mem_modrm(b, src_code, op1.mem_base, op1.mem_disp);
            }
            return cast(i32, b.len - start);
        }

        // MOV reg, [mem]  (load)
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as dst_code = reg_code(op1.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op2) == 1 && reg_ext(op2.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && needs_rex_for_8bit(op1.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
                buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 138); }
            else { buf.buf_emit8(b, 139); }
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }

        // MOV reg, [rip+label] — RIP-relative load (for GOTPCREL)
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) {
            let is i32 as dst_code = reg_code(op1.reg_id);
            buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, 0));
            buf.buf_emit8(b, 139); // 0x8B = MOV r64, r/m64
            // ModR/M: mod=00, reg=dst, r/m=5 (RIP-relative)
            buf.buf_emit8(b, make_modrm(0, dst_code, 5));
            // rel32 placeholder — will be a relocation
            let is i64 as rel = resolve_label - (cur_off + cast(i64, b.len - start) + 4);
            buf.buf_emit32_le(b, rel);
            return cast(i32, b.len - start);
        }

        // MOV [mem], imm
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_IMM) {
            let is i32 as sz with mut = op1.mem_size;
            if (sz == 0) { sz = 64; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op1) == 1 && reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                let is i32 as rex_x with mut = 0;
                if (has_sib(op1) == 1) { rex_x = reg_ext(op1.mem_index); }
                buf.buf_emit8(b, make_rex(w, 0, rex_x, reg_ext(op1.mem_base)));
            }
            if (sz == 8) { buf.buf_emit8(b, 198); }
            else { buf.buf_emit8(b, 199); }
            if (has_sib(op1) == 1) {
                emit_mem_modrm_sib(b, 0, op1.mem_base, op1.mem_index, op1.mem_scale, op1.mem_disp);
            } else {
                emit_mem_modrm(b, 0, op1.mem_base, op1.mem_disp);
            }
            if (sz == 8) { buf.buf_emit8(b, cast(i32, op2.imm)); }
            else if (sz == 16) { buf.buf_emit16_le(b, cast(i32, op2.imm)); }
            else { buf.buf_emit32_le(b, op2.imm); }
            return cast(i32, b.len - start);
        }
    }

    // --- LEA reg, [mem] ---
    if (inst == def.INST_LEA) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as dst_code = reg_code(op1.reg_id);
            let is i32 as rex_x with mut = 0;
            if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
            buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 141);
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }
        // LEA reg, [rip+label] — RIP-relative
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) {
            let is i32 as dst_code = reg_code(op1.reg_id);
            buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, 0));
            buf.buf_emit8(b, 141);
            // ModR/M: mod=00, reg=dst, r/m=5 (RIP-relative)
            buf.buf_emit8(b, make_modrm(0, dst_code, 5));
            // rel32 placeholder — will be a relocation
            let is i64 as rel = resolve_label - (cur_off + cast(i64, b.len - start) + 4);
            buf.buf_emit32_le(b, rel);
            return cast(i32, b.len - start);
        }
    }

    // --- ADD/SUB/AND/OR/XOR/CMP reg, reg ---
    if (inst == def.INST_ADD || inst == def.INST_SUB || inst == def.INST_AND || inst == def.INST_OR || inst == def.INST_XOR || inst == def.INST_CMP) {
        let is i32 as opcode with mut = 0;
        let is i32 as imm_ext with mut = 0;
        if (inst == def.INST_ADD) { opcode = 1; imm_ext = 0; }
        if (inst == def.INST_SUB) { opcode = 41; imm_ext = 5; }
        if (inst == def.INST_AND) { opcode = 33; imm_ext = 4; }
        if (inst == def.INST_OR)  { opcode = 9; imm_ext = 1; }
        if (inst == def.INST_XOR) { opcode = 49; imm_ext = 6; }
        if (inst == def.INST_CMP) { opcode = 57; imm_ext = 7; }

        // reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as dst_code = reg_code(op1.reg_id);
            let is i32 as src_code = reg_code(op2.reg_id);
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as need_rex with mut = 0;
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; need_rex = 1; }
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, make_rex(w, reg_ext(op2.reg_id), 0, reg_ext(op1.reg_id)));
            }
            if (sz == 8) { buf.buf_emit8(b, opcode - 1); }
            else { buf.buf_emit8(b, opcode); }
            buf.buf_emit8(b, make_modrm(3, src_code, dst_code));
            return cast(i32, b.len - start);
        }

        // reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as code = reg_code(op1.reg_id);
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            if (w == 1 || reg_ext(op1.reg_id) == 1) {
                buf.buf_emit8(b, make_rex(w, 0, 0, reg_ext(op1.reg_id)));
            }
            if (imm_is8(op2.imm) == 1 && sz != 8) {
                buf.buf_emit8(b, 131);
                buf.buf_emit8(b, make_modrm(3, imm_ext, code));
                buf.buf_emit8(b, cast(i32, op2.imm));
            } else {
                if (sz == 8) {
                    buf.buf_emit8(b, 128);
                    buf.buf_emit8(b, make_modrm(3, imm_ext, code));
                    buf.buf_emit8(b, cast(i32, op2.imm));
                } else {
                    buf.buf_emit8(b, 129);
                    buf.buf_emit8(b, make_modrm(3, imm_ext, code));
                    if (sz == 16) { buf.buf_emit16_le(b, cast(i32, op2.imm)); }
                    else { buf.buf_emit32_le(b, op2.imm); }
                }
            }
            return cast(i32, b.len - start);
        }

        // reg, [mem]
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as dst_code = reg_code(op1.reg_id);
            let is i32 as w with mut = 0;
            if (sz == 64) { w = 1; }
            if (sz == 16) { buf.buf_emit8(b, 102); }
            let is i32 as rex_x with mut = 0;
            if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
            buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            buf.buf_emit8(b, opcode + 2);
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
            return cast(i32, b.len - start);
        }
    }

    // --- TEST reg, reg ---
    if (inst == def.INST_TEST && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as sz = reg_size(op1.reg_id);
        let is i32 as dst_code = reg_code(op1.reg_id);
        let is i32 as src_code = reg_code(op2.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        if (sz == 16) { buf.buf_emit8(b, 102); }
        let is i32 as need_rex with mut = 0;
        if (w == 1) { need_rex = 1; }
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, make_rex(w, reg_ext(op2.reg_id), 0, reg_ext(op1.reg_id)));
        }
        if (sz == 8) { buf.buf_emit8(b, 132); }
        else { buf.buf_emit8(b, 133); }
        buf.buf_emit8(b, make_modrm(3, src_code, dst_code));
        return cast(i32, b.len - start);
    }

    // --- IMUL reg, reg ---
    if (inst == def.INST_IMUL && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as sz = reg_size(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, 175);
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- SHL/SHR/SAR reg, cl ---
    if ((inst == def.INST_SHL || inst == def.INST_SHR || inst == def.INST_SAR) && op1.kind == def.OP_REG) {
        let is i32 as sz = reg_size(op1.reg_id);
        let is i32 as code = reg_code(op1.reg_id);
        let is i32 as w with mut = 0;
        if (sz == 64) { w = 1; }
        let is i32 as ext with mut = 4;
        if (inst == def.INST_SHR) { ext = 5; }
        if (inst == def.INST_SAR) { ext = 7; }

        buf.buf_emit8(b, make_rex(w, 0, 0, reg_ext(op1.reg_id)));
        if (op2.kind == def.OP_REG) {
            // shift by CL
            buf.buf_emit8(b, 211);
            buf.buf_emit8(b, make_modrm(3, ext, code));
        } else if (op2.kind == def.OP_IMM) {
            if (op2.imm == 1) {
                buf.buf_emit8(b, 209);
                buf.buf_emit8(b, make_modrm(3, ext, code));
            } else {
                buf.buf_emit8(b, 193);
                buf.buf_emit8(b, make_modrm(3, ext, code));
                buf.buf_emit8(b, cast(i32, op2.imm));
            }
        }
        return cast(i32, b.len - start);
    }

    // --- MOVSXD reg, [mem] or reg ---
    if (inst == def.INST_MOVSXD) {
        let is i32 as dst_code = reg_code(op1.reg_id);
        buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, 0));
        if (op2.kind == def.OP_MEM) {
            let is i64 as rex_pos = b.len - 1;
            let is i32 as rex_x with mut = 0;
            if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
            b.data[rex_pos] = cast(u8, make_rex(1, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 99);
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        } else if (op2.kind == def.OP_REG) {
            b.data[b.len - 1] = cast(u8, make_rex(1, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 99);
            buf.buf_emit8(b, make_modrm(3, dst_code, reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVSX reg, [mem] or reg (byte/word) ---
    if (inst == def.INST_MOVSX) {
        let is i32 as dst_code = reg_code(op1.reg_id);
        if (op2.kind == def.OP_MEM) {
            let is i32 as w = 1;
            let is i32 as rex_x with mut = 0;
            if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
            buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 15);
            if (op2.mem_size == 8) { buf.buf_emit8(b, 190); }
            else { buf.buf_emit8(b, 191); }
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        }
        else if (op2.kind == def.OP_REG) {
            let is i32 as src_sz = reg_size(op2.reg_id);
            buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            if (src_sz == 8) { buf.buf_emit8(b, 190); }
            else { buf.buf_emit8(b, 191); }
            buf.buf_emit8(b, make_modrm(3, dst_code, reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVZX reg, [mem] or reg (byte/word) ---
    if (inst == def.INST_MOVZX) {
        let is i32 as dst_code = reg_code(op1.reg_id);
        if (op2.kind == def.OP_MEM) {
            let is i32 as w with mut = 0;
            if (reg_size(op1.reg_id) == 64) { w = 1; }
            let is i32 as rex_x with mut = 0;
            if (has_sib(op2) == 1) { rex_x = reg_ext(op2.mem_index); }
            buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), rex_x, reg_ext(op2.mem_base)));
            buf.buf_emit8(b, 15);
            if (op2.mem_size == 8) { buf.buf_emit8(b, 182); }
            else { buf.buf_emit8(b, 183); }
            if (has_sib(op2) == 1) {
                emit_mem_modrm_sib(b, dst_code, op2.mem_base, op2.mem_index, op2.mem_scale, op2.mem_disp);
            } else {
                emit_mem_modrm(b, dst_code, op2.mem_base, op2.mem_disp);
            }
        }
        else if (op2.kind == def.OP_REG) {
            let is i32 as src_sz = reg_size(op2.reg_id);
            let is i32 as w with mut = 0;
            if (reg_size(op1.reg_id) == 64) { w = 1; }
            buf.buf_emit8(b, make_rex(w, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            if (src_sz == 8) { buf.buf_emit8(b, 182); }
            else { buf.buf_emit8(b, 183); }
            buf.buf_emit8(b, make_modrm(3, dst_code, reg_code(op2.reg_id)));
        }
        return cast(i32, b.len - start);
    }

    // --- MOVQ (SSE) ---
    if (inst == def.INST_MOVQ) {
        if (op1.kind == def.OP_REG && reg_size(op1.reg_id) == 128 && op2.kind == def.OP_REG) {
            // movq xmm, r64: 66 REX.W 0F 6E
            buf.buf_emit8(b, 102);
            buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            buf.buf_emit8(b, 15);
            buf.buf_emit8(b, 110);
            buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG && reg_size(op2.reg_id) == 128) {
            // movq r64, xmm: 66 REX.W 0F 7E
            buf.buf_emit8(b, 102);
            buf.buf_emit8(b, make_rex(1, reg_ext(op2.reg_id), 0, reg_ext(op1.reg_id)));
            buf.buf_emit8(b, 15);
            buf.buf_emit8(b, 126);
            buf.buf_emit8(b, make_modrm(3, reg_code(op2.reg_id), reg_code(op1.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // --- SSE arithmetic: addsd/subsd/mulsd/divsd ---
    if (inst == def.INST_ADDSD || inst == def.INST_SUBSD || inst == def.INST_MULSD || inst == def.INST_DIVSD) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            buf.buf_emit8(b, 242); // F2 prefix
            let is i32 as need_rex with mut = 0;
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, make_rex(0, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            }
            buf.buf_emit8(b, 15);
            if (inst == def.INST_ADDSD) { buf.buf_emit8(b, 88); }
            if (inst == def.INST_SUBSD) { buf.buf_emit8(b, 92); }
            if (inst == def.INST_MULSD) { buf.buf_emit8(b, 89); }
            if (inst == def.INST_DIVSD) { buf.buf_emit8(b, 94); }
            buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // --- XORPD xmm, xmm ---
    if (inst == def.INST_XORPD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        buf.buf_emit8(b, 102); // 66 prefix
        let is i32 as need_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, make_rex(0, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);
        buf.buf_emit8(b, 87);
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTTSD2SI r64, xmm ---
    if (inst == def.INST_CVTTSD2SI && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 REX.W 0F 2C /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 44);  // 2C
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSI2SD xmm, r64 ---
    if (inst == def.INST_CVTSI2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 REX.W 0F 2A /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        buf.buf_emit8(b, make_rex(1, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 42);  // 2A
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSD2SS xmm, xmm ---
    if (inst == def.INST_CVTSD2SS && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F2 0F 5A /r (mod=11)
        buf.buf_emit8(b, 242); // F2
        let is i32 as need_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, make_rex(0, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 90);  // 5A
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- CVTSS2SD xmm, xmm ---
    if (inst == def.INST_CVTSS2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        // F3 0F 5A /r (mod=11)
        buf.buf_emit8(b, 243); // F3
        let is i32 as need_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        if (need_rex == 1) {
            buf.buf_emit8(b, make_rex(0, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
        }
        buf.buf_emit8(b, 15);  // 0F
        buf.buf_emit8(b, 90);  // 5A
        buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
        return cast(i32, b.len - start);
    }

    // --- MOVD xmm, r32 / MOVD r32, xmm ---
    if (inst == def.INST_MOVD) {
        if (op1.kind == def.OP_REG && reg_size(op1.reg_id) == 128 && op2.kind == def.OP_REG) {
            // movd xmm, r32: 66 [REX] 0F 6E /r
            buf.buf_emit8(b, 102); // 66
            let is i32 as need_rex with mut = 0;
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, make_rex(0, reg_ext(op1.reg_id), 0, reg_ext(op2.reg_id)));
            }
            buf.buf_emit8(b, 15);  // 0F
            buf.buf_emit8(b, 110); // 6E
            buf.buf_emit8(b, make_modrm(3, reg_code(op1.reg_id), reg_code(op2.reg_id)));
            return cast(i32, b.len - start);
        }
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG && reg_size(op2.reg_id) == 128) {
            // movd r32, xmm: 66 [REX] 0F 7E /r
            buf.buf_emit8(b, 102); // 66
            let is i32 as need_rex with mut = 0;
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            if (need_rex == 1) {
                buf.buf_emit8(b, make_rex(0, reg_ext(op2.reg_id), 0, reg_ext(op1.reg_id)));
            }
            buf.buf_emit8(b, 15);  // 0F
            buf.buf_emit8(b, 126); // 7E
            buf.buf_emit8(b, make_modrm(3, reg_code(op2.reg_id), reg_code(op1.reg_id)));
            return cast(i32, b.len - start);
        }
    }

    // Unknown instruction
    io._write_fd(io.STDERR, "ERR: unknown encoding\n", 22);
    return 0;
}

// Fast instruction size calculation — no byte emission, just arithmetic.
// Must return the exact same size as encode() for correctness.
fn fast_inst_size(inst as i32, op1 as *def.Operand, op2 as *def.Operand) as i32 {
    // No-operand instructions
    if (inst == def.INST_RET)     { return 1; }
    if (inst == def.INST_SYSCALL) { return 2; }
    if (inst == def.INST_CLD)     { return 1; }
    if (inst == def.INST_NOP)     { return 1; }
    if (inst == def.INST_CQO)     { return 2; }
    if (inst == def.INST_CDQ)     { return 1; }
    if (inst == def.INST_MOVSB)   { return 1; }
    if (inst == def.INST_REP)     { return 1; }

    // PUSH/POP reg: opcode(1) + optional REX(1)
    if (inst == def.INST_PUSH && op1.kind == def.OP_REG) { return 1 + reg_ext(op1.reg_id); }
    if (inst == def.INST_POP && op1.kind == def.OP_REG)  { return 1 + reg_ext(op1.reg_id); }

    // CALL/JMP reg: optional REX(1) + FF(1) + ModRM(1) = 2 or 3
    if (inst == def.INST_CALL && op1.kind == def.OP_REG) { return 2 + reg_ext(op1.reg_id); }
    if (inst == def.INST_JMP && op1.kind == def.OP_REG)  { return 2 + reg_ext(op1.reg_id); }

    // CALL/JMP label: opcode(1) + rel32(4) = 5
    if (inst == def.INST_CALL && op1.kind == def.OP_LABEL) { return 5; }
    if (inst == def.INST_JMP && op1.kind == def.OP_LABEL)  { return 5; }
    // CALL [rip+label] (FF /5 indirect): FF(1) + ModRM(1) + disp32(4) = 6
    if (inst == def.INST_CALL && op1.kind == def.OP_RIP_LABEL) { return 6; }

    // Jcc label: 0F(1) + cc(1) + rel32(4) = 6
    if (inst >= def.INST_JZ && inst <= def.INST_JBE && op1.kind == def.OP_LABEL) { return 6; }

    // SETcc reg: optional REX + 0F + cc + ModRM = 3 or 4
    if (inst >= def.INST_SETE && inst <= def.INST_SETAE && op1.kind == def.OP_REG) {
        let is i32 as has_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || needs_rex_for_8bit(op1.reg_id) == 1) { has_rex = 1; }
        return 3 + has_rex;
    }

    // IDIV/DIV/NEG/NOT reg: always REX + opcode + ModRM = 3
    if ((inst == def.INST_IDIV || inst == def.INST_DIV || inst == def.INST_NEG || inst == def.INST_NOT) && op1.kind == def.OP_REG) {
        return 3;
    }

    // MOV
    if (inst == def.INST_MOV) {
        // MOV reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op2.reg_id) == 1 || reg_ext(op1.reg_id) == 1) { need_rex = 1; }
            if (sz == 8 && (needs_rex_for_8bit(op1.reg_id) == 1 || needs_rex_for_8bit(op2.reg_id) == 1)) { need_rex = 1; }
            return s + need_rex + 2;
        }
        // MOV reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = reg_size(op1.reg_id);
            if (sz == 64) {
                if (imm_is32(op2.imm) == 1) { return 7; }
                return 10;
            }
            if (sz == 32) { return 5 + reg_ext(op1.reg_id); }
            if (sz == 16) { return 4 + reg_ext(op1.reg_id); }
            // sz == 8
            let is i32 as has_rex with mut = 0;
            if (reg_ext(op1.reg_id) == 1 || needs_rex_for_8bit(op1.reg_id) == 1) { has_rex = 1; }
            return 2 + has_rex;
        }
        // MOV [mem], reg
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_REG) {
            let is i32 as sz with mut = reg_size(op2.reg_id);
            if (op1.mem_size > 0 && op1.mem_size < sz) { sz = op1.mem_size; }
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op2.reg_id) == 1 || reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op1) == 1 && reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && needs_rex_for_8bit(op2.reg_id) == 1) { need_rex = 1; }
            let is i32 as mm with mut = mem_modrm_size(op1.mem_base, op1.mem_disp);
            if (has_sib(op1) == 1) { mm = mem_modrm_sib_size(op1.mem_base, op1.mem_disp); }
            return s + need_rex + 1 + mm;
        }
        // MOV reg, [mem]
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op2) == 1 && reg_ext(op2.mem_index) == 1) { need_rex = 1; }
            if (sz == 8 && needs_rex_for_8bit(op1.reg_id) == 1) { need_rex = 1; }
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return s + need_rex + 1 + mm;
        }
        // MOV reg, [rip+label]
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) { return 7; }
        // MOV [mem], imm
        if (op1.kind == def.OP_MEM && op2.kind == def.OP_IMM) {
            let is i32 as sz with mut = op1.mem_size;
            if (sz == 0) { sz = 64; }
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op1.mem_base) == 1) { need_rex = 1; }
            if (has_sib(op1) == 1 && reg_ext(op1.mem_index) == 1) { need_rex = 1; }
            let is i32 as mm with mut = mem_modrm_size(op1.mem_base, op1.mem_disp);
            if (has_sib(op1) == 1) { mm = mem_modrm_sib_size(op1.mem_base, op1.mem_disp); }
            s = s + need_rex + 1 + mm;
            if (sz == 8) { return s + 1; }
            if (sz == 16) { return s + 2; }
            return s + 4;
        }
    }

    // LEA
    if (inst == def.INST_LEA) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return 2 + mm;
        }
        if (op1.kind == def.OP_REG && op2.kind == def.OP_RIP_LABEL) { return 7; }
    }

    // ADD/SUB/AND/OR/XOR/CMP
    if (inst == def.INST_ADD || inst == def.INST_SUB || inst == def.INST_AND || inst == def.INST_OR || inst == def.INST_XOR || inst == def.INST_CMP) {
        // reg, reg
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            return s + need_rex + 2;
        }
        // reg, imm
        if (op1.kind == def.OP_REG && op2.kind == def.OP_IMM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as need_rex with mut = 0;
            if (sz == 64) { need_rex = 1; }
            if (reg_ext(op1.reg_id) == 1) { need_rex = 1; }
            s = s + need_rex;
            if (imm_is8(op2.imm) == 1 && sz != 8) { return s + 3; }
            if (sz == 8) { return s + 3; }
            if (sz == 16) { return s + 4; }
            return s + 6;
        }
        // reg, [mem] — always emits REX
        if (op1.kind == def.OP_REG && op2.kind == def.OP_MEM) {
            let is i32 as sz = reg_size(op1.reg_id);
            let is i32 as s with mut = 0;
            if (sz == 16) { s = s + 1; }
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return s + 1 + 1 + mm;
        }
    }

    // TEST reg, reg
    if (inst == def.INST_TEST && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as sz = reg_size(op1.reg_id);
        let is i32 as s with mut = 0;
        if (sz == 16) { s = s + 1; }
        let is i32 as need_rex with mut = 0;
        if (sz == 64) { need_rex = 1; }
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        return s + need_rex + 2;
    }

    // IMUL reg, reg — always REX + 0F + opcode + ModRM = 4
    if (inst == def.INST_IMUL && op1.kind == def.OP_REG && op2.kind == def.OP_REG) { return 4; }

    // SHL/SHR/SAR — always emits REX
    if ((inst == def.INST_SHL || inst == def.INST_SHR || inst == def.INST_SAR) && op1.kind == def.OP_REG) {
        if (op2.kind == def.OP_REG) { return 3; }
        if (op2.kind == def.OP_IMM) {
            if (op2.imm == 1) { return 3; }
            return 4;
        }
    }

    // MOVSXD — always REX
    if (inst == def.INST_MOVSXD) {
        if (op2.kind == def.OP_MEM) {
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return 2 + mm;
        }
        if (op2.kind == def.OP_REG) { return 3; }
    }

    // MOVSX — always REX + 0F prefix
    if (inst == def.INST_MOVSX) {
        if (op2.kind == def.OP_MEM) {
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return 3 + mm;
        }
        if (op2.kind == def.OP_REG) { return 4; }
    }

    // MOVZX — REX + 0F prefix
    if (inst == def.INST_MOVZX) {
        if (op2.kind == def.OP_MEM) {
            let is i32 as mm with mut = mem_modrm_size(op2.mem_base, op2.mem_disp);
            if (has_sib(op2) == 1) { mm = mem_modrm_sib_size(op2.mem_base, op2.mem_disp); }
            return 3 + mm;
        }
        if (op2.kind == def.OP_REG) { return 4; }
    }

    // MOVQ (SSE): 66 + REX + 0F + opcode + ModRM = 5
    if (inst == def.INST_MOVQ) { return 5; }

    // SSE arithmetic: F2 + optional REX + 0F + opcode + ModRM
    if (inst == def.INST_ADDSD || inst == def.INST_SUBSD || inst == def.INST_MULSD || inst == def.INST_DIVSD) {
        if (op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
            let is i32 as need_rex with mut = 0;
            if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
            return 4 + need_rex;
        }
    }

    // XORPD: 66 + optional REX + 0F + opcode + ModRM
    if (inst == def.INST_XORPD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as need_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { need_rex = 1; }
        return 4 + need_rex;
    }

    // CVTTSD2SI: F2 + REX + 0F + opcode + ModRM = 5
    if (inst == def.INST_CVTTSD2SI && op1.kind == def.OP_REG && op2.kind == def.OP_REG) { return 5; }

    // CVTSI2SD: F2 + REX + 0F + opcode + ModRM = 5
    if (inst == def.INST_CVTSI2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) { return 5; }

    // CVTSD2SS: F2 + [REX] + 0F + 5A + ModRM = 4 or 5
    if (inst == def.INST_CVTSD2SS && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as has_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { has_rex = 1; }
        return 4 + has_rex;
    }

    // CVTSS2SD: F3 + [REX] + 0F + 5A + ModRM = 4 or 5
    if (inst == def.INST_CVTSS2SD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as has_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { has_rex = 1; }
        return 4 + has_rex;
    }

    // MOVD: 66 + [REX] + 0F + opcode + ModRM = 4 or 5
    if (inst == def.INST_MOVD && op1.kind == def.OP_REG && op2.kind == def.OP_REG) {
        let is i32 as has_rex with mut = 0;
        if (reg_ext(op1.reg_id) == 1 || reg_ext(op2.reg_id) == 1) { has_rex = 1; }
        return 4 + has_rex;
    }

    return 0;
}
