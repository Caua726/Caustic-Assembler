name "caustic-as"
version "0.1.0"
author "Caua"

target "caustic-as" {
    src "main.cst"
    out "caustic-as"
}

script "test-scalar-sse" {
    "caustic -q -O1 main.cst -o caustic-as"
    "sh tests/run_scalar_sse.sh ./caustic-as caustic-ld"
}

script "test-local-relocations" {
    "caustic -q -O1 main.cst -o caustic-as"
    "sh tests/run_local_relocations.sh ./caustic-as caustic-ld"
}
