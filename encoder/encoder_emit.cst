use "../../std/io.cst" as io;
use "../core/asm_defs.cst" as def;
use "../core/buf.cst" as buf;
use "encoder_util.cst" as eu;
use "encoder_ctrl.cst" as ectrl;
use "encoder_alu.cst" as ealu;
use "encoder_mov.cst" as emov;
use "encoder_sse.cst" as esse;

// Instruction encoder dispatcher. The actual per-family encoders live in
// encoder_{ctrl,alu,mov,sse}.cst. Each family returns the encoded size in
// bytes, or eu.ENC_SKIP when the instruction is not its own; we try them in
// order and return the first concrete result. Families touch disjoint sets of
// instruction ids, so the order between them is irrelevant — it only fixes a
// deterministic fall-through to the "unknown encoding" error.
fn encode(b as *buf.ByteBuffer, inst as i32, op1 as *def.Operand, op2 as *def.Operand, resolve_label as i64, cur_off as i64) as i32 {
    let is i32 as r with mut = ectrl.encode_ctrl(b, inst, op1, op2, resolve_label, cur_off);
    if (r != eu.ENC_SKIP) { return r; }

    r = ealu.encode_alu(b, inst, op1, op2, resolve_label, cur_off);
    if (r != eu.ENC_SKIP) { return r; }

    r = emov.encode_mov(b, inst, op1, op2, resolve_label, cur_off);
    if (r != eu.ENC_SKIP) { return r; }

    r = esse.encode_sse(b, inst, op1, op2);
    if (r != eu.ENC_SKIP) { return r; }

    // Unknown instruction
    io._write_fd(io.STDERR, "ERR: unknown encoding\n", 22);
    return 0;
}
