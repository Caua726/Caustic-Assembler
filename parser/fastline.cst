// fastline.cst — the parser's fast path: one source line straight from its
// bytes into a ParsedLine, with no token array in between.
//
// It takes the shapes the compiler writes — `name:`, `op`, `op a`, `op a, b`
// with registers, immediates, labels, `SIZE PTR [base ± disp]`,
// `[base + index*scale ± disp]` and `[rip + symbol]` — which are about 99 % of
// the lines of a compiled program, and (fast_dir) the directives it writes and
// whole-line comments. Anything else (other directives, trailing comments,
// prefixes, segment overrides, a word the tokenizer would treat specially) is
// declined, and the caller hands that line to the tokenizer and parse_chunk as
// before. Where it accepts a line, the result is exactly what the tokenizer
// path builds for it: words are classified by the lexer's own tables
// (char_tab, ri_first, ht_lookup) and operands are set with the same
// parsed_line setters; anything the two might read differently is declined.
use "../lexer/lexer.cst" as lex;
use "../core/asm_defs.cst" as def;
use "parsed_line.cst" as pl;
use "custom_sections.cst" as cs;

fn _sp(src as *u8, i as i64, e as i64) as i64 {
    let is i64 as k with mut = i;
    while (k < e && (src[k] == 32 || src[k] == 9)) { k = k + 1; }
    return k;
}

// The byte at i, or -1 at the end of the line (its newline or the end of
// the buffer, e). Every scan here stops at a newline by itself: it is not a
// blank, not an identifier character and not a digit.
fn _at(src as *u8, i as i64, e as i64) as i32 {
    if (i >= e || src[i] == 10) { return cast(i32, 0 - 1); }
    return cast(i32, src[i]);
}

fn _word_start(c as i32) as i32 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46) { return 1; }
    return 0;
}

// End of the word starting at i (the tokenizer's identifier scan).
fn _word_end(src as *u8, i as i64, e as i64) as i64 {
    let is i64 as k with mut = i + 1;
    while (k < e && lex.char_tab[cast(i32, src[k])] != 0) { k = k + 1; }
    return k;
}

// ht_lookup behind a direct-mapped cache: a register or mnemonic of up to 8
// bytes is keyed by those bytes (loaded whole, the bytes past the word masked
// off) and its length. Words come from lines that always continue past them
// (at least a newline or the end-of-buffer guard below), so the 8-byte load is
// only made when 8 bytes remain before the buffer end.
let is [4096]i64 as _lk_key with mut;
let is [4096]i32 as _lk_val with mut;     // ht_lookup result + 1 (0 = empty slot)
let is i64 as _lk_end with mut = 0;        // end of the buffer being parsed

fn lookup_begin(end as i64) as void { _lk_end = end; }

fn _lookup(p as *u8, len as i32) as i32 {
    if (len > 8 || cast(i64, p) + 8 > _lk_end) { return lex.ht_lookup(p, len); }
    let is i64 as w with mut = *cast(*i64, p);
    if (len < 8) { w = w & ((cast(i64, 1) << cast(i64, len * 8)) - 1); }
    let is i64 as key = w ^ (cast(i64, len) << 59);
    let is i32 as slot = cast(i32, ((key * 0x9E3779B97F4A7C15) >> 52) & 4095);
    if (_lk_val[slot] != 0 && _lk_key[slot] == key) { return _lk_val[slot] - 1; }
    let is i32 as r = lex.ht_lookup(p, len);
    _lk_key[slot] = key;
    _lk_val[slot] = r + 1;
    return r;
}

// How the tokenizer would read the word p[0..len) when no `PTR` follows it:
// -1 = something special (directive, size prefix, a skipped word): decline;
// 0 = an identifier; else kind * 65536 + id with kind 1 = register,
// 2 = instruction (ht_lookup's encoding).
fn _word(p as *u8, len as i32) as i32 {
    let is i32 as c = cast(i32, p[0]);
    if (c == 46) {
        if (len >= 2 && p[1] == 76) { return 0; }          // .L… — never a directive
        return cast(i32, 0 - 1);
    }
    if (c >= 66 && c <= 87 && len >= 4 && len <= 5) { return cast(i32, 0 - 1); }
    if (len == 8 && c == 110 && p[1] == 111) { return cast(i32, 0 - 1); }   // noprefix
    if (len > 9 || lex.ri_first[c] == 0) { return 0; }
    let is i32 as h = _lookup(p, len);
    if (h == 0) {
        if (len == 3 && c == 80 && p[1] == 84 && p[2] == 82) { return cast(i32, 0 - 1); }   // PTR
        return 0;
    }
    return h;
}

// A number at i followed by a delimiter: its end, value in *out; -1 if none.
fn _num(src as *u8, i as i64, e as i64, out as *i64) as i64 {
    let is i32 as c = _at(src, i, e);
    if (c < 48 || c > 57) { return 0 - 1; }
    let is i64 as k = lex.parse_number_fast(src, i, e, out);
    if (k < e && lex.char_tab[cast(i32, src[k])] != 0) { return 0 - 1; }
    return k;
}

// The memory operand opening at src[i] == '['. 1 and *outp past ']' when taken.
fn _mem(src as *u8, i0 as i64, e as i64, line as *pl.ParsedLine, which as i32, sz as i32, outp as *i64) as i32 {
    let is i64 as i with mut = _sp(src, i0 + 1, e);
    let is i32 as c with mut = _at(src, i, e);
    if (c < 97 || c > 122) { return 0; }
    let is i64 as we with mut = _word_end(src, i, e);
    let is i32 as bc = _word(cast(*u8, cast(i64, src) + i), cast(i32, we - i));
    if ((bc >> 16) != 1) { return 0; }
    let is i32 as base = bc & 65535;
    i = _sp(src, we, e);
    let is i64 as v with mut = 0;
    if (base == def.REG_RIP) {
        if (_at(src, i, e) != 43) { return 0; }
        i = _sp(src, i + 1, e);
        if (_word_start(_at(src, i, e)) == 0) { return 0; }
        we = _word_end(src, i, e);
        let is *u8 as lp = cast(*u8, cast(i64, src) + i);
        let is i32 as ll = cast(i32, we - i);
        if (_word(lp, ll) < 0) { return 0; }
        i = _sp(src, we, e);
        if (_at(src, i, e) != 93) { return 0; }
        pl.set_op_rip(line, which, lp, ll, sz);
        *outp = i + 1;
        return 1;
    }
    let is i64 as disp with mut = 0;
    let is i32 as index with mut = def.REG_NONE;
    let is i32 as scale with mut = 0;
    c = _at(src, i, e);
    if (c == 43) {
        i = _sp(src, i + 1, e);
        c = _at(src, i, e);
        if (c >= 97 && c <= 122) {
            we = _word_end(src, i, e);
            let is i32 as ic = _word(cast(*u8, cast(i64, src) + i), cast(i32, we - i));
            if ((ic >> 16) != 1) { return 0; }
            index = ic & 65535;
            i = _sp(src, we, e);
            if (_at(src, i, e) == 42) {
                let is i64 as k = _num(src, _sp(src, i + 1, e), e, &v);
                if (k < 0) { return 0; }
                scale = cast(i32, v);
                i = _sp(src, k, e);
            } else {
                scale = 1;
            }
            c = _at(src, i, e);
            if (c == 43 || c == 45) {
                let is i64 as k2 = _num(src, _sp(src, i + 1, e), e, &v);
                if (k2 < 0) { return 0; }
                if (c == 43) { disp = v; } else { disp = 0 - v; }
                i = _sp(src, k2, e);
            }
        } else {
            let is i64 as k3 = _num(src, i, e, &v);
            if (k3 < 0) { return 0; }
            disp = v;
            i = _sp(src, k3, e);
        }
    } else if (c == 45) {
        let is i64 as k4 = _num(src, _sp(src, i + 1, e), e, &v);
        if (k4 < 0) { return 0; }
        disp = 0 - v;
        i = _sp(src, k4, e);
    }
    if (_at(src, i, e) != 93) { return 0; }
    *outp = i + 1;
    if (index != def.REG_NONE) { pl.set_op_mem_sib(line, which, base, index, scale, disp, sz); }
    else { pl.set_op_mem(line, which, base, disp, sz); }
    return 1;
}

// QWORD/DWORD/WORD/BYTE at p[0..len): the size in bits, else 0.
fn _size_word(p as *u8, len as i32) as i32 {
    if (len == 5 && p[1] == 87 && p[2] == 79 && p[3] == 82 && p[4] == 68) {
        if (p[0] == 81) { return 64; }
        if (p[0] == 68) { return 32; }
    }
    if (len == 4 && p[0] == 87 && p[1] == 79 && p[2] == 82 && p[3] == 68) { return 16; }
    if (len == 4 && p[0] == 66 && p[1] == 89 && p[2] == 84 && p[3] == 69) { return 8; }
    return 0;
}

fn _operand(src as *u8, i0 as i64, e as i64, line as *pl.ParsedLine, which as i32, outp as *i64) as i32 {
    let is i64 as i = _sp(src, i0, e);
    let is i32 as c = _at(src, i, e);
    let is i64 as v with mut = 0;
    if (c >= 48 && c <= 57) {
        let is i64 as k = _num(src, i, e, &v);
        if (k < 0) { return 0; }
        pl.set_op_imm(line, which, v);
        *outp = k;
        return 1;
    }
    if (c == 45) {
        let is i64 as k2 = _num(src, _sp(src, i + 1, e), e, &v);
        if (k2 < 0) { return 0; }
        pl.set_op_imm(line, which, 0 - v);
        *outp = k2;
        return 1;
    }
    if (c == 91) { return _mem(src, i, e, line, which, 0, outp); }
    if (_word_start(c) == 0) { return 0; }
    let is i64 as we = _word_end(src, i, e);
    let is *u8 as wp = cast(*u8, cast(i64, src) + i);
    let is i32 as wl = cast(i32, we - i);
    let is i32 as sz = _size_word(wp, wl);
    if (sz != 0) {
        // The tokenizer skips spaces only (not tabs) before PTR.
        let is i64 as k3 with mut = we;
        while (k3 < e && src[k3] == 32) { k3 = k3 + 1; }
        if (_at(src, k3, e) != 80 || _at(src, k3 + 1, e) != 84 || _at(src, k3 + 2, e) != 82) { return 0; }
        if (k3 + 3 < e && lex.char_tab[cast(i32, src[k3 + 3])] != 0) { return 0; }
        let is i64 as lb = _sp(src, k3 + 3, e);
        if (_at(src, lb, e) != 91) { return 0; }
        return _mem(src, lb, e, line, which, sz, outp);
    }
    let is i32 as cls = _word(wp, wl);
    if (cls < 0) { return 0; }
    if ((cls >> 16) == 1) { pl.set_op_reg(line, which, cls & 65535); }
    else { pl.set_op_label(line, which, wp, wl); }
    *outp = we;
    return 1;
}

// Parse the line starting at s (e = end of the buffer) into `lines`.
// Returns where the line ends (its newline, or e): the line is done (a blank
// line adds nothing). -1 = declined, `lines` untouched, for the tokenizer.
fn fast_line(src as *u8, s as i64, e as i64, lines as *pl.ParsedLines, section as i32, line_no as i32) as i64 {
    let is i64 as i with mut = _sp(src, s, e);
    let is i32 as c = _at(src, i, e);
    if (c < 0) { return i; }
    if (_word_start(c) == 0) { return 0 - 1; }
    let is i64 as we = _word_end(src, i, e);
    let is *u8 as wp = cast(*u8, cast(i64, src) + i);
    let is i32 as wl = cast(i32, we - i);
    let is i32 as cls = _word(wp, wl);
    if (cls < 0) { return 0 - 1; }
    if (_at(src, we, e) == 58) {
        if ((cls >> 16) == 1) { return 0 - 1; }
        let is i64 as le = _sp(src, we + 1, e);
        if (_at(src, le, e) >= 0) { return 0 - 1; }
        let is *pl.ParsedLine as lbl = pl.pl_add(lines);
        lbl.kind = pl.LINE_LABEL;
        lbl.section = cast(i8, section);
        pl.axw(lbl).label_ptr = wp;
        pl.axw(lbl).label_len = cast(i16, wl);
        lbl.line_no = line_no;
        return le;
    }
    if ((cls >> 16) != 2) { return 0 - 1; }
    let is i32 as id = cls & 65535;
    if (id == def.INST_REP || id == def.INST_LOCK) { return 0 - 1; }
    let is *pl.ParsedLine as line = pl.pl_add(lines);
    line.kind = pl.LINE_INST;
    line.section = cast(i8, section);
    line.inst_id = cast(i16, id);
    line.line_no = line_no;
    i = _sp(src, we, e);
    if (_at(src, i, e) >= 0) {
        let is i64 as k with mut = 0;
        if (_operand(src, i, e, line, 1, &k) == 0) { lines.count = lines.count - 1; return 0 - 1; }
        i = _sp(src, k, e);
        if (_at(src, i, e) == 44) {
            if (_operand(src, i + 1, e, line, 2, &k) == 0) { lines.count = lines.count - 1; return 0 - 1; }
            i = _sp(src, k, e);
        }
        if (_at(src, i, e) >= 0) { lines.count = lines.count - 1; return 0 - 1; }
    }
    return i;
}

// ── Directives ─────────────────────────────────────────────────────

fn _is(p as *u8, n as i32, lit as *u8, ln as i32) as i32 {
    if (n != ln) { return 0; }
    let is i32 as k with mut = 1;                  // [0] is the '.' already seen
    while (k < n) { if (p[k] != lit[k]) { return 0; } k = k + 1; }
    return 1;
}

let is *u8 as _da with mut;                        // _dsym / _dstr: the operand
let is i32 as _dl with mut;

// A symbol the tokenizer reads as an identifier: its end, or -1.
fn _dsym(src as *u8, i as i64, e as i64) as i64 {
    let is i32 as c = _at(src, i, e);
    if (c < 0 || _word_start(c) == 0) { return 0 - 1; }
    let is i64 as we = _word_end(src, i, e);
    _da = cast(*u8, cast(i64, src) + i);
    _dl = cast(i32, we - i);
    if (_word(_da, _dl) != 0) { return 0 - 1; }
    return we;
}

// A string literal closed on this line, quotes included: its end, or -1.
fn _dstr(src as *u8, i as i64, e as i64) as i64 {
    if (_at(src, i, e) != 34) { return 0 - 1; }
    let is i64 as k with mut = i + 1;
    while (k < e && src[k] != 34) {
        if (src[k] == 10) { return 0 - 1; }
        if (src[k] == 92) {
            k = k + 1;
            if (k >= e || src[k] == 10) { return 0 - 1; }
        }
        k = k + 1;
    }
    if (k >= e) { return 0 - 1; }
    _da = cast(*u8, cast(i64, src) + i);
    _dl = cast(i32, k + 1 - i);
    return k + 1;
}

// A decimal or 0x number, `-` in front of it when neg is 1: its end, or -1.
// What follows must be a blank, a comma or the end of the line.
let is i64 as _dn with mut;
fn _dnum(src as *u8, i0 as i64, e as i64, neg as i32) as i64 {
    let is i64 as i with mut = i0;
    let is i32 as minus with mut = 0;
    if (neg == 1 && _at(src, i, e) == 45) { minus = 1; i = _sp(src, i + 1, e); }
    let is i32 as c = _at(src, i, e);
    if (c < 48 || c > 57) { return 0 - 1; }
    let is i64 as k = lex.parse_number_fast(src, i, e, &_dn);
    let is i32 as d = _at(src, k, e);
    if (d >= 0 && d != 32 && d != 9 && d != 44) { return 0 - 1; }
    if (minus == 1) { _dn = 0 - _dn; }
    return k;
}

fn _dline(lines as *pl.ParsedLines, kind as i32, section as i32, line_no as i32) as *pl.ParsedLine {
    let is *pl.ParsedLine as line = pl.pl_add(lines);
    line.kind = pl.LINE_DIRECTIVE;
    line.section = cast(i8, section);
    line.line_no = line_no;
    line.dir_kind = cast(i8, kind);
    return line;
}

// One directive or whole-line comment (src[s..] up to its newline, e the end of
// the buffer). Returns the line's end, or -1: the tokenizer's. Every operand is
// read before the record is added, so a declined line leaves nothing behind.
fn fast_dir(src as *u8, s as i64, e as i64, lines as *pl.ParsedLines, section as *i32, line_no as i32) as i64 {
    let is i64 as i with mut = _sp(src, s, e);
    let is i32 as c0 = _at(src, i, e);
    if (c0 == 35) {
        while (i < e && src[i] != 10) { i = i + 1; }
        return i;
    }
    if (c0 != 46) { return 0 - 1; }
    let is i64 as we = _word_end(src, i, e);
    let is *u8 as p = cast(*u8, cast(i64, src) + i);
    let is i32 as n = cast(i32, we - i);
    if (n < 4) { return 0 - 1; }
    let is i32 as c = cast(i32, p[1]);
    let is i64 as a = _sp(src, we, e);
    let is i64 as k with mut = 0;
    let is i32 as sec = *section;
    if (c == 99) {
        if (_is(p, n, ".cfi_offset", 11) == 1) {
            k = _dsym_reg(src, a, e);
            if (k < 0) { return 0 - 1; }
            let is i32 as reg = _dl;
            k = _sp(src, k, e);
            if (_at(src, k, e) != 44) { return 0 - 1; }
            k = _dnum(src, _sp(src, k + 1, e), e, 1);
            if (k < 0) { return 0 - 1; }
            k = _sp(src, k, e);
            if (_at(src, k, e) >= 0) { return 0 - 1; }
            let is *pl.ParsedLine as o = _dline(lines, pl.DIR_CFI_OFFSET, sec, line_no);
            pl.axw(o).dir_arg_len = reg;
            pl.axw(o).dir_num = _dn;
            return k;
        }
        if (_is(p, n, ".cfi_def_cfa_offset", 19) == 1) {
            k = _dnum(src, a, e, 0);
            if (k < 0) { return 0 - 1; }
            k = _sp(src, k, e);
            if (_at(src, k, e) >= 0) { return 0 - 1; }
            pl.axw(_dline(lines, pl.DIR_CFI_DEF_CFA_OFFSET, sec, line_no)).dir_num = _dn;
            return k;
        }
        if (_is(p, n, ".cfi_def_cfa_register", 21) == 1) {
            k = _dsym_reg(src, a, e);
            if (k < 0) { return 0 - 1; }
            let is i32 as reg = _dl;
            k = _sp(src, k, e);
            if (_at(src, k, e) >= 0) { return 0 - 1; }
            pl.axw(_dline(lines, pl.DIR_CFI_DEF_CFA_REGISTER, sec, line_no)).dir_arg_len = reg;
            return k;
        }
        if (_is(p, n, ".cfi_endproc", 12) == 1) {
            if (_at(src, a, e) >= 0) { return 0 - 1; }
            _dline(lines, pl.DIR_CFI_ENDPROC, sec, line_no);
            return a;
        }
        if (_is(p, n, ".cfi_startproc", 14) == 1) {
            k = a;
            if (_at(src, a, e) >= 0) {
                k = _dsym(src, a, e);
                if (k < 0) { return 0 - 1; }
                k = _sp(src, k, e);
                if (_at(src, k, e) >= 0) { return 0 - 1; }
                let is *pl.ParsedLine as o = _dline(lines, pl.DIR_CFI_STARTPROC, sec, line_no);
                pl.axw(o).dir_arg_ptr = _da;
                pl.axw(o).dir_arg_len = _dl;
                return k;
            }
            _dline(lines, pl.DIR_CFI_STARTPROC, sec, line_no);
            return k;
        }
        return 0 - 1;
    }
    if (c == 108) {
        if (_is(p, n, ".long", 5) == 1) { return _dnumline(src, a, e, lines, pl.DIR_LONG, sec, line_no); }
        if (_is(p, n, ".loc", 4) == 1) {
            // file, line, column: the line is kept
            k = _dnum(src, a, e, 0);
            if (k < 0) { return 0 - 1; }
            k = _dnum(src, _sp(src, k, e), e, 0);
            if (k < 0) { return 0 - 1; }
            let is i64 as ln = _dn;
            k = _sp(src, k, e);
            if (_at(src, k, e) >= 0) {
                k = _dnum(src, k, e, 0);
                if (k < 0) { return 0 - 1; }
                k = _sp(src, k, e);
            }
            if (_at(src, k, e) >= 0) { return 0 - 1; }
            pl.axw(_dline(lines, pl.DIR_LOC, sec, line_no)).dir_num = ln;
            return k;
        }
        return 0 - 1;
    }
    if (c == 112) {
        if (_is(p, n, ".p2align", 8) == 0) { return 0 - 1; }
        k = _dnum(src, a, e, 0);
        if (k < 0) { return 0 - 1; }
        let is i64 as pw = _dn;
        let is i64 as mx with mut = 0;
        k = _sp(src, k, e);
        if (_at(src, k, e) == 44) {                 // `, fill` (empty only) then `, max`
            k = _sp(src, k + 1, e);
            if (_at(src, k, e) != 44) { return 0 - 1; }
            k = _dnum(src, _sp(src, k + 1, e), e, 0);
            if (k < 0) { return 0 - 1; }
            mx = _dn;
            k = _sp(src, k, e);
        }
        if (_at(src, k, e) >= 0) { return 0 - 1; }
        let is *pl.ParsedLine as o = _dline(lines, pl.DIR_P2ALIGN, sec, line_no);
        pl.axw(o).dir_num = pw;
        o.op1_imm = mx;
        return k;
    }
    if (c == 103) {
        if (_is(p, n, ".globl", 6) == 0) { return 0 - 1; }
        k = _dsym(src, a, e);
        if (k < 0) { return 0 - 1; }
        k = _sp(src, k, e);
        if (_at(src, k, e) >= 0) { return 0 - 1; }
        let is *pl.ParsedLine as o = _dline(lines, pl.DIR_GLOBL, sec, line_no);
        pl.axw(o).dir_arg_ptr = _da;
        pl.axw(o).dir_arg_len = _dl;
        return k;
    }
    if (c == 97 || (c == 115 && n == 7)) {
        let is i32 as kind with mut = pl.DIR_ASCII;
        if (_is(p, n, ".string", 7) == 1 || _is(p, n, ".asciz", 6) == 1) { kind = pl.DIR_STRING; }
        else if (_is(p, n, ".ascii", 6) == 0) { return 0 - 1; }
        k = _dstr(src, a, e);
        if (k < 0) { return 0 - 1; }
        k = _sp(src, k, e);
        if (_at(src, k, e) >= 0) { return 0 - 1; }
        let is *pl.ParsedLine as o = _dline(lines, kind, sec, line_no);
        pl.axw(o).dir_arg_ptr = _da;
        pl.axw(o).dir_arg_len = _dl;
        return k;
    }
    if (c == 122) {
        if (_is(p, n, ".zero", 5) == 0) { return 0 - 1; }
        k = _dnum(src, a, e, 0);
        if (k < 0) { return 0 - 1; }
        k = _sp(src, k, e);
        if (_at(src, k, e) >= 0) { return 0 - 1; }
        pl.axw(_dline(lines, pl.DIR_ZERO, sec, line_no)).dir_num = _dn;
        return k;
    }
    if (c == 113) {
        if (_is(p, n, ".quad", 5) == 0) { return 0 - 1; }
        let is i32 as f = _at(src, a, e);
        if (f == 45 || (f >= 48 && f <= 57)) { return _dnumline(src, a, e, lines, pl.DIR_QUAD, sec, line_no); }
        k = _dsym(src, a, e);
        if (k < 0) { return 0 - 1; }
        k = _sp(src, k, e);
        if (_at(src, k, e) >= 0) { return 0 - 1; }
        let is *pl.ParsedLine as o = _dline(lines, pl.DIR_QUAD, sec, line_no);
        pl.axw(o).dir_arg_ptr = _da;
        pl.axw(o).dir_arg_len = _dl;
        pl.axw(o).dir_num = 0;
        return k;
    }
    if (c == 119) {
        if (_is(p, n, ".word", 5) == 0) { return 0 - 1; }
        return _dnumline(src, a, e, lines, pl.DIR_WORD, sec, line_no);
    }
    // Section switches: a record whose section is the new one (.section sets it
    // in the directive, the others through parse_chunk's `line.section =`).
    let is i32 as ns with mut = 0 - 1;
    let is i32 as dk with mut = 0;
    if (_at(src, a, e) < 0) {
        if (_is(p, n, ".text", 5) == 1) { ns = cs.SECTION_TEXT; dk = pl.DIR_TEXT; }
        else if (_is(p, n, ".data", 5) == 1) { ns = cs.SECTION_DATA; dk = pl.DIR_DATA; }
        else if (_is(p, n, ".bss", 4) == 1) { ns = cs.SECTION_BSS; dk = pl.DIR_BSS; }
        if (ns < 0) { return 0 - 1; }
        *section = ns;
        _dline(lines, dk, ns, line_no);
        return a;
    }
    return 0 - 1;
}

// A register operand: its end and id in _dl, or -1.
fn _dsym_reg(src as *u8, i as i64, e as i64) as i64 {
    let is i32 as c = _at(src, i, e);
    if (c < 0 || _word_start(c) == 0 || c == 46) { return 0 - 1; }
    let is i64 as we = _word_end(src, i, e);
    let is i32 as cls = _word(cast(*u8, cast(i64, src) + i), cast(i32, we - i));
    if (cls < 0 || (cls >> 16) != 1) { return 0 - 1; }
    _dl = cls & 65535;
    return we;
}

fn _dnumline(src as *u8, a as i64, e as i64, lines as *pl.ParsedLines, kind as i32, sec as i32, line_no as i32) as i64 {
    let is i64 as k with mut = _dnum(src, a, e, 1);
    if (k < 0) { return 0 - 1; }
    k = _sp(src, k, e);
    if (_at(src, k, e) >= 0) { return 0 - 1; }
    pl.axw(_dline(lines, kind, sec, line_no)).dir_num = _dn;
    return k;
}

// Where the line starting at s ends for the tokenizer: its first newline that
// is not inside a string literal (a string runs to its closing quote, skipping
// backslash escapes, as lex.tokenize reads it) or the end of the buffer.
fn tokenizer_line_end(src as *u8, s as i64, n as i64) as i64 {
    let is i64 as k with mut = s;
    while (k < n) {
        let is u8 as c = src[k];
        if (c == 10) { return k; }
        if (c == 35 || (c == 47 && k + 1 < n && src[k + 1] == 47)) {
            while (k < n && src[k] != 10) { k = k + 1; }
            return k;
        }
        if (c == 34) {
            k = k + 1;
            while (k < n && src[k] != 34) {
                if (src[k] == 92) { k = k + 1; }
                k = k + 1;
            }
            if (k < n) { k = k + 1; }
        } else {
            k = k + 1;
        }
    }
    return n;
}

// ── Record hints ───────────────────────────────────────────────────
//
// The compiler may put, before the text of a line it writes often, the record
// that text parses to: byte 0x01, a shape letter, and operands, every byte
// >= 0x20 so a newline never appears inside. The line's text follows
// unchanged (it is what spans, the peephole and diagnostics see).
//   'A' mov r64, r64             : dst+0x20 src+0x20
//   'B' mov r64, QWORD PTR [b+d] : reg+0x20 base+0x20 d(6)
//   'C' mov QWORD PTR [b+d], r64 : reg+0x20 base+0x20 d(6)
// d(6): disp + 2^35 in six 6-bit groups, low first, each + 0x30.
// hint_line adds the record and returns the line's end (its newline, or
// src_len); *tstart gets where the text begins. -1: not a shape it knows (the
// caller then parses the text after the hint).

fn _hdisp(src as *u8, p as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i32 as k with mut = 5;
    while (k >= 0) { v = (v << 6) | cast(i64, cast(i32, src[p + cast(i64, k)]) - 48); k = k - 1; }
    return v - 34359738368;
}

// A varint: 5 bits a byte (chars 48..111, +32 = more follow), low group first,
// zigzag so negatives stay short. Returns the new position, or -1 past the end.
fn _hvar(src as *u8, pos as i64, e as i64, out as *i64) as i64 {
    let is i64 as p with mut = pos;
    let is i64 as v with mut = 0;
    let is i32 as sh with mut = 0;
    while (p < e) {
        let is i32 as c = cast(i32, src[p]) - 48;
        if (c < 0 || c > 63) { return 0 - 1; }
        v = v | (cast(i64, c & 31) << cast(i64, sh));
        sh = sh + 5;
        p = p + 1;
        if ((c & 32) == 0) { *out = ((v >> 1) & 9223372036854775807) ^ (0 - (v & 1)); return p; }
        if (sh > 60) { return 0 - 1; }
    }
    return 0 - 1;
}

// The general hint: `Z`, the instruction id, then two operands, each a kind
// character (the OP_* value + 48) and its fields.
fn hint_z(src as *u8, pos as i64, src_len as i64, lines as *pl.ParsedLines, section as i32, line_no as i32, tstart as *i64) as i64 {
    let is i32 as before = lines.count;
    let is i64 as r = _hint_z(src, pos, src_len, lines, section, line_no, tstart);
    if (r < 0) { lines.count = before; }      // half read: not a hint
    return r;
}

fn _hint_z(src as *u8, pos as i64, src_len as i64, lines as *pl.ParsedLines, section as i32, line_no as i32, tstart as *i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as p with mut = _hvar(src, pos + 2, src_len, &v);
    if (p < 0) { return 0 - 1; }
    let is *pl.ParsedLine as line = pl.pl_add(lines);
    line.kind = pl.LINE_INST;
    line.section = cast(i8, section);
    line.inst_id = cast(i16, v);
    line.line_no = line_no;
    let is i32 as w with mut = 1;
    while (w <= 2) {
        if (p >= src_len) { return 0 - 1; }
        let is i32 as k = cast(i32, src[p]) - 48;
        p = p + 1;
        if (k == def.OP_REG || k == def.OP_IMM) {
            p = _hvar(src, p, src_len, &v);
            if (p < 0) { return 0 - 1; }
            if (k == def.OP_REG) { pl.set_op_reg(line, w, cast(i32, v)); }
            else { pl.set_op_imm(line, w, v); }
        } else if (k == def.OP_MEM) {
            let is [6]i64 as f;
            let is i32 as i with mut = 0;
            while (i < 6) {                         // base index scale disp size seg
                p = _hvar(src, p, src_len, &f[i]);
                if (p < 0) { return 0 - 1; }
                i = i + 1;
            }
            pl.set_op_mem_sib(line, w, cast(i32, f[0]), cast(i32, f[1]), cast(i32, f[2]), f[3], cast(i32, f[4]));
            if (f[5] != 0) { pl.set_op_seg(line, w, cast(i32, f[5])); }
        } else if (k == def.OP_LABEL) {
            p = _hvar(src, p, src_len, &v);
            if (p < 0 || v < 0 || p + v > src_len) { return 0 - 1; }
            pl.set_op_label(line, w, cast(*u8, cast(i64, src) + p), cast(i32, v));
            p = p + v;
        } else if (k == def.OP_RIP_LABEL) {             // [rip+symbol]: size, length, symbol
            let is i64 as rsz with mut = 0;
            p = _hvar(src, p, src_len, &rsz);
            if (p < 0) { return 0 - 1; }
            p = _hvar(src, p, src_len, &v);
            if (p < 0 || v < 0 || p + v > src_len) { return 0 - 1; }
            pl.set_op_rip(line, w, cast(*u8, cast(i64, src) + p), cast(i32, v), cast(i32, rsz));
            p = p + v;
        } else if (k != def.OP_NONE) { return 0 - 1; }
        w = w + 1;
    }
    *tstart = p;
    let is i64 as e with mut = p;
    while (e < src_len && src[e] != 10) { e = e + 1; }
    return e;
}

fn hint_line(src as *u8, pos as i64, src_len as i64, lines as *pl.ParsedLines, section as i32, line_no as i32, tstart as *i64) as i64 {
    let is i32 as shape = cast(i32, src[pos + 1]);
    if (shape == 90) { return hint_z(src, pos, src_len, lines, section, line_no, tstart); }
    if (shape == 68) {                                   // a directive: kind, register, number
        let is i64 as dk with mut = 0;
        let is i64 as dr with mut = 0;
        let is i64 as dn with mut = 0;
        let is i64 as dp with mut = _hvar(src, pos + 2, src_len, &dk);
        if (dp < 0) { return 0 - 1; }
        dp = _hvar(src, dp, src_len, &dr);
        if (dp < 0) { return 0 - 1; }
        dp = _hvar(src, dp, src_len, &dn);
        if (dp < 0) { return 0 - 1; }
        let is *pl.ParsedLine as dl = _dline(lines, cast(i32, dk), section, line_no);
        pl.axw(dl).dir_arg_len = cast(i32, dr);
        pl.axw(dl).dir_num = dn;
        *tstart = dp;
        return dp;
    }
    if (shape == 78) {                                   // .long n
        let is i64 as lv with mut = 0;
        let is i64 as lq = _hvar(src, pos + 2, src_len, &lv);
        if (lq < 0) { return 0 - 1; }
        pl.axw(_dline(lines, pl.DIR_LONG, section, line_no)).dir_num = lv;
        *tstart = lq;
        return lq;
    }
    let is i64 as t with mut = 0;
    if (shape == 65) { t = pos + 4; }
    else if (shape == 66 || shape == 67) { t = pos + 10; }
    else { return 0 - 1; }
    if (t > src_len) { return 0 - 1; }
    let is *pl.ParsedLine as line = pl.pl_add(lines);
    line.kind = pl.LINE_INST;
    line.section = cast(i8, section);
    line.inst_id = cast(i16, def.INST_MOV);
    line.line_no = line_no;
    let is i32 as a = cast(i32, src[pos + 2]) - 32;
    let is i32 as b = cast(i32, src[pos + 3]) - 32;
    if (shape == 65) {
        pl.set_op_reg(line, 1, a);
        pl.set_op_reg(line, 2, b);
    } else if (shape == 66) {
        pl.set_op_reg(line, 1, a);
        pl.set_op_mem(line, 2, b, _hdisp(src, pos + 4), 64);
    } else {
        pl.set_op_mem(line, 1, b, _hdisp(src, pos + 4), 64);
        pl.set_op_reg(line, 2, a);
    }
    *tstart = t;
    let is i64 as e with mut = t;
    while (e < src_len && src[e] != 10) { e = e + 1; }
    return e;
}
