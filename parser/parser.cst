use "../../std/io.cst" as io;
use "../../std/env.cst" as env;
use "../../src/ir/opt_mem.cst" as om;
use "../lexer/lexer.cst" as lex;
use "../core/asm_defs.cst" as def;
use "../encoder/encoder_util.cst" as enc;
use "parsed_line.cst" as pl;
use "custom_sections.cst" as cs;
use "cstimport.cst" as ci;
use "fastline.cst" as fl;
use "../core/util.cst" as util;

// Count of statement-initial bare words that are neither a label nor a known
// instruction (i.e. unknown mnemonics). main/assemble_buf reads this after
// parsing and refuses to emit an object — previously such lines were silently
// dropped, producing a .o missing whatever the typo'd instruction stood for.
let is i32 as parse_errors with mut = 0;

fn parse_reset() as void { parse_errors = 0; }
fn parse_had_error() as i32 { return parse_errors; }

// === Operand parsing ===

// Parse a memory operand: [base +/- disp], [base + index*scale +/- disp] or
// [disp] (an absolute address, no base), with optional size prefix.
fn parse_mem_operand(tl as *lex.TokenList, pos as i32, out_pos as *i32, line as *pl.ParsedLine, which as i32, mem_size as i32) as void {
    let is i32 as p with mut = pos + 1; // skip '['
    let is *lex.Token as base_tok = lex.tl_get(tl, p);
    // An address with no register in it: [0x58], [-8]. What it is relative to
    // is the segment's base — this is how fs:[0] names a thread's own block.
    if (base_tok.kind == lex.TK_NUMBER || base_tok.kind == lex.TK_MINUS) {
        let is i64 as adisp with mut = base_tok.num_val;
        if (base_tok.kind == lex.TK_MINUS) {
            p = p + 1;
            adisp = 0 - lex.tl_get(tl, p).num_val;
        }
        p = p + 1;
        let is *lex.Token as arb = lex.tl_get(tl, p);
        if (arb.kind == lex.TK_RBRACKET) { p = p + 1; }
        *out_pos = p;
        pl.set_op_mem(line, which, def.REG_NONE, adisp, mem_size);
        return;
    }
    let is i32 as base_reg = base_tok.id;
    p = p + 1;
    if (base_reg == def.REG_RIP) {
        let is *lex.Token as op_tok = lex.tl_get(tl, p);
        if (op_tok.kind == lex.TK_PLUS) {
            p = p + 1;
            let is *lex.Token as lab_tok = lex.tl_get(tl, p);
            p = p + 1;
            let is *lex.Token as rb = lex.tl_get(tl, p);
            if (rb.kind == lex.TK_RBRACKET) { p = p + 1; }
            *out_pos = p;
            pl.set_op_rip(line, which, lab_tok.ptr, lab_tok.len, mem_size);
            return;
        }
    }
    let is i64 as disp with mut = 0;
    let is i32 as index_reg with mut = def.REG_NONE;
    let is i32 as scale with mut = 0;
    let is *lex.Token as next2 = lex.tl_get(tl, p);
    if (next2.kind == lex.TK_PLUS) {
        let is *lex.Token as peek = lex.tl_get(tl, p + 1);
        if (peek.kind == lex.TK_REGISTER) {
            p = p + 1;
            index_reg = peek.id;
            p = p + 1;
            let is *lex.Token as star = lex.tl_get(tl, p);
            if (star.kind == lex.TK_STAR) {
                p = p + 1;
                let is *lex.Token as sc = lex.tl_get(tl, p);
                scale = cast(i32, sc.num_val);
                p = p + 1;
            } else {
                scale = 1;
            }
            let is *lex.Token as after = lex.tl_get(tl, p);
            if (after.kind == lex.TK_PLUS) {
                p = p + 1;
                let is *lex.Token as d = lex.tl_get(tl, p);
                disp = d.num_val;
                p = p + 1;
            } else if (after.kind == lex.TK_MINUS) {
                p = p + 1;
                let is *lex.Token as d = lex.tl_get(tl, p);
                disp = 0 - d.num_val;
                p = p + 1;
            }
        } else {
            p = p + 1;
            let is *lex.Token as d = lex.tl_get(tl, p);
            disp = d.num_val;
            p = p + 1;
        }
    } else if (next2.kind == lex.TK_MINUS) {
        p = p + 1;
        let is *lex.Token as d = lex.tl_get(tl, p);
        disp = 0 - d.num_val;
        p = p + 1;
    }
    let is *lex.Token as rb2 = lex.tl_get(tl, p);
    if (rb2.kind == lex.TK_RBRACKET) { p = p + 1; }
    *out_pos = p;
    if (index_reg != def.REG_NONE) {
        pl.set_op_mem_sib(line, which, base_reg, index_reg, scale, disp, mem_size);
    } else {
        pl.set_op_mem(line, which, base_reg, disp, mem_size);
    }
}

// The segment prefix byte when the tokens at `at` are `fs : [` or `gs : [`,
// else 0.
fn _segment(tl as *lex.TokenList, at as i32) as i32 {
    if (at + 2 >= tl.count) { return 0; }
    let is *lex.Token as nm = lex.tl_get(tl, at);
    if (nm.kind != lex.TK_IDENT || nm.len != 2 || nm.ptr[1] != 115) { return 0; }   // ?s
    if (lex.tl_get(tl, at + 1).kind != lex.TK_COLON) { return 0; }
    if (lex.tl_get(tl, at + 2).kind != lex.TK_LBRACKET) { return 0; }
    if (nm.ptr[0] == 102) { return def.SEG_FS; }                                    // fs
    if (nm.ptr[0] == 103) { return def.SEG_GS; }                                    // gs
    return 0;
}

// Parse an operand starting at token index pos, stores into line's op1 or op2
fn parse_operand(tl as *lex.TokenList, pos as i32, out_pos as *i32, line as *pl.ParsedLine, which as i32) as void {
    let is *lex.Token as tok = lex.tl_get(tl, pos);

    if (tok.kind == lex.TK_REGISTER) {
        *out_pos = pos + 1;
        pl.set_op_reg(line, which, tok.id);
        return;
    }
    if (tok.kind == lex.TK_NUMBER) {
        *out_pos = pos + 1;
        pl.set_op_imm(line, which, tok.num_val);
        return;
    }
    if (tok.kind == lex.TK_MINUS) {
        let is *lex.Token as next = lex.tl_get(tl, pos + 1);
        if (next.kind == lex.TK_NUMBER) {
            *out_pos = pos + 2;
            pl.set_op_imm(line, which, 0 - next.num_val);
            return;
        }
    }
    // A segment override: [SIZE PTR] fs:[...] or gs:[...].
    let is i32 as sz_at with mut = 0;
    let is i32 as seg_at with mut = pos;
    if (tok.kind == lex.TK_SIZE_PREFIX) { sz_at = tok.id; seg_at = pos + 1; }
    let is i32 as seg = _segment(tl, seg_at);
    if (seg != 0) {
        let is i32 as lb_at = seg_at + 2;
        let is *lex.Token as ml = lex.tl_get(tl, lb_at + 1);
        if (ml.kind == lex.TK_REGISTER && ml.id == def.REG_RIP) {
            // fs:[rip+x] reads x's offset from the segment base, which is
            // never what was meant; nothing emits it, so nothing accepts it.
            parse_errors = parse_errors + 1;
            util.eprint_str("caustic-as: error: line ");
            util.eprint_int(cast(i64, line.line_no));
            util.eprint_str(": a segment override cannot be rip-relative\n");
        }
        parse_mem_operand(tl, lb_at, out_pos, line, which, sz_at);
        pl.set_op_seg(line, which, seg);
        return;
    }
    if (tok.kind == lex.TK_SIZE_PREFIX) {
        let is *lex.Token as lb = lex.tl_get(tl, pos + 1);
        if (lb.kind == lex.TK_LBRACKET) {
            parse_mem_operand(tl, pos + 1, out_pos, line, which, tok.id);
            return;
        }
    }
    if (tok.kind == lex.TK_LBRACKET) {
        parse_mem_operand(tl, pos, out_pos, line, which, 0);
        return;
    }
    if (tok.kind == lex.TK_IDENT || tok.kind == lex.TK_INSTRUCTION) {
        *out_pos = pos + 1;
        pl.set_op_label(line, which, tok.ptr, tok.len);
        return;
    }
    *out_pos = pos;
}

// === Parsing: skip to end of line ===

fn skip_to_eol(tl as *lex.TokenList, pos as i32) as i32 {
    let is i32 as p with mut = pos;
    while (p < tl.count) {
        let is *lex.Token as t = lex.tl_get(tl, p);
        if (t.kind == lex.TK_NEWLINE || t.kind == lex.TK_EOF) { break; }
        p = p + 1;
    }
    return p;
}

// === Parsing: parse a numeric value (possibly negative) ===

fn parse_dir_num(tl as *lex.TokenList, pos as i32, out_pos as *i32) as i64 {
    let is *lex.Token as val_tok = lex.tl_get(tl, pos);
    if (val_tok.kind == lex.TK_NUMBER) {
        *out_pos = pos + 1;
        return val_tok.num_val;
    } else if (val_tok.kind == lex.TK_MINUS) {
        let is *lex.Token as n = lex.tl_get(tl, pos + 1);
        *out_pos = pos + 2;
        return 0 - n.num_val;
    }
    *out_pos = pos;
    return 0;
}

// === Parsing: directive handler ===

fn parse_directive(tl as *lex.TokenList, pos as i32, line as *pl.ParsedLine, current_section as *i32) as i32 {
    let is *lex.Token as tok = lex.tl_get(tl, pos);
    let is i32 as p with mut = pos;

    if (enc.streq_lit(tok.ptr, tok.len, ".intel_syntax") == 1) {
        line.dir_kind = pl.DIR_INTEL;
        p = skip_to_eol(tl, p + 1);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cstimport") == 1) {
        // .cstimport "kernel32.dll" ExitProcess
        line.dir_kind = pl.DIR_CSTIMPORT;
        p = p + 1;
        let is *lex.Token as dll_tok = lex.tl_get(tl, p);
        let is *u8 as dll_ptr with mut = dll_tok.ptr;
        let is i32 as dll_len with mut = dll_tok.len;
        // Strip surrounding quotes
        if (dll_len >= 2 && dll_ptr[0] == 34 && dll_ptr[dll_len - 1] == 34) {
            dll_ptr = cast(*u8, cast(i64, dll_ptr) + 1);
            dll_len = dll_len - 2;
        }
        p = p + 1;
        let is *lex.Token as sym_tok = lex.tl_get(tl, p);
        ci.cstimport_add(dll_ptr, dll_len, sym_tok.ptr, sym_tok.len);
        p = skip_to_eol(tl, p + 1);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".text") == 1) {
        line.dir_kind = pl.DIR_TEXT;
        *current_section = cs.SECTION_TEXT;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".data") == 1) {
        line.dir_kind = pl.DIR_DATA;
        *current_section = cs.SECTION_DATA;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".bss") == 1) {
        line.dir_kind = pl.DIR_BSS;
        *current_section = cs.SECTION_BSS;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".rodata") == 1) {
        line.dir_kind = pl.DIR_RODATA;
        *current_section = cs.SECTION_RODATA;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".section") == 1) {
        line.dir_kind = pl.DIR_SECTION;
        p = p + 1;
        let is *lex.Token as sec_tok = lex.tl_get(tl, p);
        if (sec_tok.kind != lex.TK_NEWLINE && sec_tok.kind != lex.TK_EOF) {
            if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".rodata") == 1) { *current_section = cs.SECTION_RODATA; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".data") == 1) { *current_section = cs.SECTION_DATA; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".bss") == 1) { *current_section = cs.SECTION_BSS; }
            else if (enc.streq_lit(sec_tok.ptr, sec_tok.len, ".text") == 1) { *current_section = cs.SECTION_TEXT; }
            else {
                // Custom section. Strip surrounding quotes if present.
                let is *u8 as sname with mut = sec_tok.ptr;
                let is i32 as sname_len with mut = sec_tok.len;
                if (sname_len > 2 && sname[0] == 34 && sname[sname_len - 1] == 34) {
                    sname = cast(*u8, cast(i64, sname) + 1);
                    sname_len = sname_len - 2;
                }
                let is i32 as cidx = cs.csec_find_or_add(sname, sname_len);
                *current_section = cs.SECTION_CUSTOM_BASE + cidx;
                // `.section .name, "ax", @progbits` — the flag string decides
                // whether this section holds code. These flags used to be
                // skipped wholesale, so a section carrying a function was
                // indistinguishable from one carrying data and ended up mapped
                // non-executable. Walk the rest of the line for the quoted flag
                // token (skipping commas and @progbits) and look for 'x'.
                let is i32 as fp with mut = p + 1;
                while (1 == 1) {
                    let is *lex.Token as ft = lex.tl_get(tl, fp);
                    if (ft.kind == lex.TK_NEWLINE || ft.kind == lex.TK_EOF) { break; }
                    if (ft.len >= 2 && ft.ptr[0] == 34) {          // a "..." token
                        let is i32 as fi with mut = 1;
                        while (fi < ft.len - 1) {
                            if (ft.ptr[fi] == 120) { cs.csec_mark_exec(cidx); }  // 'x'
                            fi = fi + 1;
                        }
                        break;
                    }
                    fp = fp + 1;
                }
            }
            p = p + 1;
        }
        line.section = cast(i8, *current_section);
        p = skip_to_eol(tl, p);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".globl") == 1 || enc.streq_lit(tok.ptr, tok.len, ".global") == 1) {
        line.dir_kind = pl.DIR_GLOBL;
        p = p + 1;
        let is *lex.Token as name_tok = lex.tl_get(tl, p);
        if (name_tok.kind != lex.TK_NEWLINE && name_tok.kind != lex.TK_EOF) {
            pl.axw(line).dir_arg_ptr = name_tok.ptr;
            pl.axw(line).dir_arg_len = name_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".ascii") == 1) {
        line.dir_kind = pl.DIR_ASCII;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as asc_tok = lex.tl_get(tl, p);
        if (asc_tok.kind == lex.TK_STRING) {
            pl.axw(line).dir_arg_ptr = asc_tok.ptr;
            pl.axw(line).dir_arg_len = asc_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".string") == 1 || enc.streq_lit(tok.ptr, tok.len, ".asciz") == 1) {
        line.dir_kind = pl.DIR_STRING;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as str_tok = lex.tl_get(tl, p);
        if (str_tok.kind == lex.TK_STRING) {
            pl.axw(line).dir_arg_ptr = str_tok.ptr;
            pl.axw(line).dir_arg_len = str_tok.len;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".incbin") == 1) {
        line.dir_kind = pl.DIR_INCBIN;
        line.section = cast(i8, *current_section);
        p = p + 1;
        // `.incbin "path"` splices the raw bytes of an external file into the
        // current section. NUL-terminate the path for the file API, slurp the
        // file, and stash the bytes in decoded_ptr/decoded_len — the file may
        // contain NULs, so the length is explicit, not strlen-derived.
        let is *lex.Token as inc_tok = lex.tl_get(tl, p);
        pl.axw(line).decoded_ptr = cast(*u8, 0);
        pl.axw(line).decoded_len = 0;
        if (inc_tok.kind == lex.TK_STRING) {
            // The lexer keeps the surrounding double-quotes in the token; strip
            // them so the path is the bare filename.
            let is *u8 as praw with mut = inc_tok.ptr;
            let is i32 as plen with mut = inc_tok.len;
            if (plen >= 2 && praw[0] == cast(u8, 34)) {
                praw = cast(*u8, cast(i64, praw) + 1);
                plen = plen - 2;
            }
            let is *u8 as ipath = om.opt_alloc(cast(i64, plen) + 1);
            let is i32 as ic with mut = 0;
            while (ic < plen) { ipath[ic] = praw[ic]; ic = ic + 1; }
            ipath[plen] = cast(u8, 0);
            let is i64 as isz = util.read_file_size(ipath);
            let is *u8 as idata = util.read_file(ipath);
            if (cast(i64, idata) != 0 && isz > 0) {
                pl.axw(line).decoded_ptr = idata;
                pl.axw(line).decoded_len = cast(i32, isz);
            } else {
                io._write_fd(io.STDERR, ".incbin: cannot read file: ", 27);
                io._write_fd(io.STDERR, ipath, cast(i64, plen));
                io._write_fd(io.STDERR, "\n", 1);
            }
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".byte") == 1) {
        line.dir_kind = pl.DIR_BYTE;
        line.section = cast(i8, *current_section);
        p = p + 1;
        // `.byte` takes a comma-separated list of values (e.g. `.byte 0x8F, 0x07`);
        // each is one emitted byte. Store them all in decoded_ptr/decoded_len —
        // emitting only the first dropped raw-opcode bytes and corrupted hand-
        // written asm thunks (the smp/syscall stubs), misaligning the stream.
        let is *u8 as bb = om.opt_alloc(256);
        let is i32 as bn with mut = 0;
        let is i32 as cur with mut = p;
        let is i32 as np with mut = p;
        while (bn < 256) {
            let is i64 as v = parse_dir_num(tl, cur, &np);
            if (np == cur) { break; }
            bb[bn] = cast(u8, v & 255); bn = bn + 1; cur = np;
            let is *lex.Token as ct = lex.tl_get(tl, cur);
            if (ct.kind == lex.TK_COMMA) { cur = cur + 1; } else { break; }
        }
        pl.axw(line).decoded_ptr = bb; pl.axw(line).decoded_len = bn; pl.axw(line).dir_num = 0;
        return cur;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".word") == 1 || enc.streq_lit(tok.ptr, tok.len, ".value") == 1
        || enc.streq_lit(tok.ptr, tok.len, ".short") == 1) {
        line.dir_kind = pl.DIR_WORD;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is i32 as np with mut = p;
        pl.axw(line).dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".long") == 1) {
        line.dir_kind = pl.DIR_LONG;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is i32 as np with mut = p;
        pl.axw(line).dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".ripdisp") == 1) {
        // `.ripdisp <symbol>`: the disp32 of a [rip+symbol] operand, for an
        // instruction written out with .byte. Nothing may follow it.
        line.dir_kind = pl.DIR_LONG;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as rt = lex.tl_get(tl, p);
        pl.axw(line).dir_arg_ptr = rt.ptr;
        pl.axw(line).dir_arg_len = rt.len;
        pl.axw(line).dir_num = 0;
        return p + 1;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".quad") == 1) {
        line.dir_kind = pl.DIR_QUAD;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as qt = lex.tl_get(tl, p);
        if (qt.kind == lex.TK_IDENT) {
            // `.quad <symbol>` — emits an R_X86_64_64 relocation at codegen.
            pl.axw(line).dir_arg_ptr = qt.ptr;
            pl.axw(line).dir_arg_len = qt.len;
            pl.axw(line).dir_num = 0;
            return p + 1;
        }
        let is i32 as np with mut = p;
        pl.axw(line).dir_num = parse_dir_num(tl, p, &np);
        return np;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".p2align") == 1) {
        line.dir_kind = pl.DIR_P2ALIGN;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as pw = lex.tl_get(tl, p);
        if (pw.kind == lex.TK_NUMBER) { pl.axw(line).dir_num = pw.num_val; p = p + 1; }
        line.op1_imm = 0;
        // `, fill` (empty only) then `, max`
        let is *lex.Token as c1 = lex.tl_get(tl, p);
        if (c1.kind == lex.TK_COMMA) {
            p = p + 1;
            let is *lex.Token as c2 = lex.tl_get(tl, p);
            if (c2.kind == lex.TK_COMMA) {
                p = p + 1;
                let is *lex.Token as mx = lex.tl_get(tl, p);
                if (mx.kind == lex.TK_NUMBER) { line.op1_imm = mx.num_val; p = p + 1; }
            }
        }
        return skip_to_eol(tl, p);
    }
    // `.loopalign`: before a loop head label. Laid out like `.p2align 4,,10`
    // until the loop's length is known, then padded so the loop spans as few
    // 64-byte lines (then 32-byte fetch windows) as it can (passes.cst).
    if (enc.streq_lit(tok.ptr, tok.len, ".loopalign") == 1) {
        line.dir_kind = pl.DIR_P2ALIGN;
        line.section = cast(i8, *current_section);
        pl.axw(line).dir_num = 4;
        line.op1_imm = 10;
        line.op2_imm = 1;
        line.op2_mem_disp = 0 - 1;
        return skip_to_eol(tl, p + 1);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".zero") == 1) {
        line.dir_kind = pl.DIR_ZERO;
        line.section = cast(i8, *current_section);
        p = p + 1;
        let is *lex.Token as val_tok = lex.tl_get(tl, p);
        if (val_tok.kind == lex.TK_NUMBER) {
            pl.axw(line).dir_num = val_tok.num_val;
            p = p + 1;
        }
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".file") == 1) {
        // `.file <num> "<path>"` — record the source path for .cstdebug.
        line.dir_kind = pl.DIR_FILE;
        p = p + 1;
        let is *lex.Token as num_tok = lex.tl_get(tl, p);
        if (num_tok.kind == lex.TK_NUMBER) { pl.axw(line).dir_num = num_tok.num_val; p = p + 1; }
        let is *lex.Token as path_tok = lex.tl_get(tl, p);
        if (path_tok.kind == lex.TK_STRING) {
            let is *u8 as praw with mut = path_tok.ptr;
            let is i32 as plen with mut = path_tok.len;
            if (plen >= 2 && praw[0] == cast(u8, 34) && praw[plen - 1] == cast(u8, 34)) {
                praw = cast(*u8, cast(i64, praw) + 1);
                plen = plen - 2;
            }
            pl.axw(line).dir_arg_ptr = praw;
            pl.axw(line).dir_arg_len = plen;
            p = p + 1;
        }
        p = skip_to_eol(tl, p);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".loc") == 1) {
        // `.loc <file> <line> <column>` — keep the line number.
        line.dir_kind = pl.DIR_LOC;
        p = p + 1;
        let is *lex.Token as f_tok = lex.tl_get(tl, p);
        if (f_tok.kind == lex.TK_NUMBER) { p = p + 1; }
        let is *lex.Token as l_tok = lex.tl_get(tl, p);
        if (l_tok.kind == lex.TK_NUMBER) { pl.axw(line).dir_num = l_tok.num_val; p = p + 1; }
        p = skip_to_eol(tl, p);
        return p;
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".dbg_prologue_end") == 1) {
        line.dir_kind = pl.DIR_DBG_PROLOGUE_END;
        return skip_to_eol(tl, p + 1);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cfi_startproc") == 1) {
        line.dir_kind = pl.DIR_CFI_STARTPROC;
        p = p + 1;
        // Optional function name (the assembler keys the record by symbol).
        let is *lex.Token as nm = lex.tl_get(tl, p);
        if (nm.kind == lex.TK_IDENT) {
            pl.axw(line).dir_arg_ptr = nm.ptr;
            pl.axw(line).dir_arg_len = nm.len;
            p = p + 1;
        }
        return skip_to_eol(tl, p);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cfi_endproc") == 1) {
        line.dir_kind = pl.DIR_CFI_ENDPROC;
        return skip_to_eol(tl, p + 1);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cfi_def_cfa_offset") == 1) {
        line.dir_kind = pl.DIR_CFI_DEF_CFA_OFFSET;
        p = p + 1;
        let is *lex.Token as n = lex.tl_get(tl, p);
        if (n.kind == lex.TK_NUMBER) { pl.axw(line).dir_num = n.num_val; p = p + 1; }
        return skip_to_eol(tl, p);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cfi_def_cfa_register") == 1) {
        line.dir_kind = pl.DIR_CFI_DEF_CFA_REGISTER;
        p = p + 1;
        let is *lex.Token as r = lex.tl_get(tl, p);
        if (r.kind == lex.TK_REGISTER) { pl.axw(line).dir_arg_len = r.id; p = p + 1; }
        return skip_to_eol(tl, p);
    }
    if (enc.streq_lit(tok.ptr, tok.len, ".cfi_offset") == 1) {
        line.dir_kind = pl.DIR_CFI_OFFSET;
        p = p + 1;
        let is *lex.Token as r = lex.tl_get(tl, p);
        if (r.kind == lex.TK_REGISTER) { pl.axw(line).dir_arg_len = r.id; p = p + 1; }
        let is *lex.Token as cm = lex.tl_get(tl, p);
        if (cm.kind == lex.TK_COMMA) { p = p + 1; }
        let is i32 as np with mut = p;
        pl.axw(line).dir_num = parse_dir_num(tl, p, &np);
        return skip_to_eol(tl, np);
    }
    line.dir_kind = pl.DIR_OTHER;
    return p + 1;
}

// === Parsing: instruction handler ===

fn parse_instruction(tl as *lex.TokenList, pos as i32, line as *pl.ParsedLine) as i32 {
    let is i32 as p with mut = pos;

    // Handle "rep movsb" / "lock cmpxchg ..." — prefix-only line, don't parse
    // operands; the following mnemonic is parsed as its own instruction line so
    // the prefix byte (F3 / F0) is emitted right before it.
    if (line.inst_id == def.INST_REP || line.inst_id == def.INST_LOCK) {
        return p;
    }

    // Parse operand 1
    let is *lex.Token as next = lex.tl_get(tl, p);
    if (next.kind != lex.TK_NEWLINE && next.kind != lex.TK_EOF) {
        let is i32 as new_pos with mut = p;
        parse_operand(tl, p, &new_pos, line, 1);
        p = new_pos;

        // Check for comma -> operand 2
        let is *lex.Token as comma = lex.tl_get(tl, p);
        if (comma.kind == lex.TK_COMMA) {
            p = p + 1;
            parse_operand(tl, p, &new_pos, line, 2);
            p = new_pos;
        }
    }
    // Skip to end of line
    p = skip_to_eol(tl, p);
    return p;
}

// === Parsing: main loop ===

// Parse one chunk's worth of tokens, APPENDING parsed lines to `lines` and
// threading the current section through `section_ptr` (in/out). Used by both
// parse_all (whole token list) and parse_streaming (one line-aligned chunk at
// a time). Each chunk's token list ends in a TK_EOF, which terminates the loop.
fn parse_chunk(tl as *lex.TokenList, lines as *pl.ParsedLines, section_ptr as *i32, line_ptr as *i32) as void {
    let is i32 as pos with mut = 0;
    let is i32 as current_section with mut = *section_ptr;
    // Running 1-based source line number. Persisted across streaming chunks via
    // line_ptr so diagnostics report the true file line, not a per-chunk offset.
    // Every source `\n` is exactly one TK_NEWLINE (the lexer never coalesces),
    // and parse_instruction/parse_directive stop at the newline, so the main
    // loop sees — and counts — each line break exactly once.
    let is i32 as cur_line with mut = *line_ptr;

    while (pos < tl.count) {
        let is *lex.Token as tok = lex.tl_get(tl, pos);

        // Skip newlines
        if (tok.kind == lex.TK_NEWLINE || tok.kind == lex.TK_EOF) {
            if (tok.kind == lex.TK_EOF) { break; }
            cur_line = cur_line + 1;
            pos = pos + 1;
        }
        // Directive
        else if (tok.kind == lex.TK_DIRECTIVE) {
            let is *pl.ParsedLine as line = pl.pl_add(lines);
            line.kind = pl.LINE_DIRECTIVE;
            line.section = cast(i8, current_section);
            line.line_no = cur_line;
            pos = parse_directive(tl, pos, line, &current_section);
            // Update section from directive (may have changed)
            line.section = cast(i8, current_section);
            pos = skip_to_eol(tl, pos);
        }
        // Instruction (but check for label first: "add:" etc.)
        else if (tok.kind == lex.TK_INSTRUCTION) {
            let is *lex.Token as peek = lex.tl_get(tl, pos + 1);
            if (peek.kind == lex.TK_COLON) {
                let is *pl.ParsedLine as lbl = pl.pl_add(lines);
                lbl.kind = pl.LINE_LABEL;
                lbl.section = cast(i8, current_section);
                pl.axw(lbl).label_ptr = tok.ptr;
                pl.axw(lbl).label_len = cast(i16, tok.len);
                lbl.line_no = cur_line;
                pos = pos + 2;
            } else {
                let is *pl.ParsedLine as line = pl.pl_add(lines);
                line.kind = pl.LINE_INST;
                line.section = cast(i8, current_section);
                line.inst_id = cast(i16, tok.id);
                line.line_no = cur_line;
                pos = parse_instruction(tl, pos + 1, line);
            }
        }
        // Label (IDENT followed by COLON)
        else if (tok.kind == lex.TK_IDENT) {
            let is *lex.Token as next = lex.tl_get(tl, pos + 1);
            if (next.kind == lex.TK_COLON) {
                let is *pl.ParsedLine as line = pl.pl_add(lines);
                line.kind = pl.LINE_LABEL;
                line.section = cast(i8, current_section);
                pl.axw(line).label_ptr = tok.ptr;
                pl.axw(line).label_len = cast(i16, tok.len);
                line.line_no = cur_line;
                pos = pos + 2;
            } else {
                // A bare word at statement start that is not a label (no ':')
                // and was not recognized as an instruction/register. A leading
                // '.' means an unrecognized directive or local label — skip
                // those silently as before; anything else is an unknown
                // mnemonic, which must not pass silently.
                if (tok.ptr[0] != 46) {
                    parse_errors = parse_errors + 1;
                    util.eprint_str("caustic-as: error: line ");
                    util.eprint_int(cast(i64, cur_line));
                    util.eprint_str(": unknown instruction '");
                    io._write_fd(io.STDERR, tok.ptr, cast(i64, tok.len));
                    util.eprint_str("'\n");
                }
                pos = skip_to_eol(tl, pos + 1);
            }
        }
        else {
            pos = pos + 1;
        }
    }

    *section_ptr = current_section;
    *line_ptr = cur_line;
}

fn parse_all(tl as *lex.TokenList, line_hint as i32) as pl.ParsedLines {
    let is pl.ParsedLines as lines = pl.pl_init(line_hint);
    let is i32 as section with mut = cs.SECTION_TEXT;
    let is i32 as cur_line with mut = 1;
    parse_chunk(tl, &lines, &section, &cur_line);
    return lines;
}

// Streaming parse: tokenize the source one line-aligned chunk at a time into a
// small reusable token buffer (freed after each chunk), instead of holding the
// whole file's tokens at once. Bounds peak token memory to ~one chunk rather
// than the entire token array (a large RSS cut for big .s files). ParsedLine
// pointers reference the source text (which the caller keeps alive), not the
// token buffers, so freeing each chunk's tokens is safe.
// Capacity for the line array: the newline count plus a quarter (a line can
// hold a label and an instruction), so the array is not doubled — doubling
// copied the whole array with the old one still mapped (the self-host .s: the
// file_size/24 guess was 604K lines for 804K, a 163 MB array plus the 81 MB
// copy). Pages past the last line are never touched, so the slack costs
// address space, not memory.
fn line_capacity(src as *u8, src_len as i64, floor as i32) as i32 {
    // Newlines counted eight bytes at a time: a byte of x = w ^ 0x0A.. is zero
    // exactly where w holds a newline, and (((x & 0x7F..) + 0x7F..) | x) has
    // its high bit clear exactly at the zero bytes (exact, no carry between
    // bytes), so the count is the popcount of the inverted high bits.
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as nl8 = 723401728380766730;          // 0x0A0A0A0A0A0A0A0A
    let is i64 as lo7 = 9187201950435737471;         // 0x7F7F7F7F7F7F7F7F
    while (i + 8 <= src_len) {
        let is i64 as x = *cast(*i64, cast(i64, src) + i) ^ nl8;
        let is i64 as y = (((x & lo7) + lo7) | x) | lo7;
        let is i64 as z with mut = ~y;              // high bit set at each newline byte
        while (z != 0) { n = n + 1; z = z & (z - 1); }
        i = i + 8;
    }
    while (i < src_len) { if (src[i] == 10) { n = n + 1; } i = i + 1; }
    let is i64 as cap = n + n / 4 + 1024;
    if (cap < cast(i64, floor)) { return floor; }
    if (cap > 1073741823) { return 1073741823; }
    return cast(i32, cap);
}

// Source spans, for a caller that works on the records with the text beside
// them (the compiler's peephole, through main.line_hook). With span_on set,
// every record gets the offset and length of the source line it came from and
// a flag byte (SPAN_HAND: inside an #APP .. #NO_APP block, markers included),
// and a line that yields no record (blank, a comment, an #APP marker) yields a
// LINE_EMPTY placeholder with SPAN_PLACE, so record order follows line order.
// Off by default: the standalone assembler never pays for it.
let is i32 as span_on with mut = 0;
let is *i32 as span_off with mut;
let is *i32 as span_len with mut;
let is *u8 as span_flag with mut;
let is i32 as span_cap with mut = 0;
let is i32 as SPAN_HAND with imut = 1;
let is i32 as SPAN_PLACE with imut = 2;
// The record came from a hint (fastline.hint_line); with an empty span the
// compiler wrote no text for it.
let is i32 as SPAN_HINT with imut = 4;

fn _span_put(idx as i32, off as i64, len as i64, flag as i32) as void {
    if (idx >= span_cap) {
        let is i32 as nc with mut = span_cap * 2;
        if (nc < 65536) { nc = 65536; }
        while (nc <= idx) { nc = nc * 2; }
        let is *i32 as no = cast(*i32, om.opt_alloc(cast(i64, nc) * 4));
        let is *i32 as nl = cast(*i32, om.opt_alloc(cast(i64, nc) * 4));
        let is *u8 as nf = om.opt_alloc(cast(i64, nc));
        let is i32 as k with mut = 0;
        while (k < span_cap) { no[k] = span_off[k]; nl[k] = span_len[k]; nf[k] = span_flag[k]; k = k + 1; }
        if (span_cap > 0) { om.opt_free(cast(*u8, span_off)); om.opt_free(cast(*u8, span_len)); om.opt_free(span_flag); }
        span_off = no; span_len = nl; span_flag = nf; span_cap = nc;
    }
    span_off[idx] = cast(i32, off);
    span_len[idx] = cast(i32, len);
    span_flag[idx] = cast(u8, flag);
}

fn span_free() as void {
    if (span_cap > 0) { om.opt_free(cast(*u8, span_off)); om.opt_free(cast(*u8, span_len)); om.opt_free(span_flag); }
    span_cap = 0;
}

// The line src[s..s+len) is exactly `word` after leading blanks.
fn _line_is(src as *u8, s as i64, len as i64, word as *u8) as i32 {
    let is i64 as k with mut = s;
    while (k < s + len && (src[k] == 32 || src[k] == 9)) { k = k + 1; }
    let is i64 as w with mut = 0;
    while (word[w] != 0) {
        if (k + w >= s + len || src[k + w] != word[w]) { return 0; }
        w = w + 1;
    }
    return cast(i32, k + w == s + len);
}

// CAUSTIC_AS_SLOW=1 sends every line through the tokenizer: the reference the
// fast path is checked against (tests/run_fastparse.sh). -1 = not read yet.
// The compiler's --no-sse: an xmm or ymm register outside #APP/#NO_APP (an asm
// block) is an error, whatever wrote it.
let is i32 as no_simd with mut = 0;

fn _simd_reg(r as i16) as i32 { return cast(i32, r >= def.REG_XMM0 && r < def.REG_XMM0 + 16); }

fn _no_simd_check(lines as *pl.ParsedLines, from as i32) as void {
    let is i32 as r with mut = from;
    while (r < lines.count) {
        let is *pl.ParsedLine as l = pl.pl_get(lines, r);
        if (l.kind == pl.LINE_INST
            && ((l.op1_kind == def.OP_REG && _simd_reg(l.op1_reg_id) == 1)
                || (l.op2_kind == def.OP_REG && _simd_reg(l.op2_reg_id) == 1))) {
            io.write_str(io.STDERR, "internal error: --no-sse: the compiler wrote an xmm register (assembly line ");
            io.write_int(io.STDERR, cast(i64, l.line_no));
            io.write_str(io.STDERR, ")\n");
            io.exit(1);
        }
        r = r + 1;
    }
}

let is i32 as _slow with mut = cast(i32, 0 - 1);

// CAUSTIC_HINT_CHECK=1: every hinted record is compared with the parse of the
// text that follows it, byte for byte; each difference is reported.
let is i32 as _hchk with mut = 0 - 1;
let is i64 as hint_checked with mut = 0;
let is i64 as hint_bad with mut = 0;

fn _hint_check() as i32 {
    if (_hchk < 0) {
        _hchk = 0;
        let is *u8 as hv = env.getenv("CAUSTIC_HINT_CHECK");
        if (cast(i64, hv) != 0 && hv[0] == 49) { _hchk = 1; }
    }
    return _hchk;
}

fn _same_bytes(a as *u8, b as *u8, n as i32) as i32 {
    let is i32 as k with mut = 0;
    while (k < n) { if (a[k] != b[k]) { return 0; } k = k + 1; }
    return 1;
}

fn _hint_compare(src as *u8, ts as i64, src_len as i64, lines as *pl.ParsedLines, section as i32, ln as i32, hb as i32) as void {
    hint_checked = hint_checked + 1;
    let is i64 as e = fl.fast_line(src, ts, src_len, lines, section, ln);
    let is i32 as same with mut = 0;
    if (e >= 0 && lines.count == hb + 2) {
        let is *u8 as x = cast(*u8, pl.pl_get(lines, hb));
        let is *u8 as y = cast(*u8, pl.pl_get(lines, hb + 1));
        same = 1;
        // A hinted label points at the hint's own copy of the name: the
        // contents must agree, not the addresses.
        let is *pl.ParsedLine as hx = pl.pl_get(lines, hb);
        let is *pl.ParsedLine as hy = pl.pl_get(lines, hb + 1);
        if (cast(i32, hx.op1_kind) == def.OP_LABEL && cast(i32, hy.op1_kind) == def.OP_LABEL
            && hx.op1_label_len == hy.op1_label_len) {
            let is i32 as q1 with mut = 0;
            while (q1 < cast(i32, hx.op1_label_len)) {
                if (hx.op1_label_ptr[q1] != hy.op1_label_ptr[q1]) { same = 0; }
                q1 = q1 + 1;
            }
            hy.op1_label_ptr = hx.op1_label_ptr;
        }
        if (cast(i32, hx.op1_kind) == def.OP_RIP_LABEL && hy.op1_kind == hx.op1_kind && hx.op1_label_len == hy.op1_label_len
            && _same_bytes(hx.op1_label_ptr, hy.op1_label_ptr, cast(i32, hx.op1_label_len)) == 1) { hy.op1_label_ptr = hx.op1_label_ptr; }
        if (cast(i32, hx.op2_kind) == def.OP_RIP_LABEL && hy.op2_kind == hx.op2_kind && hx.op2_label_len == hy.op2_label_len
            && _same_bytes(hx.op2_label_ptr, hy.op2_label_ptr, cast(i32, hx.op2_label_len)) == 1) { hy.op2_label_ptr = hx.op2_label_ptr; }
        let is i64 as k with mut = 0;
        while (k < sizeof(pl.ParsedLine)) { if (x[k] != y[k]) { same = 0; } k = k + 1; }
    }
    if (same == 0) {
        hint_bad = hint_bad + 1;
        let is i64 as q with mut = ts;
        while (q < src_len && src[q] != 10) { q = q + 1; }
        io.write_str(io.STDERR, "hint differs from its text: ");
        io.write_bytes(io.STDERR, cast(*u8, cast(i64, src) + ts), q - ts);
        io.write_str(io.STDERR, "\n");
    }
    lines.count = hb + 1;
}

fn parse_streaming(src as *u8, src_len as i64, line_hint as i32) as pl.ParsedLines {
    if (_slow < 0) {
        _slow = 0;
        let is *u8 as sv = env.getenv("CAUSTIC_AS_SLOW");
        if (cast(i64, sv) != 0 && sv[0] == 49) { _slow = 1; }
    }
    let is pl.ParsedLines as lines = pl.pl_init(line_capacity(src, src_len, line_hint));
    let is i32 as section with mut = cs.SECTION_TEXT;
    let is i32 as cur_line with mut = 1;     // running source line
    lex.lex_init();
    fl.lookup_begin(cast(i64, src) + src_len);
    // One token array for every line the fast path declines, reused.
    let is lex.TokenList as tl = lex.tl_init(0);
    let is i64 as pos with mut = 0;
    let is i32 as in_hand with mut = 0;
    let is i32 as hand_simd with mut = 0;
    while (pos < src_len) {
        let is i32 as before = lines.count;
        let is i32 as line_no = cur_line;
        let is i64 as lstart with mut = pos;
        let is i64 as lend with mut = 0;           // end of the line's text, newline excluded
        let is i64 as eol with mut = 0 - 1;
        let is i32 as hinted with mut = 0;
        if (src[pos] == 1) {
            // a record hint (fastline.cst): the record without parsing its text
            let is i64 as ts with mut = pos;
            let is i32 as hb = lines.count;
            let is i64 as he = fl.hint_line(src, pos, src_len, &lines, section, cur_line, &ts);
            if (he >= 0) {
                if (_hint_check() == 1) { _hint_compare(src, ts, src_len, &lines, section, cur_line, hb); }
                eol = he;
                lstart = ts;
                hinted = SPAN_HINT;
            } else {
                // Only the compiler writes hints, and only shapes this assembler
                // decodes; a hint carries no length, so its text cannot be found.
                io.write_str(io.STDERR, "internal error: unknown record hint in the assembly\n");
                io.exit(1);
            }
        }
        if (eol < 0 && _slow == 0) { eol = fl.fast_line(src, pos, src_len, &lines, section, cur_line); }
        if (eol < 0 && _slow == 0) { eol = fl.fast_dir(src, pos, src_len, &lines, &section, cur_line); }
        if (eol >= 0) {
            if (eol < src_len) { cur_line = cur_line + 1; }
            lend = eol;
            pos = eol + 1;
        } else {
            // The tokenizer's own line: up to the first newline outside a
            // string, which parse_chunk counts.
            let is i64 as tend with mut = fl.tokenizer_line_end(src, pos, src_len);
            lend = tend;
            if (tend < src_len) { tend = tend + 1; }
            lex.tokenize_into(&tl, cast(*u8, cast(i64, src) + pos), tend - pos);
            parse_chunk(&tl, &lines, &section, &cur_line);
            pos = tend;
        }
        if (no_simd == 1) {
            let is i64 as nl with mut = lend - lstart;
            if (_line_is(src, lstart, nl, "#APP") == 1) { hand_simd = 1; }
            else if (_line_is(src, lstart, nl, "#NO_APP") == 1) { hand_simd = 0; }
            else if (hand_simd == 0) { _no_simd_check(&lines, before); }
        }
        if (span_on == 1) {
            let is i64 as tl_len with mut = lend - lstart;
            if (tl_len > 0 && src[lstart + tl_len - 1] == 13) { tl_len = tl_len - 1; }
            if (in_hand == 0 && _line_is(src, lstart, tl_len, "#APP") == 1) { in_hand = 1; }
            let is i32 as fl_hand with mut = 0;
            if (in_hand == 1) { fl_hand = SPAN_HAND; }
            if (in_hand == 1 && _line_is(src, lstart, tl_len, "#NO_APP") == 1) { in_hand = 0; }
            if (lines.count == before) {
                let is *pl.ParsedLine as ph = pl.pl_add(&lines);
                ph.kind = pl.LINE_EMPTY;
                ph.section = cast(i8, section);
                ph.line_no = line_no;
                _span_put(before, lstart, tl_len, fl_hand | SPAN_PLACE);
            } else {
                let is i32 as r with mut = before;
                while (r < lines.count) { _span_put(r, lstart, tl_len, fl_hand | hinted); r = r + 1; }
            }
        }
    }
    lex.tl_free(&tl);
    if (_hint_check() == 1 && hint_checked > 0) {
        io.printf("hint check: %d hinted lines, %d differ\n", hint_checked, hint_bad);
    }
    return lines;
}

// Replace record r with the parse of the one-line text p[0..n) (no newline):
// the line a caller rewrote. Section and line number stay r's. 1 = done,
// 0 = the text did not yield exactly one record (r untouched).
fn reparse_into(lines as *pl.ParsedLines, r as i32, p as *u8, n as i64) as i32 {
    let is pl.ParsedLine as keep = *pl.pl_get(lines, r);
    let is i32 as before = lines.count;
    let is i32 as sec with mut = cast(i32, keep.section);
    let is i32 as ln with mut = keep.line_no;
    fl.lookup_begin(cast(i64, p) + n);
    let is i64 as e = fl.fast_line(p, 0, n, lines, sec, ln);
    if (e < 0) {
        let is lex.TokenList as tl = lex.tl_init(0);
        lex.tokenize_into(&tl, p, n);
        parse_chunk(&tl, lines, &sec, &ln);
        lex.tl_free(&tl);
    }
    if (lines.count != before + 1) { lines.count = before; return 0; }
    let is *pl.ParsedLine as dst = pl.pl_get(lines, r);
    *dst = *pl.pl_get(lines, before);
    dst.section = keep.section;
    dst.line_no = keep.line_no;
    lines.count = before;
    return 1;
}
